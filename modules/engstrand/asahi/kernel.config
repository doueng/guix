# Kernel config fragment for linux-asahi, merged onto arch/arm64/configs/defconfig
# at build time by customize-linux in modules/engstrand/asahi/kernel.scm.
#
# One option per line: CONFIG_FOO=y, CONFIG_FOO=m, CONFIG_FOO=value, or
# "# CONFIG_FOO is not set".  Any other line starting with # is a comment;
# never start a comment with a CONFIG_ name.  The build fails when make
# olddefconfig drops or changes a line here, so a stale option shows up at once.
#
# Started from the asahi-guix channel (b9132769, packages/linux.scm), line for
# line, plus CONFIG_INPUT_UINPUT for keyd.  GPL-3.0-or-later, like its source.

# ==== Apple Silicon hardware support (mirrors asahi.config in the kernel tree) ====
CONFIG_RUST=y
CONFIG_ARM64_ACTLR_STATE=y
CONFIG_ARCH_APPLE=y
# CONFIG_ARM64_4K_PAGES is not set
CONFIG_ARM64_16K_PAGES=y
# CONFIG_ARM64_64K_PAGES is not set
CONFIG_ARM64_MEMORY_MODEL_CONTROL=y
CONFIG_ARM_APPLE_CPUIDLE=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=m
CONFIG_BT_BRCMEXT=y
CONFIG_BT_HCIBCM4377=m
CONFIG_PCIE_APPLE=m
CONFIG_NVME_APPLE=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_TOUCHSCREEN_APPLE_Z2=m
CONFIG_INPUT_MACSMC_INPUT=m
CONFIG_I2C_APPLE=m
CONFIG_SPI_APPLE=m
CONFIG_SPMI_APPLE=m
CONFIG_PINCTRL_APPLE_GPIO=m
CONFIG_GPIO_MACSMC=m
CONFIG_POWER_RESET_MACSMC=m
CONFIG_MACSMC_POWER=m
CONFIG_SENSORS_MACSMC_HWMON=m
CONFIG_APPLE_WATCHDOG=y
CONFIG_VIDEO_APPLE_AVD=m
CONFIG_VIDEO_APPLE_ISP=m
CONFIG_DRM=y
CONFIG_DRM_ASAHI=m
CONFIG_DRM_ADP=m
CONFIG_DRM_APPLE=m
CONFIG_DRM_APPLE_AUDIO=y
CONFIG_SND_SOC_APPLE_AOP_AUDIO=m
CONFIG_SND_SOC_APPLE_MCA=m
CONFIG_SND_SOC_APPLE_MACAUDIO=m
CONFIG_SND_SOC_CS42L83=m
CONFIG_SND_SOC_CS42L84=m
CONFIG_SND_SOC_TAS2764=m
CONFIG_SND_SOC_TAS2770=m
CONFIG_HID_APPLE=m
CONFIG_HID_MAGICMOUSE=m
CONFIG_HID_DOCKCHANNEL=m
CONFIG_SPI_HID_APPLE_OF=m
CONFIG_SPI_HID_APPLE_CORE=m
CONFIG_USB_DWC3_APPLE=m
CONFIG_USB_XHCI_PCI_ASMEDIA=y
CONFIG_RTC_DRV_MACSMC=m
CONFIG_APPLE_ADMAC=m
CONFIG_APPLE_SIO=m
CONFIG_MFD_MACSMC=m
CONFIG_COMMON_CLK_APPLE_NCO=m
CONFIG_APPLE_DART=m
CONFIG_APPLE_DOCKCHANNEL=m
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_PMGR_MISC=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_RTKIT_HELPER=m
CONFIG_APPLE_SART=m
CONFIG_RUST_APPLE_RTKIT=y
CONFIG_APPLE_AOP=m
CONFIG_APPLE_SEP=m
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_APPLE_PMP=m
CONFIG_APPLE_PMP_REPORT=y
CONFIG_IIO_AOP_SENSOR_LAS=m
CONFIG_IIO_AOP_SENSOR_ALS=m
CONFIG_RUST_FW_LOADER_ABSTRACTIONS=y
CONFIG_PWM_APPLE=m
CONFIG_APPLE_AIC=y
CONFIG_PHY_APPLE_ATC=m
CONFIG_PHY_APPLE_DPTX=m
CONFIG_APPLE_M1_CPU_PMU=y
CONFIG_NVMEM_APPLE_EFUSES=m
CONFIG_NVMEM_APPLE_SPMI=m
CONFIG_MUX_APPLE_DPXBAR=m
CONFIG_TYPEC_SN201202X=m
CONFIG_RESET_APPLE_CIO=m
CONFIG_USB4=m
CONFIG_USB4_APPLE_SOC=m

# ==== Hardening (mirrors hardening.config in the kernel tree) ====
CONFIG_ARM64_SW_TTBR0_PAN=y
CONFIG_SHADOW_CALL_STACK=y
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_MTE=y
CONFIG_ARM64_E0PD=y
CONFIG_ARM64_EPAN=y

# ==== Guix options on top of arm64 defconfig ====
# Boot and scheduler
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_NO_HZ_FULL=y
# CONFIG_NO_HZ_IDLE is not set
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_EXPERT=y
CONFIG_SCHED_CLUSTER=y
# CONFIG_CRASH_DUMP is not set
# CONFIG_GCC_PLUGINS is not set
# Containers and namespaces (NAMESPACES defaults to n with EXPERT=y)
CONFIG_NAMESPACES=y
CONFIG_CHECKPOINT_RESTORE=y
# Modules
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
# Block devices — built-in for boot
CONFIG_BLK_DEV_NVME=y
CONFIG_BLK_DEV_DM=y
CONFIG_BLK_DEV_MD=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_MIRROR=y
CONFIG_DM_ZERO=y
CONFIG_DM_INIT=y
CONFIG_DM_CRYPT=m
# Needed by LVM thin pools (lvcreate --thin, docker devicemapper
# storage driver, CoW VM images).
CONFIG_DM_THIN_PROVISIONING=m
# Sound — built-in for Apple audio pipeline
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
# WiFi — unsigned regdb for iwd
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_CFG80211_WEXT=y
# Networking
CONFIG_WIREGUARD=m
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_TARGET_MARK=m
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=m
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IPV6_MULTIPLE_TABLES=y
# iptables comment match — Docker, kube-proxy, firewalld, and fail2ban
# tag their rules with -m comment to find and clean them up.
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
# SCTP — matches Fedora Asahi Remix (kernel-ark common config) and the
# Asahi Linux PKGBUILD; needed by e.g. Kubernetes SCTP services, telecom
# stacks, and WebRTC data channel testing.
CONFIG_IP_SCTP=m
CONFIG_INET_SCTP_DIAG=m
CONFIG_NETFILTER_XT_MATCH_SCTP=m
# Bluetooth — RFCOMM is required for the HFP/HSP headset profiles (mic);
# without it only A2DP playback works.
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=m
CONFIG_BT_LE=y
CONFIG_BT_MSFTEXT=y
# Security
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_DEFAULT_SECURITY_DAC=y
CONFIG_LSM="yama,loadpin,safesetid,integrity,selinux,smack,tomoyo,apparmor"
# CONFIG_INTEGRITY is not set
# Graphics
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_LOAD_EDID_FIRMWARE=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_ACCEL=y
CONFIG_FRAMEBUFFER_CONSOLE_LEGACY_ACCELERATION=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
# Filesystems — explicit because EXPERT=y can change kconfig defaults
CONFIG_TMPFS=y
CONFIG_BINFMT_MISC=y
# ext4 filesystem
CONFIG_EXT4_FS=y
# DOS/FAT/exFAT/NTFS filesystems — match Fedora Asahi Remix (all =m)
# FAT / VFAT also needed for the EFI System Partition.
CONFIG_FAT_FS=m
CONFIG_FAT_DEFAULT_IOCHARSET="ascii"
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_MSDOS_FS=m
CONFIG_VFAT_FS=m
# exFAT — SD-Cards or USB sticks
CONFIG_EXFAT_FS=m
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
# NTFS3 — read/write NTFS on SD-Cards or USB sticks
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
# Squashfs — Guix store images
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
# NLS — charset support for FAT and general use
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_ASCII=y
CONFIG_NLS_UTF8=y
# Device-mapper extras
CONFIG_DM_UEVENT=y
# Compressed swap
CONFIG_ZRAM=m
CONFIG_ZSWAP=y
# Crypto — XTS mode for LUKS dm-crypt
CONFIG_CRYPTO_XTS=y
# Crypto — btrfs requires CRC32C
CONFIG_CRYPTO_CRC32C=y
# Crypto — iwd required (fatal without these)
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
# Crypto — ARM64 accelerators built-in
CONFIG_CRYPTO_AES_ARM64_BS=y
CONFIG_CRYPTO_CHACHA20=y
CONFIG_CRYPTO_SHA3=y
CONFIG_CRYPTO_SM3=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_USER=m
# Asymmetric key / certificate support
CONFIG_KEYS=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
# Debug
CONFIG_DEBUG_PREEMPT=y
CONFIG_DEBUG_WX=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0
# CMA
CONFIG_CMA_SIZE_MBYTES=64
# MMAP randomization
CONFIG_ARCH_MMAP_RND_BITS=18
# CPU frequency governors — built-in
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
# Initrd modules — not in ARM64 defconfig or asahi.config
CONFIG_DRM_CIRRUS_QEMU=m
CONFIG_CRYPTO_SERPENT=m
CONFIG_CRYPTO_WP512=m
CONFIG_USB_UAS=m
CONFIG_USB_DWC3_OF_SIMPLE=m
# Leaf driver overrides (no cascading sub-options)
CONFIG_BLK_DEV_LOOP=m
CONFIG_9P_FS=m
CONFIG_NET_9P=m
CONFIG_NET_9P_VIRTIO=m
CONFIG_DP83867_PHY=m
CONFIG_HW_RANDOM_VIRTIO=m
CONFIG_I2C_CHARDEV=m
CONFIG_KEYBOARD_GPIO=m
CONFIG_LEDS_GPIO=m
CONFIG_LEDS_PWM=m
CONFIG_MARVELL_10G_PHY=m
CONFIG_MDIO_BUS_MUX_MMIOREG=m
CONFIG_MICREL_PHY=m
# SD card reader — internal PCIe SDHCI slot on MacBook Pro 14"/16".
# Not in arm64 defconfig; upstream Asahi ships CONFIG_MMC_SDHCI_PCI=m.
CONFIG_MMC_SDHCI_PCI=m
CONFIG_NLS_ISO8859_1=m
CONFIG_NOP_USB_XCEIV=m
CONFIG_SQUASHFS=m
CONFIG_TUN=m
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_MMIO=m
CONFIG_VIRTIO_NET=m
CONFIG_VITESSE_PHY=m
# HID — raw device access for FIDO2/U2F (YubiKey, etc.)
CONFIG_HIDRAW=y
CONFIG_UHID=y
# Disabled features
# CONFIG_EFI_ARMSTUB_DTB_LOADER is not set
# CONFIG_HW_RANDOM_ARM_SMCCC_TRNG is not set
# CONFIG_BRCMFMAC_SDIO is not set
# In arm64 defconfig but no fbdev driver in our config selects it,
# so olddefconfig drops it; mirror that to keep verify-config happy.
# CONFIG_FB_MODE_HELPERS is not set
# Kconfig dependency fixes — options that kconfig drops or changes
# CONFIG_SND_SOC_ROCKCHIP is not set
CONFIG_USB_MUSB_SUNXI=m
# CONFIG_IPQ_APSS_5018 is not set
# CONFIG_NVMEM_MESON_EFUSE is not set
# CONFIG_SLIM_QCOM_CTRL is not set
# Stale arm64 defconfig entry: no Kconfig defines SENSORS_SA67MCU in
# the Asahi 7.0 tree, so olddefconfig drops it.
# CONFIG_SENSORS_SA67MCU is not set
# NFS_V4_1 ceased to be a standalone symbol in 7.0 (NFSv4.1 is now
# implied by NFS_V4); olddefconfig drops the obsolete entry.
# CONFIG_NFS_V4_1 is not set
CONFIG_PCI_PWRCTRL_GENERIC=y

# ==== Local ====
# keyd creates its virtual keyboard through uinput.
CONFIG_INPUT_UINPUT=m
