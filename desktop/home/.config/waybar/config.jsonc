{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["network", "battery", "clock", "tray"],
  "hyprland/workspaces": {"on-click": "activate"},
  "hyprland/window": {"max-length": 60},
  "network": {"format-wifi": "{essid} {signalStrength}%", "format-ethernet": "Ethernet", "format-disconnected": "Offline", "on-click": "kitty nmtui"},
  "battery": {"format": "{capacity}%", "format-charging": "+{capacity}%"},
  "clock": {"format": "{:%a %d %b  %H:%M}"}
}
