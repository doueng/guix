#!/usr/bin/env bb
(ns stow-home
  (:require [babashka.fs :as fs]
            [babashka.process :as process]
            [clojure.java.io :as io]))

(def repo (-> *file* io/file .getCanonicalFile .getParentFile .getPath))
(def home (or (System/getenv "HOME") (throw (ex-info "HOME is not set" {}))))
(def stow (or (System/getenv "STOW") (str home "/.guix-home/profile/bin/stow")))

(defn stow-package! [dir target package]
  (fs/create-dirs target)
  (process/shell {:inherit true} stow (str "--dir=" dir)
                 (str "--target=" target) "--no-folding" "--ignore=node_modules" "--restow" package))

(doseq [app ["bbh" "doom" "fish" "ghostty" "git" "herdr" "hypr" "kanata" "keybindings" "vimium"
             "jj" "jjui" "dusk" "nvim" "rexmux" "ghostty-rex"]]
  (stow-package! (str repo "/configs") (str home "/.config/" app) app))

(stow-package! (str repo "/configs") home "ideavim")
(stow-package! repo (str home "/.local/bin") "bin")
(stow-package! (str repo "/pi") (str home "/.pi/agent") "agent")
;; Claude Code reads ~/.claude/skills; Pi and bbh already see every skill above.
(doseq [skill ["explain" "rexmux"]]
  (stow-package! (str repo "/pi/agent/skills") (str home "/.claude/skills/" skill) skill))

(defn dangling-repo-link? [path]
  (and (fs/sym-link? path)
       (not (fs/exists? path))
       (let [target (fs/normalize (fs/path (fs/parent path) (fs/read-link path)))]
         (.startsWith target (fs/path repo)))))

(defn prune! [root recursive?]
  (when (fs/directory? root)
    (let [links (if recursive?
                  (let [found (atom [])]
                    (fs/walk-file-tree root {:visit-file (fn [p _] (when (dangling-repo-link? p) (swap! found conj p)) :continue)
                                             :visit-file-failed (fn [_ _] :skip-subtree)})
                    @found)
                  (filter dangling-repo-link? (fs/list-dir root)))]
      (doseq [link links]
        (println "stow-home: removing dangling" (str link))
        (fs/delete link)
        (loop [dir (fs/parent link)]
          (when (and (not= (fs/canonicalize dir) (fs/canonicalize root)) (empty? (fs/list-dir dir)))
            (fs/delete dir)
            (recur (fs/parent dir))))))))

(prune! (str home "/.config") true)
(prune! (str home "/.local/bin") true)
(prune! (str home "/.pi/agent") true)
(prune! (str home "/.claude/skills") true)
(prune! home false)
