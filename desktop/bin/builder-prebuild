#!/usr/bin/env bb
;; Usage, on the laptop:
;;   builder-prebuild build     push @ to the builder, build system, Home and
;;                              desktop/build/*/manifest.scm there, wait
;;   builder-prebuild check     publish reachable, last prebuild, nothing to build locally
;;   builder-prebuild machines  print a machines.scm for `sudo guix offload test FILE'
;; On the builder (the prebuild account's git-shell command and mcron job):
;;   prebuild run REV | nightly | status
;; See docs/remote-builder-plan.md.
(ns builder-prebuild
  (:require [babashka.fs :as fs]
            [babashka.process :as p]
            [clojure.edn :as edn]
            [clojure.string :as str]))

(def host (or (System/getenv "BUILDER") "guix-builder.tailbf68ad.ts.net"))
(def home (System/getProperty "user.home"))
(def ssh-key (or (System/getenv "BUILDER_SSH_KEY") (str home "/.config/guix-builder/deploy_ed25519")))
(def ssh-cmd (str "ssh -i " ssh-key " -o BatchMode=yes -o ConnectTimeout=10"))
(def publish (str "http://" host ":8080"))

(defn die [& msg] (binding [*out* *err*] (apply println msg)) (System/exit 1))
(defn out [& args]
  (let [[opts args] (if (map? (first args)) [(first args) (rest args)] [{} args])]
    (str/trim (:out (apply p/shell (assoc opts :out :string) args)))))

;;; Laptop side

(def repo (delay (-> *file* fs/real-path fs/parent fs/parent fs/parent str)))
(def guix (str home "/.config/guix/current/bin/guix"))

;; Channels in channels.scm with a file:// url, such as the nixpkgs-bridge
;; checkout: [name path commit].  The builder can't reach the laptop's paths,
;; so push-and-build pushes each pinned commit into its guix.git as
;; refs/heads/channel-NAME and the builder points the url there.
(defn local-channels [text]
  (for [[_ name path commit]
        (re-seq #"\(name '(\S+)\)\s*\(url \"file://([^\"]+)\"\)\s*(?:\(branch \"[^\"]*\"\)\s*)?\(commit \"([0-9a-f]+)\"\)"
                text)]
    [name path commit]))

(defn push-and-build []
  ;; jj snapshots @ into a commit in its git store; push that commit by id so an
  ;; undescribed working copy, such as an `updates apply' edit, can be built.
  (let [rev (out {:dir @repo} "jj log --no-graph -r @ -T commit_id")
        git-dir (out {:dir @repo} "jj git root")
        push (fn [git-dir refspec]
               (p/shell {:extra-env {"GIT_SSH_COMMAND" ssh-cmd}}
                        "git" (str "--git-dir=" git-dir) "push" "--force" "--quiet"
                        (str "prebuild@" host ":guix.git") refspec))]
    (println "prebuild" rev "on" host)
    (push git-dir (str rev ":refs/heads/prebuild"))
    (doseq [[name path commit] (local-channels (slurp (str @repo "/channels.scm")))]
      (println "channel" name commit "from" path)
      (push (out {:dir path} "jj git root") (str commit ":refs/heads/channel-" name)))
    (let [{:keys [exit]} (apply p/shell {:continue true}
                                (concat (str/split ssh-cmd #" ") [(str "prebuild@" host) "prebuild" "run" rev]))]
      (when-not (zero? exit)
        (die (str "prebuild of " rev " on " host " failed (exit " exit "); its log is above"))))))

(defn dry-run-builds [kind config]
  ;; --dry-run lists what the daemon would build; with the builder first, that
  ;; should be nothing.
  (let [{:keys [err]} (p/shell {:dir @repo :err :string :continue true}
                               guix kind "build" "--dry-run" "-L" "modules" config
                               (str "--substitute-urls=" publish " https://bordeaux.guix.gnu.org"))
        lines (vec (str/split-lines (or err "")))]
    ;; "The following derivations would be built:" lists them indented by
    ;; two spaces; profile hooks and grafts come under their own headers.
    (->> (range (count lines))
         (filter #(re-find #"^The following derivations? would be built" (lines %)))
         (mapcat #(take-while (fn [l] (re-find #"^\s+/gnu/store/" l)) (drop (inc %) lines)))
         (map str/trim))))

(defn check []
  (let [ok? (zero? (:exit (p/shell {:continue true :out :string :err :string}
                                    "curl" "-fsS" "--max-time" "10" (str publish "/nix-cache-info"))))]
    (println (if ok? "publish: ok" (str "publish: unreachable at " publish)))
    (when ok?
      (apply p/shell {:continue true}
             (concat (str/split ssh-cmd #" ") [(str "prebuild@" host) "prebuild" "status"])))
    (let [missing (concat (dry-run-builds "system" "desktop/system.scm")
                          (dry-run-builds "home" "desktop/home.scm"))]
      (if (empty? missing)
        (println "local builds: none")
        (do (println (count missing) "derivations would build:")
            (run! println (take 20 missing))
            (System/exit 1))))))

(defn machines []
  (let [host-key (some-> (str @repo "/modules/engstrand/builder/host-key.pub")
                         (as-> f (when (fs/exists? f) (str/trim (slurp f)))))]
    (when-not host-key (die "modules/engstrand/builder/host-key.pub is missing; see phase 2"))
    (println (str "(list (build-machine\n"
                  "       (name \"" host "\")\n"
                  "       (systems '(\"aarch64-linux\"))\n"
                  "       (user \"offload\")\n"
                  "       (host-key \"" host-key "\")\n"
                  "       (private-key \"/etc/guix/offload/id_ed25519\")\n"
                  "       (parallel-builds 1)))"))))

;;; Builder side

(def state "/var/lib/prebuild")
(def bin "/run/current-system/profile/bin")
(def status-file (str state "/status.edn"))
(def keep-revisions 3)

(defn sh! [log & args]
  (println "$" (str/join " " args))
  (spit log (str "$ " (str/join " " args) "\n") :append true)
  (apply p/shell {:dir (str state "/work")
                  :extra-env {"PATH" (str bin ":" (System/getenv "PATH"))}
                  :out :inherit :err :inherit} args))

(defn read-status [] (if (fs/exists? status-file) (edn/read-string (slurp status-file)) {}))

(defn prune-roots []
  (let [revs (->> (fs/list-dir (str state "/roots"))
                  (sort-by #(fs/last-modified-time %))
                  reverse
                  (map #(second (re-find #"-([0-9a-f]{40})$" (str (fs/file-name %)))))
                  distinct)]
    (doseq [old (drop keep-revisions revs)
            root (fs/glob (str state "/roots") (str "*-" old))]
      (fs/delete root))))

(defn manifests [work]
  (sort (map #(fs/relativize work %) (fs/glob work "desktop/build/*/manifest.scm"))))

(defn manifest-root [m] (str "manifest-" (fs/file-name (fs/parent m))))

(defn run-prebuild [rev]
  (when-not (re-matches #"[0-9a-f]{40}" (str rev)) (die "usage: prebuild run COMMIT"))
  (let [lock (java.nio.channels.FileChannel/open
              (fs/path state "lock")
              (into-array java.nio.file.OpenOption
                          [java.nio.file.StandardOpenOption/CREATE java.nio.file.StandardOpenOption/WRITE]))]
    (when-not (.tryLock lock) (die "another prebuild is running"))
    (let [log (str state "/logs/" rev ".log")
          work (str state "/work")
          channels (str state "/channels.scm")
          tm [(str bin "/guix") "time-machine" "-C" channels "--"]
          root #(str state "/roots/" % "-" rev)
          nix-key (str state "/nixpkgs-key.sec")
          started (str (java.time.Instant/now))]
      (when-not (fs/exists? work)
        (p/shell "git" "clone" "--quiet" (str state "/guix.git") work))
      (try
        (sh! log "git" "fetch" "--quiet" "origin" "+refs/heads/*:refs/remotes/origin/*")
        (sh! log "git" "checkout" "--quiet" "--detach" rev)
        ;; channels.scm with each file:// url pointing at the commits
        ;; push-and-build put in guix.git.
        (spit channels (str/replace (slurp (str work "/channels.scm"))
                                    #"\(url \"file://[^\"]+\"\)"
                                    (str "(url \"file://" state "/guix.git\")")))
        ;; What `make pull' builds: the channel instances at these commits.
        (apply sh! log (concat tm ["describe"]))
        ;; The nixpkgs-bridge channel's binaries.  The daemon must trust
        ;; nixpkgs-key.pub, which modules/engstrand/builder/nixpkgs-builder.pub holds.
        (when (str/includes? (slurp channels) "(name 'nixpkgs-bridge)")
          (when-not (fs/exists? nix-key)
            (apply sh! log (concat tm ["nixpkgs-bridge" "key" nix-key])))
          (apply sh! log (concat tm ["nixpkgs-bridge" "import" nix-key])))
        (apply sh! log (concat tm ["system" "build" "-L" "modules" "desktop/system.scm" "-r" (root "system")]))
        ;; guix home build has no --root; guix build lowers the home environment the same way.
        (apply sh! log (concat tm ["build" "-L" "modules" "-f" "desktop/home.scm" "-r" (root "home")]))
        ;; Development manifests, such as dusk's Rust toolchain.
        (doseq [m (manifests work)]
          (apply sh! log (concat tm ["shell" "-m" (str m) "-r" (root (manifest-root m)) "--" "true"])))
        ;; Ask publish for every item now, so its cache bakes before the laptop asks.
        (let [items (apply out (str bin "/guix") "gc" "-R" (root "system") (root "home")
                           (map (comp root manifest-root) (manifests work)))]
          (spit (str state "/items") items)
          (doseq [item (str/split-lines items)]
            (p/shell {:continue true :out :string :err :string}
                     "curl" "-fsS" "-o" "/dev/null"
                     (str "http://localhost:8080/" (subs (fs/file-name item) 0 32) ".narinfo"))))
        (prune-roots)
        (spit status-file (pr-str {:rev rev :ok? true :started started :finished (str (java.time.Instant/now)) :log log}))
        (println "prebuild ok" rev)
        (catch Exception e
          (spit status-file (pr-str {:rev rev :ok? false :started started :error (ex-message e) :log log}))
          (die "prebuild failed:" (or (some->> (:cmd (ex-data e)) (str/join " ")) (ex-message e)) "; log" log))))))

(defn nightly []
  (let [rev (str/trim (:out (p/shell {:out :string :continue true}
                                     "git" (str "--git-dir=" state "/guix.git") "rev-parse" "--verify" "-q" "prebuild")))
        {last-rev :rev ok? :ok?} (read-status)]
    (cond (str/blank? rev) (println "nothing pushed yet")
          (and ok? (= rev last-rev)) (println "already built" rev)
          :else (run-prebuild rev))))

(let [[cmd & args] *command-line-args*]
  (case cmd
    "build" (push-and-build)
    "check" (check)
    "machines" (machines)
    "run" (run-prebuild (first args))
    "nightly" (nightly)
    "status" (prn (read-status))
    (die "usage: builder-prebuild build|check|machines (laptop) or run REV|nightly|status (builder)")))
