#!/usr/bin/env bb
(ns md-view
  "Render Markdown or Org with pandoc, or take an HTML file as it is, and show it in
  Chrome with live reload, in a terminal pane, or in the phone's bbh Docs list."
  (:require [babashka.fs :as fs]
            [babashka.process :as p]
            [clojure.string :as str]
            [org.httpkit.client :as client]
            [org.httpkit.server :as server])
  (:import (java.net URI URLDecoder URLEncoder)
           (java.security MessageDigest)
           (java.util Base64)))

(def home (System/getProperty "user.home"))
(def port (parse-long (or (second (drop-while #(not= "serve" %) *command-line-args*))
                          (System/getenv "MD_VIEW_PORT") "7341")))
(def origin (str "http://127.0.0.1:" port))
(def pandoc (str (or (fs/which "pandoc") (fs/path home ".guix-home/profile/bin/pandoc"))))

(def css "
