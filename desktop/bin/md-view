#!/usr/bin/env bb
;; Flatpak Chrome only sees ~/Downloads among home dirs (not ~/.cache or host /tmp).

(require '[babashka.fs :as fs]
         '[babashka.process :as p]
         '[clojure.string :as str])

(import '(java.net URI URLDecoder)
        '(java.security MessageDigest)
        '(java.util Base64))

(def home (System/getProperty "user.home"))
(def out-dir (fs/path (or (System/getenv "MD_VIEW_DIR") (fs/path home "Downloads" ".md-view"))))
(def max-pages 200)
(def pandoc (str (or (fs/which "pandoc") (fs/path home ".guix-home/profile/bin/pandoc"))))

(def css "
:root{color-scheme:light dark;--fg:#1c2230;--mut:#5d6678;--bg:#f7f6f2;--card:#fff;--line:#dedad0;--link:#2f6f8f;--code:#ece9e1;
--kw:#7a4fa0;--st:#2e7d4f;--co:#8a8f9c;--dt:#8a6a1f;--fu:#2f6f8f;--er:#b3382c}
@media(prefers-color-scheme:dark){:root{--fg:#dfe3ea;--mut:#9aa3b2;--bg:#16181d;--card:#1e2128;--line:#3d4350;--link:#7cc0e0;--code:#262a33;
--kw:#c79bf0;--st:#8fd19e;--co:#7d8594;--dt:#e3c07a;--fu:#7cc0e0;--er:#f08a7e}}
*{box-sizing:border-box}
body{margin:0;font:15px/1.6 system-ui,-apple-system,'Segoe UI',sans-serif;color:var(--fg);background:var(--bg)}
main{max-width:900px;margin:0 auto;padding:26px 20px 80px}
.src{font:11.5px ui-monospace,Menlo,monospace;color:var(--mut);margin-bottom:14px;word-break:break-all}
h1,h2{padding-bottom:4px;border-bottom:1px solid var(--line)}h1{font-size:27px}h2{font-size:21px;margin-top:36px}
a{color:var(--link)}img{max-width:100%}hr{border:0;border-top:1px solid var(--line)}
code{font:13px ui-monospace,SFMono-Regular,Menlo,monospace;background:var(--code);padding:1px 4px;border-radius:3px}
