code span.co,code span.do,code span.an,code span.cv{color:var(--co);font-style:italic}
code span.dt,code span.dv,code span.bn,code span.fl,code span.cn,code span.sc{color:var(--dt)}
code span.fu,code span.bu,code span.at,code span.va{color:var(--fu)}code span.er,code span.al{color:var(--er)}
code span.op,code span.ot,code span.pp{color:inherit}
")

(def template
  (str "<!doctype html>\n<html><head><meta charset=utf-8>"
       "<meta name=viewport content='width=device-width,initial-scale=1'>"
       "<title>$pagetitle$</title><style>" css "</style></head>\n"
       "<body><main><div class=src>$source$</div>\n$body$\n</main></body></html>\n"))

(defn sha1 [s]
  (let [d (.digest (MessageDigest/getInstance "SHA-1") (.getBytes (str s) "UTF-8"))]
    (apply str (map #(format "%02x" %) d))))

(defn page-for [src] (fs/path out-dir (str (sha1 src) ".html")))

(defn ->path [arg]
  (fs/canonicalize (if (str/starts-with? arg "file:") (fs/path (URI. arg)) arg)))

(defn relative? [url]
  (not (or (str/blank? url) (str/starts-with? url "#") (str/starts-with? url "/")
           (re-find #"^[a-zA-Z][a-zA-Z0-9+.-]*:" url))))

(defn resolve-url [dir url]
  (let [[path frag] (str/split url #"#" 2)]
    [(fs/normalize (fs/path dir (URLDecoder/decode path "UTF-8"))) frag]))

(defn markdown? [path] (re-find #"(?i)\.(md|markdown|mdown|mkd)$" (str path)))

(def mime {"png" "image/png" "jpg" "image/jpeg" "jpeg" "image/jpeg" "gif" "image/gif"
           "webp" "image/webp" "svg" "image/svg+xml" "avif" "image/avif"})

(defn data-uri [path]
  (when-let [m (and (fs/regular-file? path) (mime (str/lower-case (fs/extension path))))]
    (str "data:" m ";base64,"
         (.encodeToString (Base64/getEncoder) (fs/read-all-bytes path)))))

(defn escape-attr [s] (str/escape (str s) {\& "&amp;" \" "&quot;" \< "&lt;"}))

(defn rewrite
  "Point relative hrefs at rendered pages or file:// URLs and inline relative images.
  Returns [html linked-markdown-sources]."
  [html dir]
  (let [linked (volatile! #{})
        html (str/replace html #"(href|src)=\"([^\"]*)\""
               (fn [[whole attr url]]
                 (let [url (str/replace url "&amp;" "&")]
                   (if-not (relative? url)
                     whole
                     (let [[path frag] (resolve-url dir url)
                           frag (when frag (str "#" frag))]
                       (cond
                         (= attr "src")
                         (if-let [uri (data-uri path)] (str "src=\"" uri "\"") whole)

                         (and (markdown? path) (fs/regular-file? path))
                         (let [path (fs/canonicalize path)]
                           (vswap! linked conj path)
                           (str "href=\"" (fs/file-name (page-for path)) frag "\""))

                         :else
                         (str "href=\"" (escape-attr (str (.toUri (fs/path path)) frag)) "\"")))))))]
    [html @linked]))

(defn render! [src template-file]
  (let [page (page-for src)
        dir (fs/parent src)
        fresh? (and (fs/exists? page)
                    (every? #(pos? (compare (fs/last-modified-time page) (fs/last-modified-time %)))
                            [src template-file]))]
    (if fresh?
      (let [links (str page ".links")]
        (when (fs/exists? links)
          (map fs/path (remove str/blank? (str/split-lines (slurp links))))))
      (let [{:keys [out err exit]}
            (p/shell {:out :string :err :string :continue true :dir (str dir)}
                     pandoc "--from=gfm+footnotes" "--to=html5" "--standalone" "--wrap=none"
                     (str "--template=" template-file)
                     "--highlight-style=pygments"
                     "-M" (str "pagetitle=" (fs/file-name src))
                     "-V" (str "source=" src)
                     (str src))]
        (when-not (zero? exit)
          (binding [*out* *err*] (println "md-view: pandoc failed on" (str src) "\n" err))
          (System/exit 1))
        (let [[html linked] (rewrite out dir)]
          (spit (str page) html)
          (spit (str page ".links") (str/join "\n" linked))
          linked)))))

(defn render-all!
  "Render root and the markdown it links to, breadth first, up to max-pages."
  [root]
  (let [template-file (str (fs/path out-dir "template.html"))]
    (fs/create-dirs out-dir)
    (when-not (= template (when (fs/exists? template-file) (slurp template-file)))
      (spit template-file template))
    (loop [queue [root] seen #{root}]
      (when-let [src (first queue)]
        (let [linked (remove seen (render! src template-file))
              room (max 0 (- max-pages (count seen)))
              linked (take room linked)]
          (recur (into (subvec queue 1) linked) (into seen linked)))))
    (page-for root)))

(let [no-open? (some #{"--no-open"} *command-line-args*)
      files (remove #{"--no-open"} *command-line-args*)]
  (when (empty? files)
    (binding [*out* *err*] (println "usage: md-view [--no-open] FILE.md|file://URI ..."))
    (System/exit 2))
  (let [pages (mapv (comp render-all! ->path) files)]
    (if no-open?
      (run! (comp println str) pages)
      (apply p/exec (str home "/.local/bin/chrome-unified")
             (map #(str (.toUri (fs/path %))) pages)))))
