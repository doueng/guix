#!/usr/bin/env bb
;; stale: what runs old code or config after a change in ~/guix, and the command
;; that refreshes it (T218). make status and make refresh call it; make switch
;; and make home end with a refresh.
;;
;;   stale            the stale components, with why and the fix, then the fresh ones
;;   stale --all      every component in a table
;;   stale refresh    run every fix that is safe unattended, then list what needs you
;;   stale --edn      the facts and rows, for debugging
(require '[babashka.classpath :as classpath]
         '[bencode.core :as bencode]
         '[babashka.fs :as fs]
         '[babashka.process :as p]
         '[cheshire.core :as json]
         '[clojure.pprint :as pprint]
         '[clojure.string :as str])
(def here (str (fs/normalize (fs/path (fs/parent (fs/real-path *file*)) ".." ".."))))
(classpath/add-classpath (str here "/desktop/lib"))
;; The checkout Home links to, which the running processes and the last switch
;; came from, even when this script runs from a Worker's workspace.
(def repo (or (System/getenv "STALE_REPO")
              (some-> (try (fs/real-path (fs/path (System/getenv "HOME") ".local/bin/bbh")) (catch Exception _ nil))
                      fs/parent fs/parent fs/parent str)
              here))
(require '[stale] '[stale.collect :as collect] '[session])

(defn run [argv & [opts]]
  (try (apply p/sh (merge {:continue true :in ""} opts) argv)
       (catch Exception e {:exit 127 :out "" :err (ex-message e)})))

(def herd-bin "/run/current-system/profile/bin/herd")

(def ctx
  {:root "/" :repo repo :home (System/getenv "HOME")
   :user (or (System/getenv "USER") (System/getProperty "user.name"))
   :stamps (str (session/runtime-dir) "/stale")
   :super-dir (str (or (System/getenv "XDG_DATA_HOME") (str (System/getenv "HOME") "/.local/share")) "/bbh/super")
   :herd (fn [scope & args]
           (let [{:keys [exit out]} (run (if (= scope :system) (into ["sudo" "-n" herd-bin] args) (into ["herd"] args)))]
             (when (zero? exit) out)))
   :requisites (fn [item] (str/split-lines (:out (run ["guix" "gc" "-R" item]))))})

(def env (or (session/wayland-env) {}))

(defn shown [s n] (let [s (str s)] (if (> (count s) n) (str (subs s 0 (dec n)) "…") s)))

(defn print-stale [rows]
  (let [{:keys [total stale auto manual pending]} (stale/summary rows)]
    (println (str total " components, " stale " stale"
                  (when (pos? stale) (str ": make refresh fixes " (count auto) ", " (count manual) " need you"))
                  (when (seq pending) (str "; " (count pending) " pending"))))
    (doseq [r (concat auto manual pending)]
      (println)
      (println (str "  " (:label r) (when (:pid r) (str " (pid " (:pid r) ")"))))
      (when (:running r) (println (str "    running  " (:running r) (when (and (:current r) (not= (:current r) (:running r))) (str "  current " (:current r))))))
      (println (str "    why      " (:why r)))
      (when (:note r) (println (str "    note     " (:note r))))
      (if-let [p (get-in r [:fix :pending])]
        (do (println (str "    fix      " p))
            (println (str "    how      " (get-in r [:fix :cmd]))))
        (println (str "    fix      " (get-in r [:fix :cmd]) (if (get-in r [:fix :run]) "  (make refresh)" (str "  (manual: " (get-in r [:fix :manual]) ")"))))))
    (println)
    (doseq [[group title] [[:system "system"] [:home "home"] [:session "session"]]
            :let [fresh (filter #(and (= :fresh (:state %)) (= group (:group %))) rows)]
            :when (seq fresh)]
      (println (str "fresh " title ": " (str/join ", " (map :label fresh)))))))

(defn print-all [rows]
  (println (format "%-6s %-30s %-34s %s" "STATE" "COMPONENT" "RUNNING" "FIX"))
  (doseq [r rows]
    (println (format "%-6s %-30s %-34s %s" (name (:state r)) (shown (:label r) 30) (shown (:running r) 34)
                     (or (get-in r [:fix :cmd]) "")))))

(defn respawn!
  "Stop PID, if any, and start ARGV detached in the Hyprland session; fail unless
  it still runs two seconds later."
  [pid argv]
  (let [argv (mapv #(str/replace-first % #"^~/" (str (System/getenv "HOME") "/")) argv)
        running #(set (str/split-lines (:out (run ["pgrep" "-fx" (str/join " " argv)]))))
        before (running)]
    (when pid
      (run ["kill" (str pid)])
      (loop [n 0] (when (and (< n 30) (fs/exists? (str "/proc/" pid))) (Thread/sleep 100) (recur (inc n)))))
    (if-not (get env "HYPRLAND_INSTANCE_SIGNATURE")
      {:exit 1 :err "no live Hyprland session to start it in"}
      (do @(p/process (into ["setsid" "-f"] argv) {:extra-env env :out :discard :err :discard :in ""})
          (Thread/sleep 2000)
          (if (seq (remove (disj before (str pid)) (running)))
            {:exit 0}
            {:exit 1 :err (str "it exited at once: " (str/join " " argv))})))))

(defn emacs-eval
  "Have the Emacs daemon SERVER run the form FORM, a string, and answer t. The
  timeout keeps a daemon stuck in a prompt from stalling the refresh."
  [server form]
  (run ["timeout" "60" "emacsclient" "-s" server "--eval" (str "(progn " form " t)")]))

(def reload-env-form
  "Load the env file in a daemon, first loading session-env.el when the daemon
  predates eng/reload-env-file."
  "(unless (fboundp 'eng/reload-env-file) (load (expand-file-name \"session-env.el\" eng/doom-config-dir) nil t)) (eng/reload-env-file %s)")

(defn rex-clients
  "IDs of the ghostty-rex clients connected to Rex."
  []
  (let [{:keys [exit out]} (run ["rex" "client" "ls" "--json"])]
    (if-not (zero? exit)
      #{}
      (set (keep #(when (and (= "ghostty-rex" (get-in % ["info" "label"])) (= "connected" (get % "connection_state")))
                    (get % "client_id"))
                 (get (json/parse-string out) "clients"))))))

(defn rex-client-reload!
  "Reload the ghostty-rex client. One that predates T218 execs before Rex passes
  on its answer, so the caller hears a lost connection: count that as done once a
  new client has attached."
  []
  (let [before (rex-clients)
        r (run ["rex" "-C" "ghostty-rex" "do" "mx.client.reload"] {:extra-env env})]
    (if (or (zero? (:exit r)) (not (str/includes? (str (:err r) (:out r)) "lost its connection")))
      r
      (loop [n 0]
        (cond (seq (remove before (rex-clients))) {:exit 0}
              (< n 30) (do (Thread/sleep 500) (recur (inc n)))
              :else r)))))

(defn nrepl-eval
  "Evaluate CODE in the nREPL server whose port PORT-FILE holds, as a request
  of its own beside any eval the session's agent runs. Returns {:exit :out :err}."
  [port-file code]
  (try
    (with-open [sock (doto (java.net.Socket. "127.0.0.1" (parse-long (str/trim (slurp port-file)))) (.setSoTimeout 60000))]
      (let [out (java.io.PushbackInputStream. (.getInputStream sock))
            in (.getOutputStream sock)
            text #(if (bytes? %) (String. ^bytes % "UTF-8") (str %))]
        (bencode/write-bencode in {"op" "eval" "code" code "id" "stale"})
        (.flush in)
        (loop [acc {:exit 0 :out "" :err ""}]
          (let [m (bencode/read-bencode out)
                acc (cond-> acc
                      (get m "err") (update :err str (text (get m "err")))
                      (get m "ex") (assoc :exit 1))
                status (set (map text (get m "status")))]
            (if (status "done") acc (recur acc))))))
    (catch Exception e {:exit 1 :out "" :err (str "nREPL at " port-file ": " (ex-message e))})))

(defn reload-form
  "Reload each namespace in NSS that the REPL has loaded, in order, and nothing
  it depends on."
  [nss]
  (str "(doseq [n '" (pr-str (vec nss)) "] (when (find-ns n) (require n :reload)))"))

(defn request-router-restart!
  "Ask the controller to restart the Router once it is idle: it watches this
  file, drains the Router and reopens it on its conversation."
  [why]
  (let [f (str (:super-dir ctx) "/restart-router")]
    (if-not (fs/exists? (:super-dir ctx))
      {:exit 1 :err (str "no super-agent directory " (:super-dir ctx))}
      (do (spit f (pr-str {:requested-at (System/currentTimeMillis) :by "make refresh" :why why}))
          {:exit 0 :scheduled "scheduled: the controller restarts the Router once it is idle"}))))

(defn kill-leftover!
  "TERM PID if it is still the process that started at START-MS."
  [pid start-ms]
  (if (not= start-ms (:start-ms (some #(when (= pid (:pid %)) %) (collect/procs ctx))))
    {:exit 0}
    (run ["kill" (str pid)])))

(defn perform!
  "Run one fix's :run; return {:exit :out :err}, with :scheduled when it only
  asked something else to do the work later."
  [[op & args]]
  (case op
    :emacs (let [[server what file] args]
             (emacs-eval server (case what
                                  :config "(eng/reload-config)"
                                  :env (format reload-env-form (pr-str file)))))
    :doom-env (run [(str (System/getenv "HOME") "/.config/emacs/bin/doom") "env" "-r" (first args)])
    :herd (let [[scope name] args]
            (run (if (= scope :system) ["sudo" "-n" herd-bin "restart" name] ["herd" "restart" name])))
    :hyprctl (run (into ["hyprctl"] args) {:extra-env env})
    :bin (run (into [(str repo "/desktop/bin/" (first args))] (rest args)) {:extra-env env})
    :sh (run (vec args) {:extra-env env})
    :respawn (respawn! (first args) (second args))
    :rex-client-reload (rex-client-reload!)
    :ghostty-reload (let [[pid start-ms text pending] args
                          r (run ["kill" "-USR2" (str pid)])]
                      (when (zero? (:exit r)) (collect/ghostty-reloaded! ctx pid start-ms text pending))
                      r)
    :stow (run ["bb" (str repo "/desktop/stow-home")])
    :nrepl-reload (let [[port-file nss] args] (nrepl-eval port-file (reload-form nss)))
    :router-restart (request-router-restart! (first args))
    :kill (apply kill-leftover! args)))

(defn refresh-pass!
  "Run the fix of each auto row not in TRIED, stamping the ones that work; return
  the ids it ran."
  [tried]
  (let [{:keys [auto]} (stale/summary (stale/assess (collect/facts ctx)))]
    (doall
     (for [r auto :when (not (tried (:id r)))]
       (let [t0 (System/currentTimeMillis)
             _ (do (print (str "refresh: " (:label r) ": " (get-in r [:fix :cmd]) " ... ")) (flush))
             {:keys [exit out err scheduled]} (perform! (get-in r [:fix :run]))]
         (cond (not (zero? exit)) (println (str "failed: " (str/trim (str err out))))
               scheduled (println scheduled)
               :else (do (collect/stamp! ctx (or (get-in r [:fix :stamp]) (:id r)) t0) (println "ok")))
         (:id r))))))

(defn refresh!
  "Two passes, since one fix can stale another row: doom env rewrites the env file
  the Emacs daemons then load. Then recheck everything."
  []
  (let [first-ids (set (refresh-pass! #{}))
        ids (into first-ids (refresh-pass! first-ids))
        facts (collect/facts ctx)
        rows (stale/assess facts)
        fresh (set (keep #(when (= :fresh (:state %)) (:id %)) rows))]
    (collect/ghostty-seed! ctx (filter #(fresh (str "ghostty:" (:pid %))) (:ghostty facts)))
    (when (seq ids) (println))
    (print-stale rows)))

(case (first *command-line-args*)
  nil (print-stale (stale/assess (collect/facts ctx)))
  "--all" (print-all (stale/assess (collect/facts ctx)))
  "--edn" (let [f (collect/facts ctx)] (pprint/pprint {:facts (dissoc f :closure :procs) :rows (stale/assess f)}))
  "refresh" (refresh!)
  (do (binding [*out* *err*] (println "usage: stale [--all|--edn|refresh]")) (System/exit 2)))
