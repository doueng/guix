#!/usr/bin/env bb

(require '[babashka.fs :as fs]
         '[babashka.process :as p]
         '[clojure.string :as str])

(def home (System/getProperty "user.home"))

(defn find-executable [name]
  (or (some-> (fs/which name) str)
      (some (fn [directory]
              (let [candidate (str directory "/" name)]
                (when (fs/executable? candidate) candidate)))
            [(str home "/.local/bin")
             (str home "/.guix-home/profile/bin")])))

(defn executable [name]
  (or (find-executable name) name))

(defn apps []
  ;; Reuse the checked-in launcher so its Flatpak application ID and Wayland
  ;; flags stay consistent with the documented browser installation.
  (let [chrome [(executable "chrome-unified")]]
    [["ghostty" [(executable "ghostty")]]
     ["chrome-incognito" (conj chrome "--incognito")]
     ["chrome" chrome]
     ["thunar" [(executable "thunar")]]]))

(defn run [command options]
  @(p/process command options))

(defn choose [dusk]
  (let [entries (str (str/join "\n" (map first (apps))) "\n")
        result (when dusk
                 (run [dusk "dmenu" "-p" ""]
                      {:in entries :out :string :err :string}))]
    (when-not dusk
      (binding [*out* *err*]
        (println "dusk is unavailable; cannot open launcher")))
    (when result
      (if-not (zero? (:exit result))
        (System/exit (:exit result))
        (some (fn [[name command]]
                (when (= name (str/trim (:out result))) command))
              (apps))))))

(defn main []
  (when-let [command (choose (find-executable "dusk"))]
    (try
      (p/process command)
      (catch Exception error
        (binding [*out* *err*]
          (println "Unable to launch" (first command) ":" (.getMessage error)))
        (System/exit 1)))))

(main)
