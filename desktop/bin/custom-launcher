#!/usr/bin/env python3
"""Custom application launcher: Noctalia dmenu when present, otherwise Wofi."""

import os
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")


def executable(name):
    """Find Home-profile commands even when SDDM starts Hyprland without PATH."""
    return shutil.which(name) or os.path.join(HOME, ".guix-home", "profile", "bin", name)


def apps():
    # Keep this list and its labels aligned with ~/nixos/scripts/custom-launcher.
    # Invoke Chrome through Flatpak directly so stale Home-profile symlinks cannot
    # select an old launcher or Chromium application ID.
    chrome = ["flatpak", "run", "com.google.Chrome"]
    return [
        ("cosmic-files", ["cosmic-files"]),
        ("wezterm", ["wezterm", "connect", "persistent"]),
        ("kitty", [executable("kitty")]),
        ("chrome-incognito", chrome + ["--incognito"]),
        ("chrome", chrome),
    ]


def run(argv, **kwargs):
    return subprocess.run(argv, **kwargs)


def ensure_noctalia():
    noctalia = executable("noctalia")
    if not os.path.isfile(noctalia) or not os.access(noctalia, os.X_OK):
        noctalia = None
    if not noctalia:
        return None
    if run([noctalia, "msg", "status"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        run([noctalia, "--daemon"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return noctalia


def choose(noctalia):
    entries = "\n".join(name for name, _ in apps()) + "\n"
    if noctalia:
        result = run([noctalia, "dmenu", "-p", ""], input=entries, text=True,
                     stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    else:
        wofi = shutil.which("wofi")
        if not wofi:
            print("No dmenu or wofi found", file=sys.stderr)
            return None
        result = run([wofi, "--dmenu", "-p", "launch"], input=entries, text=True,
                     stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    if result.returncode != 0:
        sys.exit(result.returncode)
    selection = result.stdout.strip()
    for name, command in apps():
        if selection == name:
            return command
    return None


def main():
    noctalia = ensure_noctalia()
    command = choose(noctalia)
    if command:
        try:
            subprocess.Popen(command)
        except FileNotFoundError as error:
            print(f"Unable to launch {command[0]}: {error}", file=sys.stderr)
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
