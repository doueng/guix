#!/usr/bin/env bb
(ns hyprkan
  (:require [babashka.fs :as fs]
            [babashka.process :as p]
            [cheshire.core :as json]
            [clojure.edn :as edn]
            [clojure.java.io :as io]
            [clojure.string :as str]))

(def kanata-address ["127.0.0.1" 7333])

(defn apps-path []
  (str (or (System/getenv "XDG_CONFIG_HOME") (str (fs/home) "/.config")) "/kanata/apps.edn"))

(defn layer-for [class]
  (get (edn/read-string (slurp (apps-path))) class "base"))

(defn send!
  "Send MESSAGE to kanata. With UNTIL, read kanata's messages and return the
  first non-nil result of UNTIL applied to the sequence of messages so far."
  ([message] (send! message nil))
  ([message until]
   (let [[host port] kanata-address]
     (with-open [socket (java.net.Socket. ^String host ^int port)]
       (.setSoTimeout socket 5000)
       (doto (.getOutputStream socket)
         (.write (.getBytes (str (json/generate-string message) "\n")))
         (.flush))
       (when until
         (some until (reductions conj [] (map #(json/parse-string % true)
                                             (line-seq (io/reader (.getInputStream socket)))))))))))

(defn reply [field] (fn [messages] (get (peek messages) field)))

(defn reset-after-reload
  "kanata reports ConfigFileReload, then the LayerChange that resets it to base."
  [messages]
  (some :LayerChange (drop-while (complement :ConfigFileReload) messages)))

(defn warn [& parts]
  (binding [*out* *err*] (apply println "hyprkan:" parts)))

;; kanata returns to its first layer on reload/restart, so send the layer on every focus change.
(defn focus! [class]
  (try (send! {:ChangeLayer {:new (layer-for class)}})
       (catch Exception e (warn "cannot reach kanata:" (ex-message e)))))

(defn active-class
  "The focused window's class, or nil with a one-line warning when hyprctl fails."
  []
  (let [{:keys [exit out err]} (p/sh {:continue true} "hyprctl" "-j" "activewindow")]
    (if (zero? exit)
      (:class (json/parse-string out true))
      (warn "hyprctl failed:" (str/trim (str out err))))))

(defn follow-focus! []
  (let [socket (str (System/getenv "XDG_RUNTIME_DIR") "/hypr/"
                    (System/getenv "HYPRLAND_INSTANCE_SIGNATURE") "/.socket2.sock")]
    (focus! (active-class))
    (with-open [channel (java.nio.channels.SocketChannel/open
                         (java.net.UnixDomainSocketAddress/of socket))
                reader (java.io.BufferedReader.
                        (java.io.InputStreamReader.
                         (java.nio.channels.Channels/newInputStream channel)))]
      (doseq [line (line-seq reader)
              :let [[_ class] (re-matches #"activewindow>>([^,]*),.*" line)]
              :when class]
        (focus! class)))))

(defn name-process!
  "earlyoom prefers to kill processes named bb (modules/engstrand/system/asahi.scm),
  under memory pressure. Without this follower kanata stays on the last app
  layer, so after a terminal Cmd+T and Cmd+W do nothing in Chrome. Under its own
  name it is ranked by its small memory instead."
  [name]
  (try (spit "/proc/self/comm" name)
       (catch Exception e (warn "cannot rename process:" (ex-message e)))))

(case (first *command-line-args*)
  nil (do (name-process! "hyprkan") (follow-focus!))
  "layer" (println (:name (send! {:RequestCurrentLayerName {}} (reply :CurrentLayerName))))
  "reload" (do (send! {:ReloadFile {:path "/etc/kanata/kanata.kbd"}} reset-after-reload)
               (some-> (active-class) focus!))
  (do (warn "usage: hyprkan [layer|reload]") (System/exit 2)))
