#!/usr/bin/env bb
;; Run pi-claude-bridge's bundled Claude Code on Guix (no /lib ELF loader).
(require '[babashka.fs :as fs] '[babashka.process :as p])
(let [agent-dir (or (System/getenv "PI_CODING_AGENT_DIR") (str (fs/home) "/.pi/agent"))
      claude (str agent-dir "/npm/node_modules/@anthropic-ai/claude-agent-sdk-linux-arm64/claude")
      loader (str (fs/home) "/.guix-home/profile/lib/ld-linux-aarch64.so.1")]
  (when-not (and (fs/executable? claude) (fs/executable? loader))
    (binding [*out* *err*]
      (println "claude-bridge-cli: install pi-claude-bridge and ensure the Guix Home glibc loader is available."))
    (System/exit 1))
  (apply p/exec loader "--argv0" claude claude *command-line-args*))
