#!/usr/bin/env bb
(require '[babashka.fs :as fs] '[babashka.process :as p])
(let [here (fs/parent (fs/real-path *file*))
      bin (str here "/../build/dusk/target/release/dusk")]
  (when-not (fs/executable? bin)
    (let [msg (str "dusk is not built (" (fs/normalize bin) " is missing): run make dusk")]
      (binding [*out* *err*] (println msg))
      (try (p/shell {:continue true :out :string :err :string} "hyprctl" "notify" "3" "30000" "0" msg)
           (catch Exception _))
      (System/exit 1)))
  (apply p/exec bin *command-line-args*))
