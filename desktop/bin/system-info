#!/usr/bin/env bb

(require '[clojure.string :as str]
         '[babashka.process :as p]
         '[babashka.fs :as fs])

(def home (System/getProperty "user.home"))
(def notify-replace-bin
  (let [installed (str home "/.local/bin/notify-replace")
        adjacent (str (fs/path (fs/parent (fs/real-path *file*))
                               "notify-replace"))]
    (if (fs/exists? installed) installed adjacent)))
(defn notification-id-file []
  (str (or (System/getenv "XDG_STATE_HOME")
           (str home "/.local/state"))
       "/noctalia-notifications/system-info.id"))

(defn close-system-info-later! []
  (let [id-file (notification-id-file)]
    (when (fs/exists? id-file)
      (let [id (str/trim (slurp id-file))]
        (when (seq id)
          (p/process ["sh" "-lc"
                      (str "sleep 5; busctl --user call org.freedesktop.Notifications "
                           "/org/freedesktop/Notifications org.freedesktop.Notifications "
                           "CloseNotification u " id " >/dev/null 2>&1 || true")]))))))

(defn get-bluetooth-connection []
  (try
    (let [result (p/shell {:out :string} "bluetoothctl" "info" "74:77:86:19:BA:5A")]
      (if (str/includes? (:out result) "Connected: yes")
        "🎧 AirPods connected"
        "🎧 Not connected"))
    (catch Exception _
      "🎧 Failed to check connection")))

(defn get-date-time []
  (let [date-result (p/shell {:out :string} "env" "LC_TIME=en_US.UTF-8" "date" "+%A, %B %d")
        time-result (p/shell {:out :string} "date" "+%H:%M")]
    (str "📅 " (str/trim (:out date-result))
         "\n🕐 " (str/trim (:out time-result)))))

(defn get-battery []
  (try
    (let [capacity-result (p/shell {:out :string} "cat" "/sys/class/power_supply/macsmc-battery/capacity")
          status-result (p/shell {:out :string} "cat" "/sys/class/power_supply/macsmc-battery/status")]
      (if (and (= (:exit capacity-result) 0) (= (:exit status-result) 0))
        (let [capacity (str/trim (:out capacity-result))
              status (str/trim (:out status-result))
              icon (case status
                     "Charging" "🔌"
                     "Discharging" "🔋"
                     "Full" "🔋"
                     "🔋")]
          (str icon " " capacity "% (" status ")"))
        "🔋 Battery info unavailable"))
    (catch Exception _
      "🔋 Battery info unavailable")))

(defn get-volume []
  (try
    (let [volume-result (p/shell {:out :string} "wpctl" "get-volume" "@DEFAULT_AUDIO_SINK@")]
      (if (= (:exit volume-result) 0)
        (let [output (str/trim (:out volume-result))
              muted? (str/includes? output "[MUTED]")
              volume-str (-> output
                             (str/replace "[MUTED]" "")
                             (str/replace "Volume:" "")
                             str/trim)
              volume-decimal (try (Double/parseDouble volume-str) (catch Exception _ 0.0))
              volume-percent (int (* volume-decimal 100))]
          (if muted?
            "🔇 Audio muted"
            (str "🔊 " volume-percent "%")))
        "🔊 Audio info unavailable"))
    (catch Exception _
      "🔊 Audio info unavailable")))

(defn show-notification [message]
  (p/shell notify-replace-bin
           "system-info"
           "--app-name="
           "--expire-time=0"
           "--hint=boolean:transient:true"
           message)
  (close-system-info-later!))

(defn main []
  (show-notification (str/join "\n" [(get-date-time)
                                     (get-bluetooth-connection)
                                     (get-battery)
                                     (get-volume)])))

(main)
