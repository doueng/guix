#!/usr/bin/env bb
;; ghostty-rex, the Rex client in Ghostty (T207, desktop/build/ghostty-rex).
;;   ghostty-rex              the window: Ghostty, class dev.engstrand.Rex,
;;                            running ghostty-rex attach. mux-terminal runs it
;;                            when ~/.config/engstrand/mux says ghostty-rex.
;;   ghostty-rex attach ARGS  the client in this terminal (--session S).
;; The client is bb run from this checkout, so an edit takes effect on the
;; next start. rexg-render, its C half, is REXG_RENDER, else the Guix
;; package's on PATH, else the target/ build of make build NAME=ghostty-rex in the checkout.
(require '[babashka.fs :as fs] '[babashka.process :as p])

(def here (fs/parent (fs/real-path *file*)))
(def build (str (fs/normalize (fs/path here ".." "build" "ghostty-rex"))))

(defn render []
  (or (not-empty (System/getenv "REXG_RENDER"))
      (some-> (fs/which "rexg-render") str)
      (let [t (str build "/target/rexg-render")] (when (fs/executable? t) t))))

(defn fail! [msg]
  (binding [*out* *err*] (println msg))
  (try (p/shell {:continue true :out :string :err :string} "hyprctl" "notify" "3" "30000" "0" msg)
       (catch Exception _))
  (System/exit 1))

(if (= "attach" (first *command-line-args*))
  (let [r (or (render) (fail! "ghostty-rex: rexg-render is missing: make build NAME=ghostty-rex, or make home with MUX=ghostty-rex"))]
    (apply p/exec {:extra-env {"REXG_RENDER" r}}
;; The heap cap keeps the client near 35 MB: uncapped, bb grows to its
           ;; peak and keeps it (T225, docs/ghostty-rex-lean.html step 9).
           (or (some-> (fs/which "bb") str) "bb") "-Xmx32m" "--config" (str build "/bb.edn") "attach" (rest *command-line-args*)))
  (let [conf (str (fs/path (or (System/getenv "XDG_CONFIG_HOME") (str (fs/home) "/.config")) "ghostty-rex" "ghostty"))]
    (apply p/exec "ghostty" "--class=dev.engstrand.Rex" "--gtk-single-instance=false"
           (concat (when (fs/exists? conf) [(str "--config-file=" conf)])
                   ["-e" (str (fs/real-path *file*)) "attach"]
                   *command-line-args*))))
