#!/usr/bin/env bb

(ns herdr-workspace-pick
  (:require [babashka.fs :as fs]
            [babashka.process :as process]
            [cheshire.core :as json]
            [clojure.string :as str]))

(defn bin-path [name]
  (let [home (System/getProperty "user.home")
        candidates [(str "/run/current-system/sw/bin/" name)
                    (str home "/.nix-profile/bin/" name)
                    (str home "/.local/bin/" name)]]
    (or (some #(when (fs/executable? %) %) candidates)
        name)))

(def herdr-bin (or (System/getenv "HERDR_BIN_PATH")
                   (bin-path "herdr")))

(def home (System/getProperty "user.home"))
(def state-dir
  (or (System/getenv "HERDR_WORKSPACE_PICK_STATE_DIR")
      (str (or (System/getenv "XDG_STATE_HOME")
               (str home "/.local/state"))
           "/herdr-workspace-pick")))
;; Keep the workspace we left so the next picker invocation behaves like a
;; last-workspace toggle instead of selecting the workspace we are already in.
(def state-file (str state-dir "/last-workspace"))

(defn eprintln [& values]
  (binding [*out* *err*]
    (apply println values)))

(defn run! [argv options]
  (let [result (try
                 @(process/process argv options)
                 (catch Exception error
                   {:exit 127
                    :out ""
                    :err (.getMessage error)}))]
    (if (zero? (:exit result))
      result
      (do
        (when (seq (:err result))
          (eprintln (:err result)))
        (System/exit (:exit result))))))

(defn workspaces []
  (let [output (:out (run! [herdr-bin "workspace" "list"]
                          {:out :string :err :string}))]
    (get-in (json/parse-string output true)
            [:result :workspaces]
            [])))

(defn read-last-workspace []
  (try
    (let [value (str/trim (slurp state-file))]
      (when (seq value)
        value))
    (catch Exception _
      nil)))

(defn current-workspace-id [items]
  (let [focused-id (some (fn [{:keys [focused workspace_id]}]
                           (when focused workspace_id))
                         items)]
    (or (some (fn [{:keys [workspace_id]}]
                (when (= (System/getenv "HERDR_ACTIVE_WORKSPACE_ID")
                         workspace_id)
                  workspace_id))
              items)
        focused-id)))

(defn prioritize [items preferred-id]
  (if-let [preferred (some #(when (= preferred-id (:workspace_id %)) %) items)]
    (cons preferred (remove #(= preferred-id (:workspace_id %)) items))
    items))

(defn first-other-workspace-id [items current-id]
  (some (fn [{:keys [workspace_id]}]
          (when (and workspace_id
                     (not= current-id workspace_id))
            workspace_id))
        items))

(defn preferred-workspace-id [items current-id]
  (let [previous-id (read-last-workspace)]
    (or (some (fn [{:keys [workspace_id]}]
                (when (and (= previous-id workspace_id)
                           (not= current-id workspace_id))
                  workspace_id))
              items)
        ;; There is no history to consult on the first run. Avoid selecting
        ;; the focused workspace when another open workspace is available.
        (first-other-workspace-id items current-id)
        current-id)))

(defn clean-text [value]
  (-> (str value)
      (str/replace #"[\t\r\n]+" " ")))

(defn row-data [{:keys [agent_status focused label number pane_count tab_count workspace_id]}]
  {:id workspace_id
   :number (clean-text (or number "-"))
   :label (str (if focused "* " "  ")
               (clean-text (or label "unnamed")))
   :status (clean-text (or agent_status "unknown"))
   :tabs (clean-text (or tab_count 0))
   :panes (clean-text (or pane_count 0))})

(defn column-width [rows key minimum]
  (max minimum
       (reduce max 0 (map #(count (str (key %))) rows))))

(defn layout [rows]
  (let [widths {:number (column-width rows :number 2)
                :label (column-width rows :label 9)
                :status (column-width rows :status 6)
                :tabs (column-width rows :tabs 4)
                :panes (column-width rows :panes 5)}
        format-string (str "%-" (:number widths) "s  "
                           "%-" (:label widths) "s  "
                           "%-" (:status widths) "s  "
                           "%" (:tabs widths) "s  "
                           "%" (:panes widths) "s")]
    {:format-string format-string
     :header (format format-string "#" "Workspace" "Status" "Tabs" "Panes")
     :rows (map #(assoc % :display
                        (format format-string
                                (:number %)
                                (:label %)
                                (:status %)
                                (:tabs %)
                                (:panes %)))
                rows)}))

(defn pick [rows header]
  (let [input (str/join "\n" (map #(str (:id %) "\t" (:display %)) rows))
        result (run! ["fzf"
                      "--border"
                      "--delimiter" "\t"
                      "--header" header
                      "--layout" "reverse"
                      "--no-multi"
                      "--no-sort"
                      "--prompt" "Workspace> "
                      "--with-nth" "2"]
                     {:in input :out :string :err :string})]
    (some-> (:out result)
            str/trim
            (str/split #"\t" 2)
            first)))

(defn remember! [workspace-id]
  (try
    (fs/create-dirs state-dir)
    (spit state-file workspace-id)
    (catch Exception error
      (eprintln "warning: could not save last workspace:" (.getMessage error)))))

(let [items (vec (workspaces))
      current-id (current-workspace-id items)
      preferred-id (preferred-workspace-id items current-id)
      rows (->> (prioritize items preferred-id)
                (map row-data)
                vec)]
  (when (seq rows)
    (let [{:keys [header rows]} (layout rows)
          selected-id (pick rows header)]
      (when (and selected-id
                 (not= selected-id current-id))
        (run! [herdr-bin "workspace" "focus" selected-id]
              {:out :string :err :string})
        ;; Store the workspace we just left, not the one we just selected.
        (when current-id
          (remember! current-id))))))
