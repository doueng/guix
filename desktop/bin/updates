#!/usr/bin/env bb
(ns updates
  (:require [babashka.classpath :as classpath]
            [babashka.fs :as fs]
            [babashka.http-client :as http]
            [babashka.process :as p]
            [cheshire.core :as json]
            [clojure.edn :as edn]
            [clojure.string :as str]))

(classpath/add-classpath (str (fs/path (fs/parent (fs/real-path *file*)) "../lib")))
(require '[builder])

(def repo (-> *file* fs/real-path fs/parent fs/parent fs/parent str))
(def home (System/getProperty "user.home"))
(def guix (str home "/.config/guix/current/bin/guix"))
(def cache-file (str (or (System/getenv "XDG_CACHE_HOME") (str home "/.cache"))
                     "/updates/latest.edn"))
(defn in-repo [path] (str repo "/" path))

(defn sh [& args]
  (let [[opts args] (if (map? (first args)) [(first args) (rest args)] [{} args])]
    (str/trim (:out (apply p/shell (assoc opts :out :string) args)))))
(defn run! [& args] (apply p/shell {:dir repo} args))
(defn http-json [url] (json/parse-string (:body (http/get url)) true))
(defn github [path] (json/parse-string (sh "gh" "api" path) true))
(defn head-commit [url ref] (first (str/split (sh "git" "ls-remote" url ref) #"\s")))
(defn compare-url [url from to]
  (let [base (str/replace url #"\.git$" "")]
    (if (str/includes? base "git.sr.ht")
      (str base "/log/" to)
      (str base "/compare/" from "..." to))))

(defn changelog [{:keys [compare current latest held] :as item}]
  (cond-> (if (and compare current latest) (compare-url compare current latest) (:changelog item))
    held (str " (held: " held ")")))

(def channels-file (or (System/getenv "UPDATES_CHANNELS") (in-repo "channels.scm")))

(defn channel-items []
  (for [[_ name url branch commit]
        (re-seq #"\(name '(\S+)\)\s*\(url \"([^\"]+)\"\)\s*\(branch \"([^\"]+)\"\)\s*\(commit \"([0-9a-f]+)\"\)"
                (slurp channels-file))]
    {:name name :url url :branch branch :current commit}))

(def channel-holds {})

(defn channel-refresh [items]
  (for [{:keys [name url branch] :as item} items
        :let [{:keys [commit reason]} (channel-holds name)
              latest (or commit (head-commit url (str "refs/heads/" branch)))]]
    (cond-> (assoc item :latest latest :compare url)
      reason (assoc :held reason))))

(defn bumped-channels [items]
  (reduce (fn [text {:keys [current latest]}] (str/replace text current latest))
          (slurp channels-file) items))

(defn channel-apply! [items]
  (spit channels-file (bumped-channels items)))

(def guix-versions-script
  "(use-modules (gnu packages) (guix packages) (ice-9 match) (ice-9 rdelim))
(call-with-input-file (cadr (command-line))
  (lambda (port)
    (let loop ()
      (match (read-line port)
        ((? eof-object?) #t)
        (name
         (match (find-packages-by-name name)
           ((package . _)
            (format #t \"~a\\t~a\\t~a~%\" name (package-version package)
                    (or (package-home-page package) \"\")))
           (() #t))
         (loop))))))")

(def custom-package-names
  (delay (set (for [file (fs/glob (in-repo "modules") "**.scm")
                    [_ name] (re-seq #"(?:\(name|#:name) \"([^\"]+)\"" (slurp (str file)))]
                name))))

(def installed
  (delay (->> [(str home "/.guix-home/profile") "/run/current-system/profile"]
              (mapcat #(str/split-lines (sh guix "package" "-p" % "-I")))
              (map #(let [[name version] (map str/trim (str/split % #"\t"))] {:name name :current version})))))

(defn guix-items []
  (->> @installed
       (remove #(@custom-package-names (:name %)))
       (group-by :name) vals (map first) (sort-by :name)))

(defn last-line [text]
  (last (remove str/blank? (str/split (str/trim (str text)) #"[\r\n]+"))))

(defn warn [& parts] (binding [*out* *err*] (println (apply str "updates: " parts))))

(def builder-publish builder/publish)

(def builder-up?
  (delay (zero? (:exit (p/shell {:continue true :out :string :err :string}
                                "curl" "-fsS" "--max-time" "10" (str builder-publish "/nix-cache-info"))))))

(defn builder-flags
  "Build options that keep builds off the laptop while the builder answers."
  []
  (if @builder-up?
    ["--max-jobs=0" (str "--substitute-urls=" builder-publish " https://bordeaux.guix.gnu.org")]
    (do (warn "builder unreachable at " builder-publish "; building on the laptop") [])))

(defn build-failure [message]
  (let [log (second (re-find #"View build log at '([^']+)'" message))
        lines (when log (try (str/split-lines (sh "zcat" log)) (catch Exception _ nil)))
        module (last (keep #(second (re-find #"^In ((?!ice-9/|unknown file|guix/|gnu/packages\.scm|srfi/)\S+):$" (str/trim %)))
                           lines))
        exception (last (filter #(str/starts-with? % "(exception ") lines))]
    (str/join "; " (remove nil? [(last-line message) (some->> module (str "in ")) exception
                                  (some->> log (str "build log: "))]))))

(defn guix-refresh [items]
  (let [channels (channel-refresh (channel-items))
        dir (fs/create-temp-dir)
        [script names bumped] (map #(str (fs/path dir %)) ["versions.scm" "names" "channels.scm"])
        versions (fn [& command]
                   (into {} (for [line (str/split-lines (apply sh {:err :string} command))
                                  :let [[name version home-page] (str/split line #"\t")]]
                              [name {:version version :home-page home-page}])))]
    (spit script guix-versions-script)
    (spit names (str/join "\n" (map :name items)))
    (spit bumped (bumped-channels channels))
    (binding [*out* *err*]
      (println "guix: evaluating the bumped channels; the first run per bump takes minutes"))
    (try
      (let [now (versions guix "repl" "--" script names)
            later (try (apply versions guix "time-machine" "-C" bumped
                                  (concat (builder-flags) ["--" "repl" "--" script names]))
                       (catch Exception e
                         (throw (ex-info (str "time-machine on the bumped channels failed: "
                                              (build-failure (ex-message e)))
                                         {}))))]
        (for [{:keys [name current] :as item} items
              :let [before (now name) after (later name)]]
          (assoc item
                 :latest (cond (and before (not after)) "removed"
                               (not= (:version before) (:version after)) (:version after)
                               :else current)
                 :changelog (:home-page after))))
      (finally (fs/delete-tree dir)))))

(declare read-cache with-latest outdated?)

(defn guix-apply! [_]
  (channel-apply! (filter outdated? (with-latest (read-cache) (map #(assoc % :source "channel")
                                                                    (channel-items))))))

(def github-repos {"tailscale" {:repo "tailscale/tailscale" :prefix "v"}})

(defn github-item [file]
  (let [text (slurp file)
        name (fs/strip-ext (fs/file-name file))
        [_ repo prefix] (re-find #"github\.com/([^/]+/[^/]+)/releases/download/([^\"]*)\"" text)
        [_ codeload] (re-find #"codeload\.github\.com/([^/]+/[^/]+)/" text)
        [commit-form commit] (re-find #"\(commit \"([0-9a-f]{40})\"\)" text)
        [version-form version] (or (re-find #"\(define \S+-version \"([^\"]+)\"\)" text)
                                   (re-find #"\(version \"([^\"]+)\"\)" text))
        base {:name name :file (str file)
              :package (second (re-find #"\(define-public (\S+)" text))
              :hash (second (or (re-find #"\(base32 \"([0-9a-z]+)\"\)" text)
                                (re-find #"#:hash \"([0-9a-z]+)\"" text)))}]
    (cond
      codeload (assoc base :repo codeload :current commit :form commit-form)
      repo (assoc base :repo repo :prefix prefix :current version :form version-form)
      (github-repos name) (merge base (github-repos name) {:current version :form version-form}))))

(defn github-items []
  (keep (comp github-item str) (sort (fs/glob (in-repo "modules/engstrand/packages") "*.scm"))))

(defn github-refresh [items]
  (pmap (fn [{:keys [repo prefix] :as item}]
          (if prefix
            (let [{:keys [tag_name html_url]} (github (str "repos/" repo "/releases/latest"))]
              (assoc item :latest (str/replace-first tag_name prefix "") :changelog html_url))
            (let [latest (:sha (github (str "repos/" repo "/commits/HEAD")))]
              (assoc item :latest latest :compare (str "https://github.com/" repo)))))
        items))

(defn source-uri [{:keys [name package]}]
  (let [script (str (fs/create-temp-file {:suffix ".scm"}))]
    (spit script (str "(use-modules (guix packages) (engstrand packages " name "))\n"
                      "(let ((uri (origin-uri (package-source " package "))))"
                      " (display (if (string? uri) uri (car uri))))"))
    (try (sh {:dir repo} guix "repl" "-L" "modules" "--" script)
         (finally (fs/delete script)))))

(defn github-apply! [items]
  (doseq [{:keys [file form current latest hash] :as item} items
          :let [text (slurp file)]]
    (spit file (str/replace text form (str/replace form current latest)))
    (try
      (let [new-hash (last (str/split-lines (sh guix "download" (source-uri item))))]
        (spit file (str/replace (slurp file) hash new-hash)))
      (catch Exception e
        (spit file text)
        (throw e)))))

(def upstream-file (in-repo "desktop/upstream.edn"))

(defn checkout [repo]
  (let [dir (str home "/.cache/checkouts/github.com/" repo)]
    (if (fs/exists? dir)
      (sh "git" "-C" dir "fetch" "-q" "origin")
      (sh "git" "clone" "-q" "--filter=blob:none" (str "https://github.com/" repo) dir))
    dir))

(defn upstream-items []
  (for [[dir {:keys [commit] :as entry}] (sort-by key (edn/read-string (slurp upstream-file)))]
    (merge {:name (fs/file-name dir)} entry {:dir dir :current commit})))

(defn upstream-refresh [items]
  (pmap (fn [{:keys [repo path current] :as item}]
          (let [git-dir (checkout repo)
                tree #(sh "git" "-C" git-dir "rev-parse" (str % ":" path))
                newest (sh "git" "-C" git-dir "log" "-1" "--format=%H" "origin/HEAD" "--" (or path "."))
                latest (if (= (tree current) (tree newest)) current newest)]
            (if path
              (assoc item :latest latest :changelog (str "https://github.com/" repo "/commits/" latest "/" path))
              (assoc item :latest latest :compare (str "https://github.com/" repo)))))
        items))

(defn merge-upstream!
  "Three-way merge the upstream changes from :current to :latest into the local
copy; return the files left with conflict markers."
  [{:keys [repo path dir current latest]}]
  (let [git-dir (checkout repo)
        local (in-repo (str "desktop/" dir))
        prefix (if path (str path "/") "")
        files (fn [commit]
                (set (for [file (str/split-lines (sh "git" "-C" git-dir "ls-tree" "-r" "--name-only"
                                                     commit "--" (or path ".")))
                           :when (seq file)]
                       (subs file (count prefix)))))
        tmp (fs/create-temp-dir)
        show (fn [commit file]
               (let [out (str (fs/path tmp (str (subs commit 0 12) "-" (str/replace file "/" "_"))))]
                 (p/shell {:out (fs/file out)} "git" "-C" git-dir "show" (str commit ":" prefix file))
                 out))
        base (files current)
        theirs (files latest)]
    (try
      (doall
       (for [file (sort (into base theirs))
             :let [mine (str (fs/path local file))
                   mine? (fs/exists? mine)]
             :when (cond
                     (not (theirs file))
                     (do (when (and mine? (= (slurp mine) (slurp (show current file))))
                           (fs/delete mine))
                         false)
                     (not mine?)
                     (do (when-not (base file)
                           (fs/create-dirs (fs/parent mine))
                           (fs/copy (show latest file) mine))
                         false)
                     :else
                     (let [ancestor (if (base file) (show current file) (str (fs/create-temp-file {:dir tmp})))]
                       (pos? (:exit (p/shell {:continue true} "git" "merge-file"
                                             "-L" "local" "-L" "base" "-L" "upstream"
                                             mine ancestor (show latest file))))))]
         (str "desktop/" dir "/" file)))
      (finally (fs/delete-tree tmp)))))

(defn upstream-apply! [items]
  (doseq [{:keys [name dir manual current latest changelog] :as item} items]
    (if manual
      (println (str "  " name " is updated by hand: review " changelog
                    ", then set its :commit in desktop/upstream.edn to " latest))
      (let [conflicts (merge-upstream! item)]
        (spit upstream-file
              (str/replace (slurp upstream-file)
                           (re-pattern (str "(\"" dir "\"\\s*\\{[^}]*:commit \")" current))
                           (str "$1" latest)))
        (doseq [file conflicts] (println (str "  conflict: " file)))))))

(def skills-lock (in-repo "skills-lock.json"))

(defn folder-hash
  "Hash DIR the way the skills CLI's computeSkillFolderHash does."
  [dir]
  (let [files (->> (file-seq (fs/file dir))
                   (filter #(.isFile %))
                   (map #(str (fs/relativize dir %)))
                   (remove #(re-find #"(^|/)(\.git|node_modules)/" %))
                   (sort-by (juxt str/lower-case identity)))
        digest (java.security.MessageDigest/getInstance "SHA-256")]
    (doseq [file files]
      (.update digest (.getBytes file "UTF-8"))
      (.update digest (fs/read-all-bytes (fs/path dir file))))
    (apply str (map #(format "%02x" %) (.digest digest)))))

(defn skills-items []
  (for [[skill {:keys [source sourceType skillPath computedHash]}]
        (sort-by key (:skills (json/parse-string (slurp skills-lock) true)))
        :when (= sourceType "github")]
    {:name (name skill) :repo source :path (str (fs/parent skillPath)) :current computedHash}))

(defn skills-refresh [items]
  (pmap (fn [{:keys [repo path] :as item}]
          (let [git-dir (checkout repo)
                tmp (fs/create-temp-dir)]
            (try
              (p/shell {:dir (str tmp)} "sh" "-c" "git -C \"$1\" archive origin/HEAD \"$2\" | tar x"
                       "sh" git-dir path)
              (assoc item :latest (folder-hash (str (fs/path tmp path)))
                     :changelog (str "https://github.com/" repo "/commits/HEAD/" path))
              (finally (fs/delete-tree tmp)))))
        items))

(defn skills-apply! [items]
  (apply run! "bun" "x" "skills" "update" "-p" "-y" (map :name items)))

(defn flatpak-items []
  (for [line (str/split-lines (sh "flatpak" "list" "--app" "--columns=application,version"))
        :let [[id version] (str/split line #"\t")]]
    {:name id :current version}))

(defn flatpak-refresh [items]
  (pmap (fn [{:keys [name] :as item}]
          (let [release (first (:releases (http-json (str "https://flathub.org/api/v2/appstream/" name))))]
            (assoc item :latest (:version release)
                   :changelog (or (:url release) (str "https://flathub.org/apps/" name)))))
        items))

(defn flatpak-apply! [items]
  (apply run! "flatpak" "update" "-y" (map :name items)))

(def doom-dir (str home "/.config/emacs"))

(defn doom-items []
  [{:name "doomemacs" :current (sh "git" "-C" doom-dir "rev-parse" "HEAD")}])

(defn doom-refresh [items]
  (for [item items
        :let [latest (head-commit (sh "git" "-C" doom-dir "remote" "get-url" "origin") "HEAD")]]
    (assoc item :latest latest :compare "https://github.com/doomemacs/doomemacs")))

;; doom upgrade needs HEAD on a branch, which colocated jj leaves detached.
(defn doom-attach! []
  (let [git #(apply p/shell {:dir doom-dir :continue true :out :string :err :string} "git" %&)]
    (when-not (zero? (:exit (git "symbolic-ref" "-q" "HEAD")))
      (let [branch (-> (:out (git "rev-parse" "--abbrev-ref" "origin/HEAD")) str/trim
                       (str/replace #"^origin/" ""))]
        (when-not (zero? (:exit (git "merge-base" "--is-ancestor" branch "HEAD")))
          (throw (ex-info (str "Doom's HEAD is detached and " branch " is not behind it; check out a branch in " doom-dir) {})))
        (println (str "  attaching Doom's detached HEAD to " branch))
        (sh {:dir doom-dir} "git" "checkout" "-q" "-B" branch)))))

;; --force answers doom upgrade's prompts but discards edits to tracked files, so refuse those first.
(defn doom-apply! [_]
  (when-let [dirty (not-empty (sh {:dir doom-dir} "git" "status" "--porcelain" "-uno"))]
    (throw (ex-info (str "Doom has local edits; commit or drop them first:\n" dirty) {})))
  (doom-attach!)
  (run! (str doom-dir "/bin/doom") "--force" "upgrade"))

(def lazy-lock (in-repo "desktop/configs/nvim/lazy-lock.json"))
(def lazy-dir (str home "/.local/share/nvim/lazy"))

(defn lazy-items []
  (for [[plugin {:keys [branch commit]}] (sort-by key (json/parse-string (slurp lazy-lock) true))
        :let [name (name plugin) dir (str lazy-dir "/" name)]
        :when (fs/exists? dir)]
    {:name name :branch branch :current (sh "git" "-C" dir "rev-parse" "HEAD") :locked commit
     :url (sh "git" "-C" dir "remote" "get-url" "origin")}))

(defn lock-drift
  "One line naming the plugins whose lazy-lock.json commit is not the
installed one, or nil."
  [items]
  (when-let [names (seq (keep #(when (and (:locked %) (not= (:locked %) (:current %))) (:name %)) items))]
    (str "lazy: lazy-lock.json pins other commits than installed for " (count names) " plugins ("
         (str/join ", " (take 5 names)) (when (> (count names) 5) ", ...")
         "); keep the installed ones with nvim --headless '+lua require(\"lazy.manage.lock\").update()' +qa"
         " or go back to the lock with nvim --headless '+Lazy! restore' +qa")))

(defn lazy-refresh [items]
  (let [out (str (fs/create-temp-file))
        check (str "lua require('lazy').check({ wait = true, show = false }) "
                   "local lines = {} "
                   "for _, p in pairs(require('lazy.core.config').plugins) do "
                   "if p._.updates then table.insert(lines, p.name .. '\\t' .. p._.updates.to.commit) end "
                   "end vim.fn.writefile(lines, '" out "')")
        _ (p/shell {:out :string :err :string} "nvim" "--headless" (str "+" check) "+qa")
        updates (into {} (keep #(let [[name commit] (str/split % #"\t")] (when commit [name commit]))
                               (str/split-lines (slurp out))))]
    (fs/delete out)
    (for [{:keys [name url current] :as item} items]
      (assoc item :latest (get updates name current) :compare url))))

(defn lazy-apply! [items]
  (run! "nvim" "--headless" (str "+Lazy! update " (str/join " " (map :name items))) "+qa"))

(def pi-settings (in-repo "desktop/pi/agent/settings.json"))

(defn pi-items []
  (for [source (:packages (json/parse-string (slurp pi-settings) true))
        :let [[_ name version] (re-find #"^npm:(.+)@([^@]+)$" source)]
        :when name]
    {:name name :current version}))

(defn pi-refresh [items]
  (pmap (fn [{:keys [name] :as item}]
          (let [{:keys [version repository]} (http-json (str "https://registry.npmjs.org/" name "/latest"))
                repo (some->> (:url repository) (re-find #"github\.com[/:]([^/]+/[^/.]+)") second)]
            (assoc item :latest version
                   :changelog (if repo
                                (str "https://github.com/" repo "/releases")
                                (str "https://www.npmjs.com/package/" name)))))
        items))

(defn pi-apply! [items]
  (doseq [{:keys [name latest]} items]
    (run! "pi" "install" (str "npm:" name "@" latest))))


(defn version-parts [v] (mapv #(or (parse-long %) %) (re-seq #"\d+|[a-z]+" (str/lower-case v))))

(defn version-compare [a b]
  (let [[pa pb] (map version-parts [a b])]
    (or (first (remove zero? (for [i (range (max (count pa) (count pb)))
                                   :let [x (get pa i 0) y (get pb i 0)]]
                               (if (and (number? x) (number? y)) (compare x y) (compare (str x) (str y))))))
        0)))

(defn tag-version [tag]
  (some-> (re-matches #"(?i)(?:v|version-|release-|[a-z0-9_]+-)?(\d+(?:[._]\d+)*)" (str tag))
          second (str/replace "_" ".")))

(defn upstream-release
  "The newest GitHub release of REPO, else its newest version tag.  :latest is
CURRENT unless upstream sorts newer, and nil when no tag reads as a version."
  [{:keys [repo current]}]
  (let [found? #(zero? (:exit %))
        release (p/shell {:continue true :out :string :err :string} "gh" "api" (str "repos/" repo "/releases/latest"))
        [version url] (if (found? release)
                        (let [{:keys [tag_name html_url]} (json/parse-string (:out release) true)]
                          [(tag-version tag_name) html_url])
                        (when-let [[version tag] (->> (github (str "repos/" repo "/tags?per_page=100"))
                                                      (keep #(some-> (tag-version (:name %)) (vector (:name %))))
                                                      (sort-by first version-compare) last)]
                          [version (str "https://github.com/" repo "/releases/tag/" tag)]))]
    {:latest (when version (if (pos? (version-compare version current)) version current))
     :changelog url}))

(declare latest-items latest-add! each-latest! failure)

(def repo-script
  "(use-modules (gnu packages) (guix packages) (guix diagnostics) (guix git-download) (ice-9 match)
             (ice-9 rdelim) (ice-9 regex) (srfi srfi-1) (srfi srfi-26))
(define (github-repo package)
  (let* ((source (package-source package))
         (uris (if (origin? source)
                   (match (origin-uri source)
                     ((? string? uri) (list uri))
                     ((? git-reference? ref) (list (git-reference-url ref)))
                     ((? list? uris) (filter string? uris))
                     (_ '()))
                   '()))
         (found (any (cut string-match \"github\\\\.com/([^/]+/[^/.]+)\" <>)
                     (append uris (list (or (package-home-page package) \"\"))))))
    (and found (match:substring found 1))))
(define (module-map-find package module)
  (false-if-exception
   (any (match-lambda ((name . var) (and (eq? (variable-ref var) package) name)))
        (module-map cons (resolve-interface module)))))
(call-with-input-file (cadr (command-line))
  (lambda (port)
    (let loop ()
      (match (read-line port)
        ((? eof-object?) #t)
        (name
         (match (find-packages-by-name name)
           ((package . _)
            (let* ((repo (github-repo package))
                   (file (location-file (package-location package)))
                   (module (map string->symbol (string-split (string-drop-right file 4) #\\/)))
                   (variable (or (module-map-find package module) '?)))
              (when repo (format #t \"~a\\t~a\\t~s\\t~a~%\" name repo module variable))))
           (() #t))
         (loop))))))")

(defn github-repos-of [names]
  (let [dir (fs/create-temp-dir)
        [script file] (map #(str (fs/path dir %)) ["repos.scm" "names"])]
    (spit script repo-script)
    (spit file (str/join "\n" names))
    (try (into {} (for [line (str/split-lines (sh {:err :string} guix "repl" "--" script file))
                        :let [[name repo module variable] (str/split line #"\t")]]
                    [name {:repo repo :module module :variable variable}]))
         (finally (fs/delete-tree dir)))))

(defn release-items []
  (let [cache (:latest (read-cache))
        channel-version (fn [source {:keys [name current]}]
                          (let [later (get-in cache [[source name] :latest])]
                            (if (and later (re-find #"^\d" later) (not (re-matches #"[0-9a-f]{40}" later)))
                              later
                              current)))
        guix (map #(assoc % :via "guix") (guix-items))
        opted (set (map :name (latest-items)))
        items (remove (comp opted :name) guix)
        repos (github-repos-of (map :name items))]
    (sort-by :name (for [{:keys [name via] :as item} items :when (repos name)]
                     (merge (repos name) {:name name :via via :current (channel-version via item)})))))

(defn release-refresh [items] (pmap #(merge % (upstream-release %)) items))

(defn release-apply! [items] (each-latest! #(latest-add! [%]) items))

(def latest-file (in-repo "modules/engstrand/packages/latest.scm"))
(def latest-re #"\(latest \"([^\"]+)\" \"([^\"]+)\" \"([0-9a-z]+)\" \"([^\"]+)\" (\([^)]+\)) (\S+)\)")
(def placeholder-hash (apply str (repeat 52 "0")))
(def latest-anchor "'(;; updates apply release/NAME adds lines here.")

(defn latest-items []
  (for [[form name version hash repo module variable] (re-seq latest-re (slurp latest-file))]
    {:name name :current version :hash hash :repo repo :module module :variable variable :form form}))

(defn latest-refresh [items] (pmap #(merge % (upstream-release %)) items))

(defn source-hash
  "Build NAME's opted-in source with a placeholder hash; the mismatch names the real one."
  [name]
  (let [{:keys [exit err]} (p/shell {:dir repo :continue true :out :string :err :string}
                                    guix "build" "-L" "modules" "--source" "-e"
                                    (str "(assoc-ref (@ (engstrand packages latest) %latest-packages) \"" name "\")"))]
    (or (second (re-find #"actual hash:\s+(\S+)" err))
        (throw (ex-info (str name " source: " (if (zero? exit) "the placeholder hash matched" (last-line err))) {})))))

(defn latest-bump! [{:keys [name form current latest]}]
  (let [text (slurp latest-file)
        pending (str/replace form (re-pattern (str "\"" (java.util.regex.Pattern/quote current) "\" \"[0-9a-z]+\""))
                             (str "\"" latest "\" \"" placeholder-hash "\""))]
    (spit latest-file (str/replace text form pending))
    (try (let [hash (source-hash name)]
           (spit latest-file (str/replace text form (str/replace pending placeholder-hash hash))))
         (catch Exception e (spit latest-file text) (throw e)))))

(defn latest-build!
  "Build NAME's opted-in release alone, on the builder while it answers."
  [name]
  (println (str "  building " name " on the builder..."))
  (let [{:keys [exit err]} (apply p/shell {:dir repo :continue true :out :string :err :string}
                                  guix "build" "-L" "modules"
                                  (concat (builder-flags)
                                          ["-e" (str "(assoc-ref (@ (engstrand packages latest) %latest-packages) \"" name "\")")]))]
    (when-not (zero? exit)
      (throw (ex-info (str name " does not build: " (build-failure err)) {})))))

(defn each-latest!
  "Run (F ITEM) for every item and build it; restore latest.scm for an item
that fails and go on, then throw naming the failures."
  [f items]
  (let [failed (doall (for [{:keys [name] :as item} items
                            :let [text (slurp latest-file)
                                  error (try (f item) (latest-build! name) nil
                                             (catch Exception e
                                               (spit latest-file text)
                                               (failure e)))]
                            :when error]
                        (do (warn name ": " error "; left as it was") name)))]
    (when (seq failed)
      (throw (ex-info (str "not updated: " (str/join ", " failed))
                      {:partial (< (count failed) (count items))})))))

(defn latest-apply! [items] (each-latest! latest-bump! items))

(def hand-packages
  {"ghostty" {:repo "ghostty-org/ghostty" :file "modules/engstrand/packages/ghostty.scm"}})

(defn hand-version
  "The version of the package TEXT's (define-public NAME ...) form declares."
  [text name]
  (some->> (str/index-of text (str "(define-public " name "\n"))
           (subs text)
           (re-find #"\(version \"([^\"]+)\"\)")
           second))

(defn hand-items []
  (for [[name {:keys [file] :as entry}] (sort-by key hand-packages)]
    (merge {:name name :current (hand-version (slurp (in-repo file)) name)} entry)))

(defn hand-refresh [items] (pmap #(merge % (upstream-release %)) items))

(defn hand-apply! [items]
  (doseq [{:keys [name file latest changelog]} items]
    (println (str "  " name " is updated by hand: read " changelog ", then bump it to " latest
                  " in " file " as its header comment says"))))

(defn latest-add! [items]
  (doseq [{:keys [name current latest repo module variable]} items
          :let [form (str "(latest \"" name "\" \"" current "\" \"" placeholder-hash "\" \"" repo "\" "
                          module " " variable ")")
                text (slurp latest-file)]]
    (when (= variable "?")
      (throw (ex-info (str name " has no public variable in " module "; write a variant by hand") {})))
    (when (some #(= name (:name %)) (latest-items))
      (throw (ex-info (str name " is already in " latest-file "; updates apply latest/" name " bumps it") {})))
    (spit latest-file (str/replace-first text latest-anchor (str latest-anchor "\n    " form)))
    (try (latest-bump! {:name name :form form :current current :latest latest})
         (catch Exception e (spit latest-file text) (throw e)))))

(def rebuild-steps ["make prebuild" "make pull" "make home" "make switch" "make test ONLY=doom"])

(def sources
  {"channel" {:items channel-items :refresh channel-refresh :apply! channel-apply!
              :then #{"make prebuild" "make pull" "make home" "make switch"}}
   "guix" {:items guix-items :refresh guix-refresh :apply! guix-apply!
           :then #{"make prebuild" "make pull" "make home" "make switch"}}
   "github" {:items github-items :refresh github-refresh :apply! github-apply!
             :then #{"make prebuild" "make home" "make switch"}}
   "upstream" {:items upstream-items :refresh upstream-refresh :apply! upstream-apply!
               :then #{"make prebuild" "make home"}}
   "skills" {:items skills-items :refresh skills-refresh :apply! skills-apply!}
   "flatpak" {:items flatpak-items :refresh flatpak-refresh :apply! flatpak-apply!}
   "doom" {:items doom-items :refresh doom-refresh :apply! doom-apply! :then #{"make test ONLY=doom"}}
   "lazy" {:items lazy-items :refresh lazy-refresh :apply! lazy-apply!}
   "pi" {:items pi-items :refresh pi-refresh :apply! pi-apply!}
   "release" {:items release-items :refresh release-refresh :apply! release-apply! :opt-in? true
               :then #{"make prebuild" "make home" "make switch"}}
   "latest" {:items latest-items :refresh latest-refresh :apply! latest-apply!
              :then #{"make prebuild" "make home" "make switch"}}
   "hand" {:items hand-items :refresh hand-refresh :apply! hand-apply!}})

(def source-order ["channel" "guix" "github" "latest" "hand" "release" "upstream" "skills"
                   "flatpak" "doom" "lazy" "pi"])

(defn selected? [selectors {:keys [source name]}]
  (or (empty? selectors)
      (some #{source (str source "/" name)} selectors)))

(defn inventory [selectors]
  (let [wanted? (fn [source]
                  (or (empty? selectors)
                      (some #(or (= source %) (str/starts-with? % (str source "/"))) selectors)))]
    (->> (filter wanted? source-order)
         (pmap (fn [source]
                 (try (map #(assoc % :source source) ((get-in sources [source :items])))
                      (catch Exception e [{:source source :name "?" :error (ex-message e)}]))))
         (apply concat)
         (filter #(selected? selectors %)))))

(defn read-cache []
  (if (fs/exists? cache-file) (edn/read-string (slurp cache-file)) {:latest {}}))

(defn with-latest [cache items]
  (for [{:keys [source name] :as item} items
        :let [item (merge item (dissoc (get-in cache [:latest [source name]]) :current))]]
    (cond-> item (changelog item) (assoc :changelog (changelog item)))))

(def max-age-hours (or (some-> (System/getenv "UPDATES_MAX_AGE_HOURS") parse-double) 24.0))

(defn cached-at
  "When SOURCE was last refreshed in CACHE, as an Instant string, or nil."
  [cache source]
  (or (get-in cache [:refreshed source]) (:refreshed-at cache)))

(defn hours-between [from to]
  (/ (.toMinutes (java.time.Duration/between (java.time.Instant/parse from) to)) 60.0))

(defn age
  "How long ago FROM was at the Instant NOW, as 3d 4h, 5h 12m or 7m."
  [from now]
  (let [m (max 0 (.toMinutes (java.time.Duration/between (java.time.Instant/parse from) now)))
        [d h mm] [(quot m 1440) (quot (mod m 1440) 60) (mod m 60)]]
    (cond (pos? d) (str d "d " h "h") (pos? h) (str h "h " mm "m") (pos? mm) (str mm "m") :else "<1m")))

(defn stale-sources
  "A map of each source among ITEMS whose cached latest versions need a
refresh at the Instant NOW to why."
  [cache items now]
  (into (sorted-map)
        (for [[source group] (group-by :source (remove :error items))
              :let [at (cached-at cache source)
                    entries (map #(get-in cache [:latest [source (:name %)]]) group)
                    why (cond (nil? at) "never refreshed"
                              (> (hours-between at now) max-age-hours) (str "cached " (age at now) " ago")
                              (some nil? entries) "new items"
                              (some :error entries) "failed last time"
                              (some #(not (contains? % :current)) entries) "cached by an older updates"
                              (some (fn [[item e]] (not= (:current item) (:current e))) (map vector group entries))
                              "pins changed")]
              :when why]
          [source why])))

(defn refresh!
  "Look up the latest versions of ITEMS' sources and cache them; return ITEMS
with them."
  [items]
  (let [fresh (apply concat
                     (pmap (fn [[source group]]
                             (try (doall ((get-in sources [source :refresh]) group))
                                  (catch Exception e
                                    (let [error (last-line (ex-message e))]
                                      (warn source " refresh failed: " error)
                                      (map #(assoc % :error error) group)))))
                           (group-by :source (remove :error items))))
        now (str (java.time.Instant/now))
        cache (read-cache)]
    (fs/create-dirs (fs/parent cache-file))
    (spit cache-file
          (pr-str (-> cache
                      (update :refreshed merge (zipmap (distinct (map :source fresh)) (repeat now)))
                      (update :latest into
                              (for [{:keys [source name] :as item} fresh]
                                [[source name] (select-keys item [:latest :changelog :compare :held :error :current])])))))
    (with-latest (read-cache) items)))

(defn latest!
  "ITEMS with their latest versions, refreshing the sources MODE asks for:
:all, :none, or :stale, those stale-sources names.  Prints which, and how
old the rest of the cache is, in one line."
  [items mode]
  (let [now (java.time.Instant/now)
        cache (read-cache)
        stale (case mode
                :all (zipmap (distinct (map :source items)) (repeat "--refresh"))
                :none {}
                :stale (stale-sources cache items now))
        kept (remove (set (keys stale)) (distinct (map :source (remove :error items))))
        oldest (first (sort (keep #(cached-at cache %) kept)))]
    (when (seq stale)
      (warn "refreshing " (str/join ", " (for [[s why] stale] (str s " (" why ")"))) "..."))
    (println (str (cond (empty? stale) "Latest versions cached"
                        (empty? kept) "Latest versions refreshed just now"
                        :else (str "Refreshed " (str/join ", " (keys stale)) "; the rest cached"))
                  (when (and (seq kept) oldest) (str " " (age oldest now) " ago"))
                  (when (and (seq kept) (nil? oldest)) ", never refreshed")
                  (when (seq kept) " (updates --refresh looks again)")
                  "."))
    (when (seq stale) (refresh! (filter #(stale (:source %)) items)))
    (with-latest (read-cache) items)))

(defn outdated? [{:keys [current latest]}] (and latest (not= current latest)))

(defn short [v] (if (and v (re-matches #"[0-9a-f]{40,64}" v)) (subs v 0 12) (or v "")))

(defn table-rows
  "The rows of print-table: SOURCE NAME CURRENT LATEST CHANGELOG."
  [items]
  (for [{:keys [source name current latest changelog error] :as item} items]
    [source name (str (some-> (:via item) (str " ")) (short current))
     (cond error "error" (nil? latest) "?" (outdated? item) (short latest) :else "=")
     (or error (when (outdated? item) changelog) "")]))

(defn print-table [items]
  (let [rows (table-rows items)
        widths (apply map (fn [& cells] (apply max (map count cells)))
                      ["SOURCE" "NAME" "CURRENT" "LATEST" ""] rows)]
    (doseq [row (cons ["SOURCE" "NAME" "CURRENT" "LATEST" "CHANGELOG"] rows)]
      (println (str/trimr (str/join "  " (map #(format (str "%-" (max 1 %1) "s") %2) widths row)))))))

(defn print-status [items]
  (let [shown (filter #(and (outdated? %) (not (:error %))) items)]
    (when (seq shown) (print-table shown))
    (some-> (lock-drift (filter #(= "lazy" (:source %)) items)) println)
    (doseq [[[source error] group] (group-by (juxt :source :error) (filter :error items))]
      (println (str "ERROR " source " (" (count group) " items): " error)))
    (println (str (count (filter outdated? items)) " of " (count items) " have updates; "
                  (count (remove :latest items)) " unknown"
                  (when-let [errors (seq (filter :error items))] (str ", " (count errors) " failed"))
                  "."
                  (when (seq shown) " Apply with: updates apply [SOURCE[/NAME] ...]")))
    (some :error items)))

(defn revision []
  (let [jj #(apply p/shell {:dir repo :out :string :err :string :continue true} "jj" "--ignore-working-copy" %&)
        {:keys [exit out]} (jj "log" "--no-graph" "-r" "latest(::@ & files(root:\"desktop/bin/updates\"))"
                               "-T" "change_id.short(8) ++ \" \" ++ committer.timestamp().format(\"%Y-%m-%d\")")
        committed (:out (jj "file" "show" "-r" "@" "root:desktop/bin/updates"))]
    (str "updates " (if (and (zero? exit) (seq (str/trim out))) (str/trim out) "(no jj revision)")
         (when (and (zero? exit) (not= committed (slurp (in-repo "desktop/bin/updates")))) " + local edits")
         " in " repo)))

(defn failure [e]
  (let [{:keys [cmd exit]} (ex-data e)]
    (if (and cmd exit)
      (str (str/join " " cmd) " exited " exit)
      (or (last-line (ex-message e)) (str e)))))

(defn prebuild! []
  (if-not @builder-up?
    (do (warn "prebuild skipped: builder unreachable at " builder-publish
              "; the steps below build on the laptop with JOBS=1")
        :skipped)
    (do (println "Building the new tree on the builder (make prebuild)...")
        (try (run! "make" "prebuild")
             (println "Checking that the laptop only downloads (make builder)...")
             (try (run! "make" "builder") :ok
                  (catch Exception e
                    (warn "make builder failed: " (failure e)
                          "; the laptop would build what is listed above, so don't pull or switch yet")
                    :failed))
             (catch Exception e
               (warn "prebuild failed: " (failure e) "; the new versions don't build, so don't pull or switch yet")
               :failed)))))

(defn prebuild-status! []
  (let [{:keys [exit out err]} (p/shell {:continue true :out :string :err :string}
                                        (in-repo "desktop/bin/builder-prebuild") "alert")]
    (println (or (last-line out) (str "builder prebuild: status unknown: " (last-line err))))
    (= 1 exit)))

(defn apply! [selectors mode]
  (let [named? (fn [{:keys [source name]}] (some #{(str source "/" name)} selectors))
        items (->> (latest! (inventory selectors) mode)
                   (filter outdated?)
                   (filter #(or (named? %) (not (get-in sources [(:source %) :opt-in?])))))
        groups (group-by :source items)]
    (if (empty? items)
      (println "Nothing to update.")
      (let [failed (doall
                    (for [source source-order :let [group (groups source)] :when group
                          :let [_ (println (str "Updating " source ": " (str/join ", " (map :name group))))
                                [error partial] (try ((get-in sources [source :apply!]) group) nil
                                                     (catch Exception e [(failure e) (:partial (ex-data e))]))]
                          :when error]
                      (do (binding [*out* *err*]
                            (println (str "updates: " source " apply failed: " error)))
                          {:source source :partial partial})))
            steps (set (mapcat #(get-in sources [% :then])
                               (remove (set (map :source (remove :partial failed))) (keys groups))))
            prebuild (when (steps "make prebuild") (prebuild!))]
        (when (seq steps)
          (println "Review the repository diff with jj diff, then run:")
          (doseq [step rebuild-steps :when (and (steps step) (not= step "make prebuild"))]
            (println (str "  " step (when (and (= prebuild :skipped) (#{"make pull" "make home" "make switch"} step))
                                      " JOBS=1")))))
        (seq (cond-> (map :source failed) (= prebuild :failed) (conj "prebuild")))))))

(defn usage []
  (println "usage: updates [status|list|refresh|apply] [--refresh|--cached] [SOURCE[/NAME] ...]")
  (println (str "sources: " (str/join " " source-order)))
  (println (str "The cache refreshes a source by itself when older than " max-age-hours
                " h (UPDATES_MAX_AGE_HOURS) or after a pin changed; --refresh (or refresh) forces it, --cached skips it."))
  (System/exit 1))

(defn -main [args]
  (let [flags (set (filter #(str/starts-with? % "-") args))
        [command & selectors] (remove flags args)
        command (or command "status")
        mode (cond (or (flags "--refresh") (= command "refresh")) :all (flags "--cached") :none :else :stale)]
    (when (or (seq (remove #{"--refresh" "--cached"} flags)) (not (#{"status" "list" "refresh" "apply"} command)))
      (usage))
    (println (revision))
    (case command
      ("status" "refresh") (let [errors (print-status (latest! (inventory selectors) mode))
                                  alert (prebuild-status!)]
                              (when (or errors alert) (System/exit 1)))
      "list" (print-table (latest! (inventory selectors) mode))
      "apply" (when (apply! selectors mode) (System/exit 1)))))

(when (= *file* (System/getProperty "babashka.file"))
  (-main *command-line-args*))
