#!/usr/bin/env bb

(require '[babashka.classpath :as classpath]
         '[babashka.fs :as fs])
(classpath/add-classpath (str (fs/path (fs/parent (fs/real-path *file*)) "../lib")))

(require '[babashka.process :as p]
         '[cheshire.core :as json]
         '[herdr.client :as herdr]
         '[hypr.dispatch :as hypr]
         '[mux])

;; The multiplexer's window: Herdr's Ghostty, rexmux or ghostty-rex
;; (~/.config/engstrand/mux).
(def backend (mux/backend))
(def mux-class (mux/window-class backend))

(defn hyprctl [& args]
  (let [result @(p/process (into ["hyprctl"] args)
                           {:out :string :err :string})]
    (if (zero? (:exit result))
      (json/parse-string (:out result) true)
      (throw (ex-info "hyprctl failed" {:args args :result result})))))

(defn focus-tab! [tab]
  (case backend
    :herdr (herdr/focus-tab! tab)
    ;; rexmux and ghostty-rex declare mx.tab.select_N and perform it for rex do.
    (let [{:keys [exit err]} @(p/process ["rex" "-C" (mux/rex-client backend) "do" (str "mx.tab.select_" tab)]
                                         {:out :string :err :string})]
      (when-not (zero? exit)
        (throw (ex-info (str "rex do mx.tab.select_" tab ": " err) {}))))))

(defn main [& args]
  (if-let [tab (and (= 1 (count args))
                    (some-> (parse-long (first args)) #{1 2 3 4 5 6 7 8 9}))]
    (let [target (some #(when (= mux-class (:class %)) (:address %))
                       (hyprctl "clients" "-j"))
          active (:address (hyprctl "activewindow" "-j"))]
      (cond
        (nil? target)
        (hypr/dispatch! ["exec_cmd" "~/.local/bin/mux-terminal"])

        (= active target)
        (focus-tab! tab)

        :else
        (hypr/dispatch! ["focus" {:window (str "address:" target)}]))
      0)
    (do
      (herdr/eprintln "Usage: workspace-or-herdr-tab <1..9>")
      2)))

(System/exit (apply main *command-line-args*))
