#!/usr/bin/env bb

(require '[babashka.classpath :as classpath]
         '[babashka.fs :as fs])
;; Scripts are stowed as symlinks; load the client from the repository.
(classpath/add-classpath (str (fs/path (fs/parent (fs/real-path *file*)) "../lib")))

(require '[babashka.process :as p]
         '[cheshire.core :as json]
         '[clojure.string :as str]
         '[herdr.client :as herdr])

(def workspace 1)

(defn hyprctl [& args]
  (let [result @(p/process (into ["hyprctl"] args)
                           {:out :string :err :string})]
    (if (zero? (:exit result))
      (json/parse-string (:out result) true)
      (throw (ex-info "hyprctl failed" {:args args :result result})))))

(defn ghostty? [window]
  (some #(str/includes? (str/lower-case (str (get window % ""))) "ghostty")
        [:class :initialClass :title]))

(defn main [& args]
  (if-let [tab (and (= 1 (count args))
                    (some-> (parse-long (first args)) #{1 2 3 4 5 6 7 8 9}))]
    (let [target (some (fn [window]
                         (let [window-workspace (:workspace window)]
                           (when (and (= workspace (:id window-workspace))
                                      (ghostty? window))
                             (:address window))))
                       (hyprctl "clients" "-j"))
          active (:address (hyprctl "activewindow" "-j"))]
      (cond
        (nil? target)
        (p/shell "hyprctl" "dispatch" "workspace" (str workspace))

        (= active target)
        (herdr/focus-tab! tab)

        :else
        (p/shell "hyprctl" "dispatch" "focuswindow" (str "address:" target)))
      0)
    (do
      (herdr/eprintln "Usage: workspace-or-herdr-tab <1..9>")
      2)))

(System/exit (apply main *command-line-args*))
