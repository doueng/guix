#!/usr/bin/env python3
"""Focus the workspace Ghostty window or select its requested Herdr tab."""

import json
import os
import subprocess
import sys


WORKSPACE = 1


def hyprctl(*args):
    result = subprocess.run(["hyprctl", *args], check=True,
                            capture_output=True, text=True)
    return json.loads(result.stdout)


def is_ghostty(window):
    return any("ghostty" in str(window.get(field, "")).lower()
               for field in ("class", "initialClass", "title"))


def main():
    if len(sys.argv) != 2:
        print(f"Usage: {os.path.basename(sys.argv[0])} <herdr-tab>",
              file=sys.stderr)
        return 2

    tab = sys.argv[1]
    target = None
    for window in hyprctl("clients", "-j"):
        workspace = window.get("workspace", {})
        if workspace.get("id") == WORKSPACE and is_ghostty(window):
            target = window.get("address")

    active = hyprctl("activewindow", "-j").get("address")
    if not target:
        subprocess.run(["hyprctl", "dispatch", "workspace", str(WORKSPACE)],
                       check=True)
    elif active == target:
        subprocess.run([os.path.expanduser("~/.local/bin/herdr-tab-focus"),
                        tab], check=True)
    else:
        subprocess.run(["hyprctl", "dispatch", "focuswindow",
                        f"address:{target}"], check=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
