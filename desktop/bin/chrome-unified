#!/usr/bin/env bb

(require '[babashka.fs :as fs]
         '[babashka.process :as p])

(def home (System/getProperty "user.home"))
(def flatpak-app "com.google.Chrome")
(def extension-path (str home "/.var/app/" flatpak-app
                         "/config/chromium/extensions/old-reddit-redirect"))
(def chrome-flags
  ["--ozone-platform=wayland"
   "--high-dpi-support=1"
   "--force-device-scale-factor=1.6"
   "--enable-font-antialiasing"
   "--enable-lcd-text"])

(defn show-help []
  (println "Chrome Unified Launcher")
  (println "Usage:")
  (println "  chrome-unified                    - Launch regular Chromium (Flatpak)")
  (println "  chrome-unified --incognito        - Launch incognito mode")
  (println "  chrome-unified --help             - Show this help")
  (println "  chrome-unified [other-flags]      - Launch with custom flags")
  (println)
  (println "Also loads ~/.var/app/com.google.Chrome/config/chromium/extensions/old-reddit-redirect when present."))

(defn main [& args]
  (if (and (seq args) (#{"--help" "-h"} (first args)))
    (show-help)
    (let [incognito? (= "--incognito" (first args))
          mode (if incognito? ["--incognito"] [])
          rest-args (if incognito? (next args) args)
          extension (if (fs/directory? extension-path)
                      [(str "--load-extension=" extension-path)]
                      [])
          command (into ["flatpak" "run" flatpak-app]
                        (concat chrome-flags extension mode rest-args))
          _ (p/exec command)]
      nil)))

(apply main *command-line-args*)
