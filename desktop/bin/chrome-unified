#!/usr/bin/env python3
"""Launch Chromium from Flathub with shared Wayland flags; no Flatpak-free fallback."""

import os
import sys

HOME = os.path.expanduser("~")
EXTENSION_PATH = HOME + "/.config/chromium/extensions/old-reddit-redirect"

CHROME_FLAGS = [
    "--ozone-platform=wayland",
    "--high-dpi-support=1",
    "--force-device-scale-factor=1.6",
    "--enable-font-antialiasing",
    "--enable-lcd-text",
]


def show_help():
    print("Chrome Unified Launcher")
    print("Usage:")
    print("  chrome-unified                    - Launch regular Chromium (Flatpak)")
    print("  chrome-unified --incognito        - Launch incognito mode")
    print("  chrome-unified --help             - Show this help")
    print("  chrome-unified [other-flags]      - Launch with custom flags")
    print("")
    print("Also loads ~/.config/chromium/extensions/old-reddit-redirect when present.")


def main():
    args = sys.argv[1:]
    if args and args[0] in ("--help", "-h"):
        show_help()
        return 0
    mode = ["--incognito"] if args and args[0] == "--incognito" else []
    rest = args[1:] if mode else args
    extension = ["--load-extension=" + EXTENSION_PATH] if os.path.isdir(EXTENSION_PATH) else []
    os.execvp("flatpak", ["flatpak", "run", "org.chromium.Chromium"]
              + CHROME_FLAGS + extension + mode + rest)


if __name__ == "__main__":
    sys.exit(main())
