#!/usr/bin/env bb
(ns keyguide
  (:require [babashka.classpath :as classpath]
            [babashka.fs :as fs]
            [babashka.process :as p]
            [clojure.edn :as edn]
            [clojure.string :as str]))

;; Scripts are stowed as symlinks; load shared code from the repository.
(classpath/add-classpath (str (fs/path (fs/parent (fs/real-path *file*)) "../lib")))
(require '[hypr.dispatch :as hypr]
         '[keylog])

(defn groups [config]
  (mapv (fn [group]
          (if (:workspace-digits group)
            (assoc group :entries
                   (vec (for [move? [false true] digit (range 10)
                              :let [ws (if (zero? digit) 10 digit)]]
                          {:id (str (when move? "m") digit)
                           :label (str (if move? "Move to workspace " "Workspace ") ws)
                           :hypr [(if move? "CTRL ALT SHIFT" "CTRL ALT")
                                  (str digit)
                                  (if move? ["window.move" {:workspace ws}] ["focus" {:workspace ws}])]})))
            group))
        (:groups config)))

(defn validate! [gs]
  (doseq [items (cons gs (map :entries gs))]
    (when-not (= (count items) (count (distinct (map :id items))))
      (throw (ex-info "Duplicate guide key" {:items items}))))
  (doseq [entry (mapcat :entries gs)]
    (when-not (= 1 (count (filter entry [:hypr :dispatch :command :tip])))
      (throw (ex-info "Each entry needs exactly one action" {:entry entry})))
    (when-let [[mods key d :as binding] (:hypr entry)]
      (when-not (and (= 3 (count binding))
                     (string? mods) (re-matches #"[A-Z ]*" mods)
                     (string? key) (re-matches #"[A-Za-z0-9]+" key)
                     (hypr/valid? d))
        (throw (ex-info "Invalid Hyprland binding" {:binding binding}))))
    (when-let [d (:dispatch entry)]
      (when-not (hypr/valid? d)
        (throw (ex-info "Invalid Hyprland dispatcher" {:dispatch d})))))
  (let [chords (keep #(some-> (:hypr %) (subvec 0 2)) (mapcat :entries gs))]
    (when-not (= (count chords) (count (distinct chords)))
      (throw (ex-info "Duplicate desktop shortcut" {}))))
  gs)

(defn shortcut [entry]
  (or (:chord entry)
      (when-let [[mods key] (:hypr entry)]
        (str (str/replace mods " " "+") "+" key))))

(defn line [entry]
  (str (:id entry) "  " (:label entry)
       (when-let [chord (shortcut entry)] (str "   [" chord "]"))
       (when (:tip entry) "   (guide)")))

(defn lua-chord [mods key]
  (str/join " + " (concat (remove str/blank? (str/split mods #" ")) [key])))

(defn hypr-config
  "keybindings.lua for the desktop bindings in the registry."
  [gs]
  (str "-- Generated by keyguide --hypr. Edit keybindings/bindings.edn.\n"
       "local keys = require(\"keys\")\n"
       (apply str (for [entry (mapcat :entries gs) :when (:hypr entry)
                        :let [[mods key d] (:hypr entry)]]
                    (str "keys.bind(" (hypr/lua-value (lua-chord mods key)) ", " (hypr/lua d) ", "
                         (hypr/lua-value (shortcut entry)) ", " (hypr/lua-value (:label entry)) ")\n")))))

(defn argv [entry]
  (cond
    (:command entry) (mapv #(str/replace % #"^~/" (str (fs/home) "/")) (:command entry))
    (:tip entry) ["notify-send" "-a" "Keyguide" "-t" "12000" (:label entry) (:tip entry)]))

(defn dispatcher [entry]
  (or (some-> (:hypr entry) (nth 2)) (:dispatch entry)))

(defn config-path []
  (or (System/getenv "KEYGUIDE_CONFIG")
      (str (or (System/getenv "XDG_CONFIG_HOME") (str (fs/home) "/.config"))
           "/keybindings/bindings.edn")))

(defn execute! [argv]
  (let [result @(p/process argv {:inherit true})]
    (when-not (zero? (:exit result))
      (throw (ex-info (str "Action failed: " (str/join " " argv)) {:exit (:exit result)})))))

(defn run-entry!
  "Run ENTRY. Every menu that runs guide entries goes through here."
  [entry]
  (if-let [d (dispatcher entry)]
    (hypr/dispatch! d)
    (execute! (argv entry))))

(defn choose [prompt items]
  (let [{:keys [exit out err]}
        @(p/process [(str (fs/home) "/.local/bin/dusk") "dmenu" "-p" prompt]
                    {:in (str (str/join "\n" (map line items)) "\n")
                     :out :string :err :string})]
    (cond
      (zero? exit) (some #(when (= (line %) (str/trim-newline out)) %) items)
      (and (= 1 exit) (str/blank? err)) nil
      :else (throw (ex-info "Dusk menu failed" {:exit exit :error err})))))

(defn browse! [gs start]
  (loop [group (some #(when (= start (:id %)) %) gs)]
    (let [choice (if group
                   (choose (str (:label group) " | Esc closes") (cons {:id ".." :label "Back"} (:entries group)))
                   (choose "Keyguide | type a group, Enter | Esc closes" gs))]
      (cond
        (nil? choice) (keylog/log! "cancel" "keyguide" "Cmd+/" "Closed the guide")
        (not group) (recur choice)
        (= ".." (:id choice)) (recur nil)
        :else (do (run-entry! choice)
                  (keylog/log! "action" "keyguide" "Cmd+/" (:label choice)))))))

(defn main [args]
  (let [gs (validate! (groups (edn/read-string (slurp (config-path)))))]
    (case (first args)
      "--hypr" (print (hypr-config gs))
      "--list" (doseq [group gs entry (:entries group)]
                 (println (str (:label group) "\t" (line entry))))
      "--check" (println "Keyguide registry is valid")
      (do
        (when (and (seq args) (not-any? #(= (first args) (:id %)) gs))
          (throw (ex-info "Unknown guide group" {:group (first args)})))
        (browse! gs (first args))))))

(when (= *file* (System/getProperty "babashka.file"))
  (main *command-line-args*))
