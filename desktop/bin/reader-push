#!/usr/bin/env bb
(ns reader-push
  (:require [babashka.classpath :as classpath]
            [babashka.fs :as fs]
            [babashka.process :as p]
            [cheshire.core :as json]
            [clojure.string :as str]))

(classpath/add-classpath (str (fs/path (fs/parent (fs/real-path *file*)) "../lib")))
(require '[builder])

(def host builder/host)
(def home (System/getProperty "user.home"))
(def src (or (System/getenv "READER_DIR") (str home "/projects/langchain/reader")))
(def ssh (builder/ssh builder/deploy-key "root"))
(def lib "/var/lib/reader")
(def jev-key (str home "/.env/jev"))

(defn die [& msg] (binding [*out* *err*] (apply println msg)) (System/exit 1))
(defn stamp [] (.format (java.text.SimpleDateFormat. "yyyyMMdd-HHmmss") (java.util.Date.)))

(defn remote
  "Run the shell SCRIPT on the builder as root, with IN on its stdin."
  ([script] (remote script nil))
  ([script in]
   (let [r @(apply p/process (cond-> {:out :inherit :err :inherit} in (assoc :in in))
                       (conj ssh script))]
     (when-not (zero? (:exit r)) (die "reader-push: failed on the builder:" script)))))

(defn tar-to-builder
  "Stream DIR's entries, minus EXCLUDES, into the builder's SCRIPT."
  [dir excludes script]
  (let [tar (apply p/process {:dir dir :err :inherit}
                   "tar" "-c" (concat (map #(str "--exclude=" %) excludes) ["."]))]
    (remote script (:out tar))
    (when-not (zero? (:exit @tar)) (die "reader-push: tar failed in" dir))))

(def code-excludes
  ["./.jj" "./.git" "./.cpcache" "./target" "./.wrangler" "./node_modules/.cache"
   "./suggester/.venv" "./suggester/.guix-profile" "./.pytest_cache"
   "./suggester/.pytest_cache" "__pycache__"])

(defn code []
  (when-not (fs/exists? (str src "/public/js/main.js"))
    (die "reader-push: no public/js/main.js; run `npm run build' in" src))
  (tar-to-builder src code-excludes
                  (str "set -e; cd " lib "; rm -rf app.new app.old; mkdir app.new; "
                       "tar -x --no-same-owner -C app.new; chown -R reader:reader app.new; "
                       "mv app app.old; mv app.new app; rm -rf app.old"))
  (if (fs/exists? jev-key)
    (remote (str "set -e; umask 077; cat > " lib "/jev-key; chown reader:reader " lib "/jev-key")
            (slurp jev-key))
    (println "reader-push: no" jev-key "; the Find button will fail without TYPESAFE_API_KEY"))
  (remote "herd enable reader && herd enable reader-suggester && herd restart reader && herd restart reader-suggester")
  (println "Pushed" src "to" (str host ":" lib "/app")))

(defn laptop-reader-running? []
  (str/includes? (:out (p/sh "herd" "status" "reader")) "It is running"))

(defn state []
  (when (laptop-reader-running?)
    (die "reader-push: the laptop's reader still runs; `herd stop reader' first, so the state does not split"))
  (let [from (str src "/.wrangler/state")
        backup (str home "/.local/share/reader/backups/state-" (stamp) ".tar")]
    (when-not (fs/exists? (str from "/v3")) (die "reader-push: no state in" from))
    (fs/create-dirs (fs/parent backup))
    (p/shell {:dir from} "tar" "-cf" backup ".")
    (println "Laptop backup:" backup)
    (tar-to-builder from []
                    (str "set -e; herd stop reader-suggester; herd stop reader; cd " lib "; "
                         "if [ -d state/v3 ]; then tar -cf state-" (stamp) ".tar -C state .; fi; "
                         "rm -rf state.new; mkdir state.new; tar -x --no-same-owner -C state.new; "
                         "chown -R reader:reader state.new; rm -rf state; mv state.new state; "
                         "herd start reader; herd start reader-suggester"))
    (println "Moved" from "to" (str host ":" lib "/state"))))

(defn status []
  (remote "herd status reader | head -3; herd status reader-suggester | head -3; tailscale serve status")
  (let [items (-> (p/sh "curl" "-sS" "--max-time" "20" (str "https://" host "/api/items"))
                  :out (json/parse-string))]
    (println "Headlines served at" (str "https://" host "/:") (count items))))

(case (first *command-line-args*)
  "code" (code)
  "state" (state)
  "status" (status)
  (die "usage: reader-push code | state | status"))
