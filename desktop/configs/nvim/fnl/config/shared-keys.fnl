;; Generated by desktop/build/keybindings/generate.bb. Edit keybindings/leader.edn.
(local keylog (require :config.keylog))
(keylog.map "<leader>," "<cmd>Telescope buffers sort_mru=true ignore_current_buffer=true<cr>" "Switch buffer, tab or window" "Space ,")
(keylog.map "<leader>`" "<cmd>e #<cr>" "Last buffer or window" "Space `")
(keylog.map "<leader>wh" #((. (require :smart-splits) :move_cursor_left)) "Focus left" "Space w h")
(keylog.map "<leader>wj" #((. (require :smart-splits) :move_cursor_down)) "Focus down" "Space w j")
(keylog.map "<leader>wk" #((. (require :smart-splits) :move_cursor_up)) "Focus up" "Space w k")
(keylog.map "<leader>wl" #((. (require :smart-splits) :move_cursor_right)) "Focus right" "Space w l")
(keylog.map "<leader>ws" "<cmd>split<cr>" "Split below" "Space w s")
(keylog.map "<leader>wv" "<cmd>vsplit<cr>" "Split right" "Space w v")
(keylog.map "<leader>wd" "<cmd>close<cr>" "Close window or pane" "Space w d")
(keylog.map "<leader>wm" "<cmd>lua Snacks.zoom()<cr>" "Maximize or zoom" "Space w m")
(keylog.map "<leader>w=" "<C-w>=" "Balance windows" "Space w =")
(keylog.map "<leader>bb" "<cmd>Telescope buffers sort_mru=true ignore_current_buffer=true<cr>" "Choose buffer, tab or window" "Space b b")
(keylog.map "<leader>bn" "<cmd>bnext<cr>" "Next buffer, tab or window" "Space b n")
(keylog.map "<leader>bp" "<cmd>bprevious<cr>" "Previous buffer, tab or window" "Space b p")
(keylog.map "<leader>bd" "<cmd>lua Snacks.bufdelete()<cr>" "Close buffer or tab" "Space b d")
(keylog.map "<leader>fs" "<cmd>write<cr>" "Save file" "Space f s")
(keylog.map "<leader>fr" "<cmd>Telescope oldfiles<cr>" "Recent files" "Space f r")
(keylog.map "<leader>sb" "<cmd>Telescope current_buffer_fuzzy_find<cr>" "Search buffer" "Space s b")
(keylog.map "<leader>cd" "<cmd>lua vim.lsp.buf.definition()<cr>" "Find definition" "Space c d")
(keylog.map "<leader>cD" "<cmd>lua vim.lsp.buf.references()<cr>" "Find references" "Space c D")
(keylog.map "<leader>cr" "<cmd>lua vim.lsp.buf.rename()<cr>" "Rename symbol" "Space c r")
(keylog.map "<leader>ca" "<cmd>lua vim.lsp.buf.code_action()<cr>" "Code action" "Space c a")
(keylog.map "<leader>cx" "<cmd>Telescope diagnostics<cr>" "Diagnostics" "Space c x")
(keylog.map "<leader>ot" "<cmd>lua Snacks.terminal()<cr>" "Terminal" "Space o t")
(let [(ok which-key) (pcall require :which-key)]
  (when ok
    (which-key.add [{1 "<leader>w" :group "Windows and panes"}
                    {1 "<leader>b" :group "Buffers, tabs and windows"}
                    {1 "<leader>f" :group "Files"}
                    {1 "<leader>s" :group "Search"}
                    {1 "<leader>c" :group "Code"}
                    {1 "<leader>o" :group "Open"}])))
