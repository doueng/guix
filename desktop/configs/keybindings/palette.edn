{;; Chrome's commands in the Cmd+Space launcher, first while Chrome has focus.
 ;; Each row runs one way: :type types Vimium keys into the page, :chord sends a
 ;; Chrome or vimium-cljs shortcut, :url opens a page in a new tab and :tab acts
 ;; on the active tab, both through the ext-reload helper (desktop/bin/ext-reload).
 ;; :url and :tab rows need no focus, so the launcher lists them everywhere.
 :chrome
 [{:label "Vomnibar: open a URL, bookmark or history here" :keys "Ctrl+L" :chord "ctrl+shift+h"}
  {:label "Vomnibar: open in a new tab" :keys "Cmd+T" :chord "ctrl+shift+y"}
  {:label "Tab selector: search open tabs" :keys "T, Cmd+Space b b" :chord "ctrl+shift+k"}
  {:label "Side panel: the tab list" :keys "Alt+E" :chord "ctrl+shift+e"}
  {:label "Link hints: follow a link" :keys "f" :type "f"}
  {:label "Open URL, bookmark or history" :keys "o" :type "o"}
  {:label "Open URL in a new tab" :keys "O" :type "O"}
  {:label "Open a bookmark" :keys "b" :type "b"}
  {:label "Open a link in a new tab" :keys "F" :type "F"}
  {:label "Focus the first input" :keys "gi" :type "gi"}
  {:label "Find in page" :keys "/" :type "/"}
  {:label "Copy page URL" :keys "yy" :type "yy"}
  {:label "Duplicate tab" :keys "yt" :tab "duplicate"}
  {:label "Pin or unpin tab" :tab "pin"}
  {:label "Mute or unmute tab" :tab "mute"}
  {:label "Move tab to a new window" :tab "detach"}
  {:label "Edit the URL" :keys "ge" :type "ge"}
  {:label "Go up one URL level" :keys "gu" :type "gu"}
  {:label "Back" :keys "H" :type "H"}
  {:label "Forward" :keys "L" :type "L"}
  {:label "Previous tab" :keys "J" :type "J"}
  {:label "Next tab" :keys "K" :type "K"}
  {:label "Close tab" :keys "x" :type "x"}
  {:label "Reopen closed tab" :keys "Ctrl+Shift+T" :chord "ctrl+shift+t"}
  {:label "Reload page" :keys "r" :type "r"}
  {:label "Scroll to top" :keys "gg" :type "gg"}
  {:label "Scroll to bottom" :keys "G" :type "G"}
  {:label "Visual mode" :keys "v" :type "v"}
  {:label "View page source" :keys "gs" :type "gs"}
  {:label "Vimium help" :keys "?" :type "?"}
  {:label "New tab" :keys "Ctrl+T" :chord "ctrl+t"}
  {:label "New window" :keys "Ctrl+N" :chord "ctrl+n"}
  {:label "Address bar" :keys "Alt+D" :chord "alt+d"}
  {:label "Find in page (Chrome)" :keys "Ctrl+F" :chord "ctrl+f"}
  {:label "Print" :keys "Ctrl+P" :chord "ctrl+p"}
  {:label "Zoom in" :keys "Ctrl+=" :chord "ctrl+="}
  {:label "Zoom out" :keys "Ctrl+-" :chord "ctrl+-"}
  {:label "Reset zoom" :keys "Ctrl+0" :chord "ctrl+0"}
  {:label "Developer tools" :keys "Ctrl+Shift+I" :chord "ctrl+shift+i"}
  {:label "Task manager" :keys "Shift+Esc" :chord "shift+esc"}
  {:label "Chrome: passwords" :url "chrome://password-manager/passwords"}
  {:label "Chrome: extensions" :url "chrome://extensions"}
  {:label "Chrome: extension shortcuts" :url "chrome://extensions/shortcuts"}
  {:label "Chrome: history" :keys "Ctrl+H" :url "chrome://history"}
  {:label "Chrome: downloads" :keys "Ctrl+J" :url "chrome://downloads"}
  {:label "Chrome: bookmark manager" :keys "Ctrl+Shift+O" :url "chrome://bookmarks"}
  {:label "Chrome: settings" :url "chrome://settings"}
  {:label "Chrome: privacy and security" :url "chrome://settings/privacy"}
  {:label "Chrome: cookies and site data" :url "chrome://settings/cookies"}
  {:label "Chrome: search engines" :url "chrome://settings/searchEngines"}
  {:label "Chrome: site settings" :url "chrome://settings/content"}
  {:label "Chrome: clear browsing data" :keys "Ctrl+Shift+Delete" :url "chrome://settings/clearBrowserData"}]
 :idea
 [{:label "Find action" :keys "Ctrl+Shift+A" :action "GotoAction"}
  {:label "Go to file" :keys "Ctrl+Shift+N" :action "GotoFile"}
  {:label "Go to class" :keys "Ctrl+N" :action "GotoClass"}
  {:label "Go to symbol" :keys "Ctrl+Alt+Shift+N" :action "GotoSymbol"}
  {:label "Find in files" :keys "Ctrl+Shift+F" :action "FindInPath"}
  {:label "Run" :keys "Shift+F10" :action "Run"}
  {:label "Debug" :keys "Shift+F9" :action "Debug"}
  {:label "Reformat code" :keys "Ctrl+Alt+L" :action "ReformatCode"}
  {:label "Optimize imports" :keys "Ctrl+Alt+O" :action "OptimizeImports"}
  {:label "Refactor this" :keys "Ctrl+Alt+Shift+T" :action "Refactorings.QuickListPopupAction"}
  {:label "Project tool window" :keys "palette (Alt+1 is workspace 1)" :action "ActivateProjectToolWindow"}
  {:label "Comment line" :keys "Ctrl+/" :action "CommentByLineComment"}
  {:label "Go to implementation" :keys "gi" :action "GotoImplementation"}]
 ;; jjui's default keys (jjui 0.10), typed into its pane.
 :jjui
 [{:label "New change" :type "n"}
  {:label "Describe in editor" :type "D"}
  {:label "Edit change" :type "e"}
  {:label "Commit" :type "c"}
  {:label "Abandon" :type "a"}
  {:label "Squash" :type "S"}
  {:label "Split" :type "s"}
  {:label "Rebase" :type "r"}
  {:label "Absorb" :type "A"}
  {:label "Duplicate" :type "y"}
  {:label "Diff" :type "d"}
  {:label "Evolog" :type "v"}
  {:label "Undo" :type "u"}
  {:label "Redo" :type "U"}
  {:label "Bookmarks" :type "b"}
  {:label "Set bookmark" :type "B"}
  {:label "Git: fetch or push" :type "g"}
  {:label "Operation log" :type "o"}
  {:label "Jump to working copy" :type "@"}
  {:label "Search" :type "/"}
  {:label "Run a jj command" :type ":"}
  {:label "Toggle preview" :type "p"}
  {:label "Edit revset" :type "L"}
  {:label "Help" :type "?"}]}
