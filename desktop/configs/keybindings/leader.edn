{:terminal {:keeps [["^(g?(view|l?n?vim?x?)(diff)?|\\.?emacs.*)$" "hjkl"]
                    ["^pi$" "jkl"]
                    ["^fzf$" "jk"]
                    ["^(fish|bash|zsh)$" "l"]]}
 ;; Where Alt+Space, the local prefix, goes for each window class (T208).
 ;; :pass hands the key to the window, whose own keymap binds it; a chord
 ;; vector is sent instead; :submap enters the Hyprland submap generated from
 ;; the :context's bindings. Every other class opens the launcher.
 :apps [{:class "dev.engstrand.Rex" :alt-space :pass}
        {:class "com.mitchellh.ghostty.herdr" :alt-space ["ctrl+b" "space"]}
        {:class "rexmux" :alt-space ["ctrl+b" "space"]}
        {:class "google-chrome" :alt-space :submap :context :chrome}
        {:class "com.mitchellh.ghostty" :alt-space :pass}
        {:class "emacs" :alt-space :pass}]
 :groups [["w" "Windows and panes"]
          ["b" "Buffers, tabs and windows"]
          ["f" "Files"]
          ["s" "Search"]
          ["c" "Code"]
          ["o" "Open"]
          ["p" "Projects"]
          ["TAB" "Workspaces"]
          ["t" "Tabs"]]
 :bindings
 [{:keys [","] :label "Switch buffer, tab or window" :doom-match :exact :idea "<Action>(Switcher)"
   :nvim "<cmd>Telescope buffers sort_mru=true ignore_current_buffer=true<cr>"
   :doom "+vertico/switch-workspace-buffer" :desktop :choose-window :herdr :choose-tab}
  {:keys ["`"] :label "Last buffer or window" :doom-match :exact :nvim "<cmd>e #<cr>"
   :doom "evil-switch-to-windows-last-buffer" :desktop ["focus" {:last true}]}
  {:keys ["."] :label "Find file, launch app or switch workspace" :doom-match :analogous :idea "<Action>(GotoFile)"
   :doom "eng/project-find-file" :desktop-command ["~/.local/bin/custom-launcher"] :herdr :choose-workspace}
  {:keys ["d"] :label "Close pane" :doom-match :differs :herdr :close-pane}
  {:keys ["a"] :label "Agents" :doom-match :differs :herdr :choose-agent}
  {:keys ["e"] :label "Edit scrollback" :herdr :edit-scrollback}
  {:keys ["w" "h"] :label "Focus left" :doom-match :exact :nav "left"}
  {:keys ["w" "j"] :label "Focus down" :doom-match :exact :nav "down"}
  {:keys ["w" "k"] :label "Focus up" :doom-match :exact :nav "up"}
  {:keys ["w" "l"] :label "Focus right" :doom-match :exact :nav "right"}
  {:keys ["w" "s"] :label "Split below" :doom-match :exact :idea "<C-w>s" :nvim "<cmd>split<cr>" :doom "split-window-below"
   :herdr ["pane" "split" "--direction" "down" "--focus"]}
  {:keys ["w" "v"] :label "Split right" :doom-match :exact :idea "<C-w>v" :nvim "<cmd>vsplit<cr>" :doom "split-window-right"
   :herdr ["pane" "split" "--direction" "right" "--focus"]}
  {:keys ["w" "d"] :label "Close window or pane" :doom-match :exact :idea "<C-w>c" :nvim "<cmd>close<cr>" :doom "delete-window"
   :herdr :close-pane}
  {:keys ["w" "m"] :label "Maximize or zoom" :doom-match :exact :idea "<Action>(HideAllWindows)" :nvim "<cmd>lua Snacks.zoom()<cr>"
   :doom "doom/window-maximize-buffer" :desktop ["window.fullscreen" {:mode "maximized"}]
   :herdr ["pane" "zoom" "--toggle"]}
  {:keys ["w" "="] :label "Balance windows" :doom-match :exact :nvim "<C-w>=" :doom "balance-windows"}
  {:keys ["b" "b"] :label "Choose buffer, tab or window" :doom-match :exact :idea "<Action>(Switcher)"
   :nvim "<cmd>Telescope buffers sort_mru=true ignore_current_buffer=true<cr>"
    :doom "switch-to-buffer" :desktop :choose-window :chrome "ctrl+shift+k" :herdr :choose-tab}
  {:keys ["b" "n"] :label "Next buffer, tab or window" :doom-match :exact :idea "<Action>(NextTab)" :nvim "<cmd>bnext<cr>" :doom "next-buffer"
   :desktop ["window.cycle_next"] :herdr :next-tab}
  {:keys ["b" "p"] :label "Previous buffer, tab or window" :doom-match :exact :idea "<Action>(PreviousTab)" :nvim "<cmd>bprevious<cr>"
   :doom "previous-buffer" :desktop ["window.cycle_next" {:next false}] :herdr :previous-tab}
  {:keys ["b" "d"] :label "Close buffer or tab" :doom-match :exact :idea "<Action>(CloseContent)" :nvim "<cmd>lua Snacks.bufdelete()<cr>"
   :doom "kill-current-buffer" :herdr :close-tab}
  {:keys ["f" "s"] :label "Save file" :doom-match :exact :idea "<Action>(SaveAll)" :nvim "<cmd>write<cr>" :doom "save-buffer"}
  {:keys ["f" "r"] :label "Recent files" :doom-match :exact :idea "<Action>(RecentFiles)" :nvim "<cmd>Telescope oldfiles<cr>" :doom "recentf-open-files"}
  {:keys ["s" "b"] :label "Search buffer" :doom-match :exact :idea "<Action>(Find)" :nvim "<cmd>Telescope current_buffer_fuzzy_find<cr>"
   :doom "consult-line"}
  {:keys ["s" "l"] :label "Copy visible text by hint" :doom-match :analogous :herdr {:plugin "hotchpotch.herdr-tiny-fingers" :action "open"}}
  {:keys ["c" "d"] :label "Find definition" :doom-match :exact :idea "<Action>(GotoDeclaration)" :nvim "<cmd>lua vim.lsp.buf.definition()<cr>"
   :doom "eng/lsp-find-definition"}
  {:keys ["c" "D"] :label "Find references" :doom-match :exact :idea "<Action>(FindUsages)" :nvim "<cmd>lua vim.lsp.buf.references()<cr>"
   :doom "eng/lsp-find-references"}
  {:keys ["c" "r"] :label "Rename symbol" :doom-match :exact :idea "<Action>(RenameElement)" :nvim "<cmd>lua vim.lsp.buf.rename()<cr>" :doom "eng/lsp-rename"}
  {:keys ["c" "a"] :label "Code action" :doom-match :exact :idea "<Action>(ShowIntentionActions)" :nvim "<cmd>lua vim.lsp.buf.code_action()<cr>"
   :doom "eng/lsp-code-actions"}
  {:keys ["c" "x"] :label "Diagnostics" :doom-match :exact :idea "<Action>(ActivateProblemsViewToolWindow)" :nvim "<cmd>Telescope diagnostics<cr>" :doom "eng/lsp-diagnostics"}
  {:keys ["o" "t"] :label "Terminal" :doom-match :exact :desktop-command ["~/.local/bin/workspace-or-herdr-tab" "1"]
   :doom "+ghostel/toggle" :nvim "<cmd>lua Snacks.terminal()<cr>" :idea "<Action>(ActivateTerminalToolWindow)"}
  {:keys ["o" "b"] :label "Browser workspace" :doom-match :analogous :desktop ["focus" {:workspace 2}]}
  {:keys ["o" "i"] :label "IntelliJ workspace" :desktop ["focus" {:workspace 4}]}
  {:keys ["o" "n"] :label "Open Chrome incognito" :desktop-command ["~/.local/bin/chrome-unified" "--incognito"]
   :chrome "ctrl+shift+n"}
  {:keys ["o" "s"] :label "Send to phone" :doom-match :differs :desktop-command ["~/.local/bin/taildrop" "send"]}
  {:keys ["p" "p"] :label "Switch project" :doom-match :exact :doom "projectile-switch-project"
   :idea "<Action>(ManageRecentProjects)" :herdr {:plugin "fullerzz.sesh" :action "open-picker"}}
  {:keys ["TAB" "."] :label "Switch workspace" :doom-match :exact :doom "+workspace/switch-to" :herdr :choose-workspace}
  {:keys ["TAB" "`"] :label "Last workspace" :doom-match :exact :doom "+workspace/other"
   :herdr {:plugin "fullerzz.sesh" :action "last"} :desktop ["focus" {:workspace "previous"}]}
  {:keys ["t" "n"] :label "New tab" :doom-match :differs :herdr :new-tab :chrome "ctrl+shift+y"}
  {:keys ["t" "l"] :label "Next tab" :doom-match :differs :herdr :next-tab :chrome "ctrl+pagedown"}
  {:keys ["t" "h"] :label "Previous tab" :herdr :previous-tab :chrome "ctrl+pageup"}
  {:keys ["t" "d"] :label "Close tab" :doom-match :differs :herdr :close-tab :chrome "ctrl+w"}
  {:keys ["t" "r"] :label "Rename tab" :doom-match :differs :herdr :rename-tab}
  {:keys ["t" "1"] :label "Tab 1" :herdr {:tab 1} :chrome "ctrl+1"}
  {:keys ["t" "2"] :label "Tab 2" :herdr {:tab 2} :chrome "ctrl+2"}
  {:keys ["t" "3"] :label "Tab 3" :herdr {:tab 3} :chrome "ctrl+3"}
  {:keys ["t" "4"] :label "Tab 4" :herdr {:tab 4} :chrome "ctrl+4"}
  {:keys ["t" "5"] :label "Tab 5" :herdr {:tab 5} :chrome "ctrl+5"}
  {:keys ["t" "6"] :label "Tab 6" :herdr {:tab 6} :chrome "ctrl+6"}
  {:keys ["t" "7"] :label "Tab 7" :herdr {:tab 7} :chrome "ctrl+7"}
  {:keys ["t" "8"] :label "Tab 8" :herdr {:tab 8} :chrome "ctrl+8"}
  {:keys ["t" "9"] :label "Tab 9" :herdr {:tab 9} :chrome "ctrl+9"}
  {:keys ["t" "H"] :label "Move tab left" :rex :tab/move-left :chrome "ctrl+shift+pageup"}
  {:keys ["t" "L"] :label "Move tab right" :rex :tab/move-right :chrome "ctrl+shift+pagedown"}
  {:keys ["TAB" "1"] :label "Workspace 1" :doom-match :analogous :desktop ["focus" {:workspace 1}]}
  {:keys ["TAB" "2"] :label "Workspace 2" :doom-match :analogous :desktop ["focus" {:workspace 2}]}
  {:keys ["TAB" "3"] :label "Workspace 3" :doom-match :analogous :desktop ["focus" {:workspace 3}]}
  {:keys ["TAB" "4"] :label "Workspace 4" :doom-match :analogous :desktop ["focus" {:workspace 4}]}
  {:keys ["TAB" "5"] :label "Workspace 5" :doom-match :analogous :desktop ["focus" {:workspace 5}]}
  {:keys ["TAB" "6"] :label "Workspace 6" :doom-match :analogous :desktop ["focus" {:workspace 6}]}
  {:keys ["TAB" "7"] :label "Workspace 7" :doom-match :analogous :desktop ["focus" {:workspace 7}]}
  {:keys ["TAB" "8"] :label "Workspace 8" :doom-match :analogous :desktop ["focus" {:workspace 8}]}
  {:keys ["TAB" "9"] :label "Workspace 9" :doom-match :analogous :desktop ["focus" {:workspace 9}]}
  {:keys ["TAB" "0"] :label "Workspace 10" :doom-match :differs :desktop ["focus" {:workspace 10}]}]}
