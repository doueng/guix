# Ghostty Asahi overrides

# keyd turns Cmd+digits into Ctrl+digits before Ghostty sees them. Translate
# those chords into Herdr's native Ctrl+B,<number> tab sequence while keeping
# Ctrl+digits available to non-terminal applications such as Chromium.
keybind = ctrl+physical:one=text:\x02\x31
keybind = ctrl+physical:two=text:\x02\x32
keybind = ctrl+physical:three=text:\x02\x33
keybind = ctrl+physical:four=text:\x02\x34
keybind = ctrl+physical:five=text:\x02\x35
keybind = ctrl+physical:six=text:\x02\x36
keybind = ctrl+physical:seven=text:\x02\x37
keybind = ctrl+physical:eight=text:\x02\x38
keybind = ctrl+physical:nine=text:\x02\x39

font-size = 15
quick-terminal-autohide = true
window-decoration = none
