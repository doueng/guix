font-family = JetBrainsMono Nerd Font
font-feature = -calt, -liga, -dlig
font-size = 9.375
font-thicken = true

theme = catppuccin-mocha

background-opacity = 0.9

cursor-style = underline
cursor-style-blink = false
mouse-hide-while-typing = true

command = fish
shell-integration = fish
shell-integration-features = no-cursor,no-sudo

clipboard-read = allow
clipboard-paste-protection = false
copy-on-select = false
clipboard-trim-trailing-spaces = true

window-decoration = none
quick-terminal-autohide = true
resize-overlay = never
app-notifications = no-clipboard-copy
link-url = false

quit-after-last-window-closed = false
confirm-close-surface = false

gtk-titlebar = false
gtk-single-instance = desktop

# kanata sends Ctrl+Insert for Cmd+C. Copy Ghostty's own selection; with none,
# performable: hands the key to the program, so Emacs and Neovim copy theirs.
# Ghostty 1.4 keeps the default's consuming binding unless it is unbound first.
keybind = ctrl+insert=unbind
keybind = performable:ctrl+insert=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard
keybind = ctrl+enter=unbind
keybind = shift+ctrl+alt+r=reload_config
keybind = super+left=text:\x01
keybind = super+right=text:\x05
keybind = super+up=jump_to_prompt:-1
keybind = super+down=jump_to_prompt:1
keybind = super+shift+up=jump_to_prompt:-1
keybind = super+shift+down=jump_to_prompt:1
keybind = super+p=toggle_quick_terminal
