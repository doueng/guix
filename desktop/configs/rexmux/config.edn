;; rexmux, the Rex client (desktop/build/rexmux). make refresh links this file to
;; ~/.config/rexmux/config.edn; rexmux reads it at start, the sidecar on M-x
;; Help: reload.
{;; Rex servers, the first shown at start. A nil address is the local server,
 ;; which rexmux starts when it is not running. Add {:label .. :address
 ;; "unix:///path/to.sock"} entries for more; M-x Servers: switch moves between them.
 :servers [{:label "local" :address nil}]
 ;; One leader menu for Herdr and rexmux: leader.edn's :herdr and :rex actions
 ;; run the matching command under Alt+Space, the local prefix, which
 ;; Hyprland passes to this window; Alt+Space Space opens M-x.
 :leader-file "~/.config/keybindings/leader.edn"
 :leader-prefix ["alt+space"]
 ;; Bare Ctrl+h/j/k/l through keyleader term-nav, as Herdr has them.
 :term-nav true
 ;; The shell every new block runs, as Herdr's default_shell; without it Rex
 ;; uses the server's $SHELL, which is bash when a script autostarted it.
 :shell "fish"
 ;; The session rexmux shows, made when the server lacks it, in the order of
 ;; the Herdr guix workspace's tabs: Super+Return, E, D and G pick them.
 :startup {:label "main"
           :cwd "~/guix"
           :windows [{:label "shell"}
                     {:label "bbh" :command ["emacs-bbh"]}
                     ;; After a reboot Rex brings the tabs back as bare shells;
                     ;; rexmux runs :restore (else :command) in them again.
                     {:label "pi" :command ["pi"] :restore ["pi" "--continue"]}
                     {:label "jjui" :command ["jjui"]}]}}
