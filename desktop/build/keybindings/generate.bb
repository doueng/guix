#!/usr/bin/env bb
;; Writes, or with --check verifies, every file derived from keybindings/leader.edn.
(ns generate-leaders
  (:require [clojure.edn :as edn] [clojure.string :as str]))
(load-file "desktop/bin/keyleader")
(load-file "desktop/build/keybindings/reference.clj")

(defn vim-lhs [keys] (str "<leader>" (str/join (map #(get {"TAB" "<Tab>"} % %) keys))))

(defn context-groups
  "The leader groups that CONTEXT binds anything under."
  [grammar context]
  (filter (fn [[k]] (some #(= [k] (butlast (:keys %))) (keyleader/in-context grammar context))) (:groups grammar)))

(defn nvim-rhs [{:keys [nav nvim]}]
  (if nav
    (str "#((. (require :smart-splits) :move_cursor_" nav "))")
    (pr-str nvim)))

(defn doom-command [{:keys [nav doom label] :as b}]
  (str "(eng/keylog-command " (pr-str (str "Space " (str/join " " (:keys b)))) " " (pr-str label) " "
       (if nav (str "(lambda () (interactive) (eng/navigate " (pr-str nav) "))") (str "#'" doom))
       ")"))

(defn outputs [grammar]
  {"desktop/configs/nvim/fnl/config/shared-keys.fnl"
   (str ";; Generated by desktop/build/keybindings/generate.bb. Edit keybindings/leader.edn.\n"
        "(local keylog (require :config.keylog))\n"
        (apply str
               (for [b (keyleader/in-context grammar :nvim)]
                 (str "(keylog.map " (pr-str (vim-lhs (:keys b))) " "
                      (nvim-rhs b) " " (pr-str (:label b)) " "
                      (pr-str (str "Space " (str/join " " (:keys b)))) ")\n")))
        "(let [(ok which-key) (pcall require :which-key)]\n  (when ok\n    (which-key.add ["
        (str/join "\n                    "
                  (for [[k label] (context-groups grammar :nvim)]
                    (str "{1 " (pr-str (vim-lhs [k])) " :group " (pr-str label) "}")))
        "])))\n")
   "desktop/configs/doom/shared-keys.el"
   (str ";;; shared-keys.el --- Generated by desktop/build/keybindings/generate.bb -*- lexical-binding: t; -*-\n"
        ";; Edit keybindings/leader.edn instead.\n"
        "(map! :leader\n"
        (apply str
               (for [b (keyleader/in-context grammar :doom)]
                 (str "      :desc " (pr-str (:label b)) " " (pr-str (str/join " " (:keys b)))
                      " " (doom-command b) "\n")))
        "      )\n")
   "desktop/configs/hypr/leader.lua" (keyleader/hypr-config grammar)
   "desktop/configs/hypr/keybindings.lua"
   (keyguide/hypr-config (keyguide/validate! (keyguide/groups (edn/read-string (slurp "desktop/configs/keybindings/bindings.edn")))))
   "desktop/configs/ideavim/.config/ideavim/shared-keys.vim"
   (str "\" Generated by desktop/build/keybindings/generate.bb. Edit keybindings/leader.edn.\n"
        (apply str
               (for [b (keyleader/in-context grammar :idea)
                     :let [lhs (vim-lhs (:keys b))
                           rhs (or (:idea b) (str "<C-w>" (subs ({"left" "h" "down" "j" "up" "k" "right" "l"} (:nav b)) 0 1)))]]
                 (str "nmap " lhs " " rhs "\n"
                      "let g:WhichKeyDesc_shared_"
                      (str/join "_" (map #(get {"=" "equal" "," "comma" "." "period" "`" "grave" "TAB" "tab"} % %) (:keys b)))
                      " = '" lhs " " (:label b) "'\n"))))
   "desktop/configs/keybindings/reference.html"
   (keybindings-reference/html (keybindings-reference/sources "." grammar))})

(let [grammar (keyleader/validate! (edn/read-string (slurp "desktop/configs/keybindings/leader.edn")))
      check? (= "--check" (first *command-line-args*))
      stale (for [[path content] (outputs grammar)
                  :when (if check?
                          (not= content (try (slurp path) (catch Exception _ nil)))
                          (do (spit path content) false))]
              path)]
  (when (seq stale)
    (binding [*out* *err*]
      (println "Generated keybinding files are stale. Run bb desktop/build/keybindings/generate.bb:")
      (run! println stale))
    (System/exit 1)))
