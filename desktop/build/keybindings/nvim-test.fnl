(vim.api.nvim_exec_autocmds :User {:pattern :VeryLazy})
(local original-j (vim.fn.maparg :j :n false true))
(assert (vim.wait 2000 (fn [] (. (require :hardtime) :is_plugin_enabled)))
        "Hardtime did not enable")
(local hints [])
(tset (. (require :hardtime.config) :config) :callback
     (fn [message] (table.insert hints message)))
(vim.cmd "enew")
(vim.api.nvim_buf_set_lines 0 0 -1 false ["abcdefghijklmnopqrstuvwxyz"])
(vim.api.nvim_win_set_cursor 0 [1 0])
(for [i 1 8]
  (vim.api.nvim_feedkeys :l :xt false))
(assert (= (. (vim.api.nvim_win_get_cursor 0) 2) 8)
        "Hint mode must not block repeated movement")
(assert (vim.wait 500 (fn [] (> (length hints) 0)))
        "Repeated movement must produce a hint")
(vim.cmd "Hardtime disable")
(assert (= (. (vim.fn.maparg :j :n false true) :rhs) original-j.rhs)
        "Disabling coaching must restore the wrapped-line mapping")
(vim.api.nvim_feedkeys :l :xt false)
(assert (= (. (vim.api.nvim_win_get_cursor 0) 2) 9)
        "Disabling coaching must leave movement available")
(vim.cmd "Hardtime enable")
(vim.api.nvim_feedkeys :l :xt false)
(assert (= (. (vim.api.nvim_win_get_cursor 0) 2) 10)
        "Enabling coaching must leave movement available")
(print "Hardtime motion, hint, disable and enable checks passed")
(vim.cmd "qa!")
