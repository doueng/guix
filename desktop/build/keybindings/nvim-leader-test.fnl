(assert (= nil vim.env.HERDR_PANE_ID) "Run outside Herdr so the backend cannot move real panes")
(fn desc [lhs] (. (vim.fn.maparg lhs :n false true) :desc))
(vim.api.nvim_exec_autocmds :User {:pattern :VeryLazy})
(assert (vim.wait 2000 #(= (desc "<Space>wh") "Focus left")) "Space w h must focus left")
(assert (= (desc "<Space>cd") "Find definition") "Space c d must match Doom")
(assert (= (desc "<Space>cD") "Find references") "Space c D must find references, as in Doom")
(assert (= (desc "<Space>,") "Switch buffer, tab or window") "Space , must switch buffers")
(assert (= (desc "<Space>`") "Last buffer or window") "Space ` must return to the last buffer")
(assert (= (desc "<Space>ot") "Terminal") "Space o t must open a terminal")
(assert (= (desc "<Space><Space>") "Command Palette") "Space Space must open the command palette")
(assert (= (desc "<C-l>") "Focus right") "Ctrl+l must focus right")

(local handed-off [])
(local system vim.system)
(set vim.system (fn [argv] (table.insert handed-off argv) {}))
(fn press [keys]
  (vim.api.nvim_feedkeys (vim.api.nvim_replace_termcodes keys true false true) :xt false))
(vim.cmd.vsplit)
(vim.cmd.wincmd :h)
(local left (vim.api.nvim_get_current_win))
(press "<C-l>")
(assert (not= left (vim.api.nvim_get_current_win)) "Ctrl+l must move to the right window")
(assert (= 0 (length handed-off)) "No hand-off while a window exists")
(press "<C-l>")
(assert (= 1 (length handed-off)) "The right edge must hand off")
(assert (= "nav right" (table.concat [(. handed-off 1 2) (. handed-off 1 3)] " "))
        "Hand-off must ask keyleader to navigate right")
(press " wh")
(assert (= left (vim.api.nvim_get_current_win)) "Space w h must reach the left window")
(set vim.system system)

(local lines (vim.fn.readfile vim.env.KEYLOG_FILE))
(assert (= 3 (length lines)) (.. "Expected three log rows, got " (length lines)))
(assert (: (. lines 1) :match "\tNeovim\tCtrl%+l\tFocus right$") (. lines 1))
(assert (: (. lines 3) :match "\tNeovim\tSpace w h\tFocus left$") (. lines 3))
(print "Neovim leader, smart-splits, edge hand-off and log checks passed")
(vim.cmd "qa!")
