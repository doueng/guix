{:workflow :bug-fix
 :routes ["bug_fix"]
 :start :reproduce
 :phases
 {:reproduce
  {:brief "Run the repro on the real surface and confirm it fails. The gate rejects a repro that already passes. Keep the output as evidence."
   :gates [{:kind :command :cmd :repro :expect :nonzero}]
   :next :diagnose}
  :diagnose
  {:brief "Form hypotheses and rule them out with runtime evidence. Write mechanism.md in the evidence directory naming the surviving mechanism and its evidence. Then record a verdict with `wf verdict`."
   :gates [{:kind :artifact :path "mechanism.md"}
           {:kind :verdict :criteria "The evidence causally supports the mechanism, not just correlates with the bug."}]
   :next :implement}
  :implement
  {:brief "Make the smallest change the mechanism justifies. Revert changes that a refuted hypothesis motivated. Then run `wf attest`."
   :gates []
   :next :verify}
  :verify
  {:brief "Run the same repro on the same surface. It must pass now. An inconclusive or wrong-surface run does not count."
   :gates [{:kind :command :cmd :repro :expect :zero}
           {:kind :command :cmd :check :expect :zero :optional true}]
   :next :finish
   :on-fail :implement}
  :finish
  {:brief "Report what was broken, the root cause, the fix, and the failing and passing repro output, verbatim. Then run `wf attest`."
   :gates []
   :next nil}}}
