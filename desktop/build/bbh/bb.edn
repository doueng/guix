{:paths ["src" "test" "eval"]
 :tasks {eval:compare {:doc "Live Pi, Pi/SCI and bbh comparison. Spends OpenRouter credits. Args: OUTPUT-DIR REPETITIONS."
                       :requires ([bbh.compare])
                       :task (apply bbh.compare/-main *command-line-args*)}
         eval:contracts {:doc "Offline paired protocol checks. Args: OUTPUT-DIR REPETITIONS."
                         :requires ([bbh.contracts])
                         :task (apply bbh.contracts/-main *command-line-args*)}
         eval:lint {:doc "Level 1 assertion hits and graded passes per cohort. Args: ROOT... (default: conversations and ~/.cache/bbh-eval)."
                    :requires ([bbh.traces])
                    :task (apply bbh.traces/lint! *command-line-args*)}
         eval:show {:doc "Render one conversation directory as Markdown with assertion hits."
                    :requires ([bbh.traces])
                    :task (bbh.traces/show! (first *command-line-args*))}
         eval:review {:doc "Label unlabeled traces good or bad with a critique. Args: ROOT..."
                      :requires ([bbh.labels])
                      :task (apply bbh.labels/review! *command-line-args*)}
         eval:judge {:doc "LLM-judge traces under ROOT..., or every human-labeled trace. Spends Claude quota; BBH_JUDGE_MODEL defaults to opus."
                     :requires ([bbh.labels])
                     :task (apply bbh.labels/judge! *command-line-args*)}
         eval:agreement {:doc "Judge precision and recall against human labels, with disagreements."
                         :requires ([bbh.labels])
                         :task (bbh.labels/agreement!)}
         eval:swe-report {:doc "Markdown summary of Harbor SWE-rebench trials. Args: [--expected N] ROOT..."
                          :requires ([bbh.swe-report])
                          :task (apply bbh.swe-report/-main *command-line-args*)}
         eval:harbor-check {:doc "Offline check of harbor/bbh_agent.py: Harbor's ACP runner drives bbh with a scripted model. Needs uv."
                            :requires ([bbh.harbor-check])
                            :task (bbh.harbor-check/-main)}
         eval:graders {:doc "Reject untouched fixtures and accept reference solutions."
                       :requires ([bbh.tasks])
                       :task (bbh.tasks/verify-graders!)}
         runs:html {:doc "HTML page of the newest bbh conversations: prompts, tool calls, workflow runs and reviews. Args: [N] [OUT]."
                    :requires ([bbh.runs-page])
                    :task (apply bbh.runs-page/-main *command-line-args*)}
         runs:metrics {:doc "Latency, tokens, cache share, cost and failures per day and model from runs.jsonl. Args: [ROOT...]."
                       :requires ([bbh.metrics])
                       :task (apply bbh.metrics/-main *command-line-args*)}
         stats {:doc "Harness health: timeouts, restarts and errors per conversation, plus workflow runs. Args: [--since ID] [--until ID] [ROOT...]."
                :requires ([bbh.stats])
                :task (apply bbh.stats/-main *command-line-args*)}
         test:workflow {:doc "Run the workflow engine tests, including the route check against the Jev extension."
                        :requires ([clojure.test :as t] [bbh.workflow-test])
                        :task (let [{:keys [fail error]} (t/run-tests 'bbh.workflow-test)]
                                (System/exit (if (zero? (+ fail error)) 0 1)))}
         test:init {:doc "Start a real bbh session on init.clj and check the child REPL loads it."
                    :requires ([clojure.test :as t] [bbh.init-test])
                    :task (let [{:keys [fail error]} (t/run-tests 'bbh.init-test)]
                            (System/exit (if (zero? (+ fail error)) 0 1)))}
         test {:doc "Run the bbh tests."
               :requires ([clojure.test :as t] [bbh.llm-test] [bbh.context-test] [bbh.delimiters-test] [bbh.session-test] [bbh.acp-test] [bbh.claude-test] [bbh.env-test] [bbh.eval-test] [bbh.swe-report-test] [bbh.init-test] [bbh.workflow-test] [bbh.runs-page-test] [bbh.runs-test])
               :task (let [{:keys [fail error]} (t/run-tests 'bbh.llm-test 'bbh.context-test 'bbh.delimiters-test 'bbh.session-test 'bbh.acp-test 'bbh.claude-test 'bbh.env-test 'bbh.eval-test 'bbh.swe-report-test 'bbh.init-test 'bbh.workflow-test 'bbh.runs-page-test 'bbh.runs-test)]
                       (System/exit (if (zero? (+ fail error)) 0 1)))}
         try {:doc "bb try MODEL PROMPT...: run real prompts through agent-shell headlessly."
              :task (let [[model & prompts] *command-line-args*
                          home (System/getProperty "user.home")]
                      (shell {:extra-env {"BBH_MODEL" model
                                          "BBH_TRY_PROMPTS" (clojure.string/join "\n---\n" prompts)
                                          "BBH_ELISP_BUILD" (or (System/getenv "BBH_ELISP_BUILD")
                                                                (str home "/.config/emacs/.local/straight/build-31.1"))
                                          "BBH_DOOM_AGENT_SHELL" (str (babashka.fs/absolutize "../../configs/doom/agent-shell.el"))
                                          "HERDR_ENV" ""}}
                             "emacs" "-Q" "--batch" "-l" "test/try.el"))}
         test:doom {:doc "Start real Doom in a PTY and test the installed bbh configuration."
                    :task (let [dir (babashka.fs/create-temp-dir {:prefix "bbh-doom-test"})
                                report (str (babashka.fs/path dir "report.txt"))
                                log (str (babashka.fs/path dir "terminal.log"))
                                launcher? (= "launcher" (first *command-line-args*))]
                            (try
                              (shell {:out :string :err :string
                                      :extra-env {"TERM" "xterm-256color"
                                                  "XDG_DATA_HOME" (str dir)
                                                  "BBH_MODEL" (str "script/" (babashka.fs/absolutize "test/script.edn"))
                                                  "BBH_STARTUP_REPORT" report
                                                  "BBH_STARTUP_LAUNCHED" (if launcher? "1" "0")
                                                  ;; Keep agent status reports away from the herdr pane running the test.
                                                  "HERDR_ENV" ""}}
                                     "timeout" "60" "script" "-q" "-e" "-c"
                                     (str (System/getProperty "user.home")
                                          (if launcher? "/.local/bin/emacs-bbh" "/.local/bin/emacs") " -nw -l "
                                          (babashka.fs/absolutize "test/doom-startup-test.el")) log)
                              (finally
                                (println (str "Doom startup artifacts: " dir))
                                (when (babashka.fs/exists? report) (println (slurp report))))))}
         test:emacs {:doc "Drive bbh acp from Doom's agent-shell config in emacs --batch."
                     :task (let [home (System/getProperty "user.home")]
                             (shell {:extra-env {"BBH_MODEL" (str "script/" (babashka.fs/absolutize "test/script.edn"))
                                                 "XDG_DATA_HOME" (str (babashka.fs/create-temp-dir {:prefix "bbh-emacs-test"}))
                                                 "BBH_ELISP_BUILD" (or (System/getenv "BBH_ELISP_BUILD")
                                                                       (str home "/.config/emacs/.local/straight/build-31.1"))
                                                 "BBH_DOOM_AGENT_SHELL" (str (babashka.fs/absolutize "../../configs/doom/agent-shell.el"))
                                                 "HERDR_ENV" ""}}
                                    "emacs" "-Q" "--batch" "-l" "test/agent-shell-test.el" "-f" "ert-run-tests-batch-and-exit"))}
         test:transcript-scroll {:doc "Check in a terminal frame that the transcript does not scroll past its end."
                                 ;; stdin is not a terminal, so script leaves the caller's tty alone, and
                                 ;; Emacs's screen output is discarded. The verdict comes back in a file.
                                 :task (let [home (System/getProperty "user.home")
                                             result (babashka.fs/create-temp-file {:prefix "bbh-tty"})]
                                         (try
                                           (shell {:extra-env {"BBH_TTY_RESULT" (str result)
                                                               "TERM" "xterm-256color"
                                                               "BBH_ELISP_BUILD" (or (System/getenv "BBH_ELISP_BUILD")
                                                                                     (str home "/.config/emacs/.local/straight/build-31.1"))
                                                               "BBH_DOOM_AGENT_SHELL" (str (babashka.fs/absolutize "../../configs/doom/agent-shell.el"))}
                                                   :in nil :out :discard}
                                                  "timeout" "60" "script" "-qec"
                                                  "stty rows 30 cols 100; emacs -Q -nw -l test/tty-scroll-test.el" "/dev/null")
                                           (let [verdict (clojure.string/trim (slurp (str result)))]
                                             (println verdict)
                                             (when-not (= verdict "ok") (System/exit 1)))
                                           (finally (babashka.fs/delete-if-exists result))))}}}
