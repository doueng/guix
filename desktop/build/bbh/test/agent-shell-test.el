  (save-window-excursion
    (delete-other-windows)
    (let* ((script (make-temp-file "bbh-usage" nil ".edn" "[{:text \"Hello.\" :usage {:input 1000 :cached 0 :output 10 :size 200000}}]"))
           (old (bbh-test--start))
