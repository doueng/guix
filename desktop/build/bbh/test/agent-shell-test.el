;;; agent-shell-test.el --- bbh acp through Doom's agent-shell config -*- lexical-binding: t; -*-

;; Run with: bb test:emacs

(require 'ert)
(dolist (pkg '("agent-shell" "acp" "shell-maker" "map" "org"))
  (add-to-list 'load-path (expand-file-name pkg (getenv "BBH_ELISP_BUILD"))))
(defmacro after! (feature &rest body)
  `(with-eval-after-load ',feature ,@body))
(dolist (pkg '("goto-chg" "evil"))
  (add-to-list 'load-path (expand-file-name pkg (getenv "BBH_ELISP_BUILD"))))
(require 'evil)
(load (getenv "BBH_DOOM_AGENT_SHELL") nil t)
(require 'agent-shell)

(ert-deftest bbh-transcript-navigates-like-magit ()
  (with-current-buffer (get-buffer-create "*bbh-transcript-keys*")
    (eng/bbh-transcript-mode)
    (evil-local-mode 1)
    (evil-normal-state)
    (let ((inhibit-read-only t))
      (erase-buffer)
      (insert "* first\nbody one\n* second\nbody two\n** nested\n* third\n"))
    (goto-char (point-min))
    (dolist (step '(("n" "\\* second") ("M-n" "\\* third") ("M-p" "\\* second") ("p" "\\* first")))
      (call-interactively (key-binding (kbd (car step))))
      (should (looking-at (cadr step))))))

(ert-deftest bbh-config-loads-before-agent-shell ()
  (should (commandp 'eng/bbh))
  (should (eq (map-elt agent-shell-preferred-agent-config :identifier) 'bbh))
  (should (memq #'eng/bbh-agent-config agent-shell-agent-configs)))

(defun bbh-test--wait (pred secs)
  (let ((end (+ (float-time) secs)))
    (while (and (not (funcall pred)) (< (float-time) end))
      (accept-process-output nil 0.1))
    (funcall pred)))

(defun bbh-test--start ()
  (let ((buf (agent-shell-start :config (eng/bbh-agent-config))))
    (with-current-buffer buf
      (should (bbh-test--wait (lambda () (and (map-nested-elt agent-shell--state '(:session :id))
                                              (string-match-p "Ready" (buffer-string))))
                              30))
      (accept-process-output nil 0.5))
    buf))

(defun bbh-test--submit (buf text)
  (with-current-buffer buf
    (goto-char (point-max))
    (insert text)
    (shell-maker-submit)))

(defun bbh-test--idle-p (buf)
  (with-current-buffer buf (not (shell-maker-busy))))

(defun bbh-test--text (buf)
  (with-current-buffer buf (buffer-substring-no-properties (point-min) (point-max))))

(ert-deftest bbh-markdown-becomes-org ()
  (should (equal (eng/bbh--md->org "# Plan\n* use `(+ 1 2)` and **bold** [docs](https://x.org)\n```clojure\n* not a heading\n```\n| a | b |\n|:--|--:|\n```\nunclosed")
                 "*Plan*\n- use ~(+ 1 2)~ and *bold* [[https://x.org][docs]]\n#+begin_src clojure\n,* not a heading\n#+end_src\n| a | b |\n|---|---|\n#+begin_example\nunclosed\n#+end_example")))

(defun bbh-test--screen (buffer)
  "BUFFER's text as displayed, with display strings and without invisible text."
  (with-current-buffer buffer
    (font-lock-ensure)
    (let ((pos (point-min)) (out ""))
      (while (< pos (point-max))
        (let ((display (get-char-property pos 'display))
              (next (min (next-single-char-property-change pos 'display)
                         (next-single-char-property-change pos 'invisible))))
          (unless (invisible-p pos)
            (setq out (concat out (if (stringp display)
                                      (substring-no-properties display)
                                    (buffer-substring-no-properties pos next)))))
          (setq pos next)))
      out)))

(defun bbh-test--main-windows ()
  "Windows of the transcript and composer, leaving out the workflow side panel."
  (cl-remove-if (lambda (w) (window-parameter w 'window-side)) (window-list)))

(defun bbh-test--tool-folded-p (transcript)
  (with-current-buffer transcript
    (save-excursion
      (goto-char (point-min))
      (re-search-forward "^#\\+begin_result ")
      (forward-line 1)
      (invisible-p (point)))))

(ert-deftest bbh-composer-stays-below-output ()
  (save-window-excursion
    (delete-other-windows)
    (let* ((shell (bbh-test--start))
           (composer (eng/bbh-layout shell))
           (transcript (buffer-local-value 'eng/bbh-transcript shell))
           (input (get-buffer-window composer))
           (output (get-buffer-window transcript)))
      (should (< (nth 1 (window-edges output)) (nth 1 (window-edges input))))
      (should (eq (selected-window) input))
      (should-not (get-buffer-window shell))
      (insert "add forty\nand two")
      (call-interactively (key-binding (kbd "C-n")))
      (insert "draft while output arrives")
      (should (bbh-test--wait (lambda () (bbh-test--idle-p shell)) 60))
      (should (equal (bbh-test--text transcript)
                     "* add forty\n#+begin_quote\nadd forty\nand two\n#+end_quote\n\n#+begin_src clojure\n(+ 40 2)\n#+end_src\n#+begin_result done 1\n=> 42\n#+end_result\n\nThe answer is 42.\n"))
      (with-current-buffer transcript
        (should (derived-mode-p 'org-mode))
        (should buffer-read-only)
        (font-lock-ensure)
        (dolist (text '("(+ 40 2)\n#+end_src" "=> 42"))
          (goto-char (point-min))
          (search-forward text)
          (should (memq 'org-block (ensure-list (get-text-property (match-beginning 0) 'face))))))
      (should (equal (bbh-test--screen transcript)
                     "* add forty\nadd forty\nand two\n\n(+ 40 2)\n✓ output (1 line)\n\nThe answer is 42.\n"))
      (should (bbh-test--tool-folded-p transcript))
      (call-interactively (key-binding (kbd "C-c C-t")))
      (should-not (bbh-test--tool-folded-p transcript))
      (should (equal (bbh-test--screen transcript)
                     "* add forty\nadd forty\nand two\n\n(+ 40 2)\n✓ output (1 line)\n=> 42\n\nThe answer is 42.\n"))
      (with-current-buffer transcript
        (call-interactively (key-binding (kbd "C-c C-t"))))
      (should (bbh-test--tool-folded-p transcript))
      (with-current-buffer transcript
        (goto-char (point-min))
        (re-search-forward "^#\\+begin_result")
        (org-cycle)
        (should-not (bbh-test--tool-folded-p transcript))
        (org-cycle)
        (should (bbh-test--tool-folded-p transcript)))
      (should (equal (string-trim (bbh-test--text composer)) "draft while output arrives"))
      (should (eq (selected-window) input))
      (with-selected-window output
        (goto-char (point-min))
        (set-window-start output (point-min)))
      (should (eq (selected-window) input))
      (should (equal (string-trim (bbh-test--text composer)) "draft while output arrives"))
      (call-interactively (key-binding (kbd "C-c C-p")))
      (agent-shell-viewport-reply)
      (should (eq (key-binding (kbd "C-n")) #'eng/bbh-send))
      (should (string-match-p "C-n" (format "%s" header-line-format)))
      (should (equal (string-trim (bbh-test--text composer)) "draft while output arrives"))
      (eng/bbh-layout shell)
      (should (= (length (bbh-test--main-windows)) 2))
      (delete-window output)
      (eng/bbh-layout shell)
      (should (= (length (bbh-test--main-windows)) 2))
      (should (eq (selected-window) input))
      (should (< (nth 1 (window-edges (get-buffer-window transcript)))
                 (nth 1 (window-edges input))))
      (erase-buffer)
      (insert "sleep")
      (eng/bbh-send)
      (should (bbh-test--wait (lambda () (string-match-p "Thread/sleep" (bbh-test--text transcript))) 30))
      (insert "draft survives cancellation")
      (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                ((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
        (condition-case err
            (call-interactively (key-binding (kbd "C-c C-k")))
          (user-error (should (equal (cadr err) "Aborted")))))
      (should (bbh-test--wait (lambda () (bbh-test--idle-p shell)) 15))
      (should (equal (string-trim (bbh-test--text composer)) "draft survives cancellation"))
      (should (eq (window-buffer input) composer)))))

(ert-deftest bbh-new-replaces-the-session-and-clears-the-transcript ()
  (save-window-excursion
    (delete-other-windows)
    (let* ((old (bbh-test--start))
           (composer (eng/bbh-layout old))
           (transcript (buffer-local-value 'eng/bbh-transcript old))
           (output (get-buffer-window transcript))
           (input (selected-window)))
      (insert "add forty")
      (eng/bbh-send)
      (should (bbh-test--wait (lambda () (bbh-test--idle-p old)) 60))
      (should (string-match-p "The answer is 42" (bbh-test--text transcript)))
      (insert "/new")
      (call-interactively (key-binding (kbd "C-n")))
      (should-not (buffer-live-p old))
      (should-not (buffer-live-p composer))
      (should (equal (bbh-test--text transcript) ""))
      (should (eq (window-buffer output) transcript))
      (should (= (length (bbh-test--main-windows)) 2))
      (should (eq (selected-window) input))
      (let ((shell (eng/bbh--shell)))
        (should (eq (buffer-local-value 'eng/bbh-transcript shell) transcript))
        (should (bbh-test--wait (lambda () (with-current-buffer shell
                                             (and (map-nested-elt agent-shell--state '(:session :id))
                                                  (string-match-p "Ready" (buffer-string)))))
                                30))
        (insert "add forty again")
        (eng/bbh-send)
        (should (bbh-test--wait (lambda () (bbh-test--idle-p shell)) 60))
        (should (string-prefix-p "* add forty again\n\n#+begin_src clojure\n(+ 40 2)\n#+end_src\n#+begin_result done 1" (bbh-test--text transcript)))
        (should-not (string-match-p "^\\* add forty$" (bbh-test--text transcript)))))))

(ert-deftest bbh-resume-clears-the-transcript-unless-the-id-is-unknown ()
  (save-window-excursion
    (delete-other-windows)
    (let* ((old (bbh-test--start))
           (old-id (with-current-buffer old (map-nested-elt agent-shell--state '(:session :id))))
           (_ (eng/bbh-layout old))
           (transcript (buffer-local-value 'eng/bbh-transcript old)))
      (insert "add forty")
      (eng/bbh-send)
      (should (bbh-test--wait (lambda () (bbh-test--idle-p old)) 60))
      (insert "/new")
      (eng/bbh-send)
      (let ((shell (eng/bbh--shell)))
        (should (bbh-test--wait (lambda () (with-current-buffer shell
                                             (and (map-nested-elt agent-shell--state '(:session :id))
                                                  (string-match-p "Ready" (buffer-string)))))
                                30))
        (insert "/port")
        (eng/bbh-send)
        (should (bbh-test--wait (lambda () (bbh-test--idle-p shell)) 30))
        (insert "/nope")
        (eng/bbh-send)
        (should (bbh-test--wait (lambda () (string-match-p "^Error: Unknown command /nope\\. /help lists commands\\.$" (bbh-test--text transcript))) 30))
        (with-current-buffer transcript
          (goto-char (point-min))
          (search-forward "Error: Unknown")
          (should (eq 'error (get-text-property (match-beginning 0) 'font-lock-face))))
        (should (bbh-test--wait (lambda () (bbh-test--idle-p shell)) 30))
        (insert "/resume nope")
        (eng/bbh-send)
        (should (bbh-test--wait (lambda () (string-match-p "No such conversation" (bbh-test--text transcript))) 30))
        (should (string-prefix-p "* /port" (bbh-test--text transcript)))
        (should (bbh-test--wait (lambda () (bbh-test--idle-p shell)) 30))
        (insert (concat "/resume " old-id))
        (eng/bbh-send)
        (should (bbh-test--wait (lambda () (string-match-p "Last reply: The answer is 42" (bbh-test--text transcript))) 30))
        (should (string-prefix-p (concat "* /resume " old-id) (bbh-test--text transcript)))
        (should (string-match-p (concat "Resumed " old-id " with 4 messages") (bbh-test--text transcript)))
        (should-not (string-match-p "No such conversation" (bbh-test--text transcript)))))))

(ert-deftest bbh-cider-connect-works-from-the-composer ()
  (save-window-excursion
    (let* ((shell (bbh-test--start))
           (composer (eng/bbh-layout shell))
           endpoint)
      (cl-letf (((symbol-function 'cider-connect-clj)
                 (lambda (params) (setq endpoint params))))
        (call-interactively #'eng/bbh-cider-connect))
      (should (equal (plist-get endpoint :host) "127.0.0.1"))
      (should (integerp (plist-get endpoint :port)))
      (let ((socket (open-network-stream "bbh-port-test" nil
                                         (plist-get endpoint :host)
                                         (plist-get endpoint :port))))
        (should (process-live-p socket))
        (delete-process socket))
      (should (eq (current-buffer) composer)))))

(ert-deftest bbh-acp-renders-a-tool-call-and-reply ()
  (let ((buf (bbh-test--start)))
    (bbh-test--submit buf "add forty and two")
    (should (bbh-test--wait (lambda () (bbh-test--idle-p buf)) 60))
    (let ((text (bbh-test--text buf)))
      (should (string-match-p "(\\+ 40 2)" text))
      (should (string-match-p "=> 42" text))
      (should (string-match-p "The answer is 42\\." text)))
    (bbh-test--submit buf "/port")
    (should (bbh-test--wait (lambda () (bbh-test--idle-p buf)) 30))
    (should (string-match-p "nREPL 127\\.0\\.0\\.1:[0-9]+" (bbh-test--text buf)))
    (bbh-test--submit buf "sleep")
    (should (bbh-test--wait (lambda () (string-match-p "(Thread/sleep 60000)" (bbh-test--text buf))) 30))
    (let ((start (float-time)))
      (with-current-buffer buf (agent-shell-interrupt t))
      (should (bbh-test--wait (lambda () (bbh-test--idle-p buf)) 15))
      (should (< (- (float-time) start) 10)))
    (should (string-match-p "user interrupted the evaluation" (bbh-test--text buf)))))

