    (eng/bbh-transcript--prompt "one\ntwo")
    (eng/bbh-transcript--tool "a" '((:raw-input . ((code . "(+ 1 2)"))) (:status . "completed")
                                    (:content . (((content . ((text . "```clojure\n(+ 1 2)\n```\n```\n3\n```"))))))))
