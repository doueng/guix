#!/bin/sh
# Start bbh's ACP server in a Harbor task container. Harbor's ACP runner sets
# HARBOR_ACP_REQUESTED_MODEL from `harbor run -m`; bbh starts on that model so
# the runner's session/set_model finds it. BBH_HOME defaults to the install dir.
set -eu
home=${BBH_HOME:-/opt/bbh}
PATH="$home/bin:$PATH"
BBH_MODEL=${BBH_MODEL:-${HARBOR_ACP_REQUESTED_MODEL:-}}
BBH_INIT=${BBH_INIT:-$home/init.clj}
XDG_DATA_HOME=${XDG_DATA_HOME:-/logs/agent/bbh-data}
export PATH BBH_MODEL BBH_INIT XDG_DATA_HOME
mkdir -p "$XDG_DATA_HOME"
exec bb --config "$home/app/bb.edn" -m bbh.main acp "$@"
