{:rules
 [{:name "lint"
   :paths ["Makefile" "AGENTS.md" "channels.scm" "desktop/build/checks/**"
           "**/*.scm" "**/*.fish" "*.json" "**/*.json" "**/*.edn" "**/*.bb" "desktop/bin/*"
           "**/*.clj" "**/*.cljs" "**/*.cljc" "**/*.el" "**/*.fnl" "**/*.kbd"]
   :checks ["make lint"]}
  {:name "guix system"
   :paths ["modules/**" "desktop/system.scm" "desktop/system-facts.scm" "channels.scm"]
   :checks ["make lint"]
   :slow ["make build"]}
  {:name "guix home"
   :paths ["modules/engstrand/features/**" "desktop/home.scm"]
   :slow ["make build NAME=home"]}
  {:name "home shepherd check"
   :paths ["desktop/build/home/**"]
   :checks ["make lint" "bb desktop/build/home/check-shepherd.bb /run/current-system"]
   :slow ["make build NAME=home"]}
  {:name "remote builder"
   :paths ["modules/engstrand/system/builder.scm" "modules/engstrand/system/builder-keys.scm" "modules/engstrand/builder/**"
           "desktop/builder.scm" "desktop/bin/builder-prebuild" "desktop/build/builder/**"
           "modules/engstrand/features/builder-alert.scm" "modules/engstrand/system/reader.scm"
           "desktop/bin/reader-push"]
   :checks ["make lint" "bb desktop/build/builder/test.bb"]
   :slow ["make builder"]}
  {:name "stale"
   :paths ["desktop/bin/stale" "desktop/lib/stale.clj" "desktop/lib/stale/**" "desktop/build/stale/**"]
   :checks ["make lint" "bb desktop/build/stale/test.bb"]}
  {:name "updates"
   :paths ["desktop/bin/updates" "desktop/build/updates/**"]
   :checks ["make lint" "bb desktop/build/updates/test.bb"]}
  {:name "ext-reload"
   :paths ["desktop/bin/ext-reload" "desktop/build/chrome/ext-reload/**" "modules/engstrand/features/chrome-extensions.scm"]
   :checks ["make lint" "node desktop/build/chrome/ext-reload/test.mjs"]}
  {:name "chrome extensions"
   :paths ["desktop/build/chrome/vimium-cljs/**" "desktop/build/chrome/cookie-autoaccept/**"]
   :checks ["make lint"]
   :slow ["for d in desktop/build/chrome/*/bb.edn; do (cd \"$(dirname \"$d\")\" && bb e2e) || exit 1; done"]}
  {:name "rexmux"
   :paths ["desktop/build/rexmux/**" "modules/engstrand/packages/rex.scm" "modules/engstrand/packages/quint.scm" "desktop/build/quint/src/**"
           "desktop/bin/{mux-terminal,rexmux}" "desktop/lib/mux.clj"]
   :checks ["make lint" "cd desktop/build/rexmux && bb test" "cd desktop/build/rexmux && bb verify:quint"]
   :slow ["cd desktop/build/rexmux && bb verify:quint-mc" "cd desktop/build/rexmux && bb verify"]}
  {:name "ghostty-rex"
   :paths ["desktop/build/ghostty-rex/**" "desktop/bin/ghostty-rex" "desktop/configs/ghostty-rex/**"
           "modules/engstrand/packages/ghostty.scm" "modules/engstrand/features/terminal-mux.scm"
           "desktop/bin/{mux-terminal,workspace-or-herdr-tab}" "desktop/lib/mux.clj"
           "desktop/build/rexmux/sidecar/**"]
   :checks ["make lint" "cd desktop/build/ghostty-rex && bb test" "cd desktop/build/rexmux && bb test"
            "cd desktop/build/ghostty-rex && bb verify:quint"]
   :slow ["cd desktop/build/ghostty-rex && bb verify" "cd desktop/build/ghostty-rex && bb verify:quint-mc"
          "cd desktop/build/rexmux && bb verify:quint-mc"]}
  {:name "view"
   :paths ["desktop/bin/view" "desktop/build/view/**" "modules/engstrand/features/view.scm"]
   :checks ["make lint" "bb desktop/build/view/test.bb"]}
  {:name "second brain"
   :paths ["modules/engstrand/system/second-brain.scm" "modules/engstrand/packages/second-brain.scm"
           "modules/engstrand/features/second-brain.scm" "desktop/bin/second-brain-push"
           "desktop/build/second-brain/**"]
   :checks ["make lint" "bb desktop/build/second-brain/test.bb"]
   :slow ["desktop/bin/second-brain-push status"]}
  {:name "asahi kernel and boot chain"
   :paths ["modules/engstrand/asahi/**" "modules/engstrand/build/**"
           "modules/engstrand/system/bootloader.scm" "desktop/build/asahi/**"]
   :checks ["make lint"]
   :slow ["bb desktop/build/asahi/check-kernel.bb"]}
  {:name "apple neural engine"
   :paths ["modules/engstrand/packages/omarchy-ane.scm" "modules/engstrand/system/bootloader.scm"
           "modules/engstrand/system/asahi.scm" "desktop/build/ane/**"]
   :slow ["bb desktop/build/ane/check-packages.bb" "bb desktop/build/ane/check-system.bb"]}
  {:name "hex dictation"
   :paths ["modules/engstrand/packages/hex.scm" "desktop/build/hex/**"]
   :slow ["bb desktop/build/hex/check-transcribe.bb"]}
  {:name "doom"
   :paths ["desktop/configs/doom/**" "desktop/build/doom/**"]
   :checks ["bb desktop/build/doom/doctor.bb"]}
  {:name "doom cursor"
   :paths ["desktop/configs/doom/cursor.el" "desktop/build/doom/cursor-test.el"]
   :checks ["emacs --batch -l desktop/build/doom/cursor-test.el"]
   :slow ["cd desktop/build/ghostty-rex && bb bombadil:cursor --time 120"]}
  {:name "doom env"
   :paths ["desktop/configs/doom/{cli,session-env}.el" "desktop/build/doom/session-env-test.el"]
   :checks ["emacs --batch -l desktop/build/doom/session-env-test.el"]}
  {:name "keybindings"
   :paths ["desktop/kanata.kbd" "desktop/build/keybindings/**" "desktop/lib/**"
           "desktop/configs/{keybindings,hypr,doom,nvim,kanata,ideavim,vimium,ghostty,herdr}/**"
           "desktop/bin/{keyleader,keyguide,keylog,palette,winhint,hyprkan}" "desktop/build/checks/common.clj"]
   :checks ["bb desktop/build/keybindings/check.bb"]
   :slow ["bb desktop/build/keybindings/hypr-nested.bb"]}
  {:name "chrome launcher rows"
   :paths ["desktop/configs/keybindings/palette.edn" "desktop/bin/{palette,ext-reload}"
           "desktop/build/chrome/ext-reload/**" "desktop/build/keybindings/chrome-palette-e2e.mjs"]
   :slow ["node desktop/build/keybindings/chrome-palette-e2e.mjs"]}
  {:name "chrome launch"
   :paths ["desktop/bin/{chrome-unified,palette,keyleader}" "desktop/configs/keybindings/leader.edn"
           "desktop/build/keybindings/chrome-launch-e2e.bb"]
   :slow ["bb desktop/build/keybindings/chrome-launch-e2e.bb"]}
  {:name "chrome fullscreen"
   :paths ["desktop/configs/hypr/**" "desktop/build/hypr/**"]
   :slow ["bb desktop/build/hypr/chrome-fullscreen-check.bb"]}
  {:name "test display"
   :paths ["desktop/bin/test-display" "modules/engstrand/features/agent-control.scm"]
   :checks ["make lint"]
   :slow ["desktop/bin/test-display check"]}
  {:name "clipboard"
   :paths ["desktop/configs/doom/clipboard.el" "desktop/configs/nvim/fnl/config/options.fnl"
           "desktop/build/clipboard/**"]
   :slow ["bb desktop/build/clipboard/check.bb"]}
  {:name "clipboard e2e"
   :paths ["desktop/kanata.kbd" "desktop/configs/ghostty/config" "desktop/configs/ghostty-rex/ghostty"
           "desktop/configs/nvim/fnl/config/keymaps.fnl" "desktop/configs/doom/clipboard.el"
           "desktop/build/clipboard/e2e.bb"]
   :slow ["desktop/bin/test-display --name clipboard-e2e -- bb desktop/build/clipboard/e2e.bb"]}
  {:name "clipboard history"
   :paths ["desktop/bin/clipboard-history" "desktop/lib/session.clj" "desktop/build/clipboard/history-test.bb"]
   :checks ["make lint" "bb desktop/build/clipboard/history-test.bb"]}
  {:name "taildrop"
   :paths ["desktop/bin/taildrop" "desktop/lib/session.clj" "desktop/build/taildrop/**"
           "modules/engstrand/features/tailscale.scm"]
   :checks ["make lint" "bb desktop/build/taildrop/test.bb"]}
  {:name "herdr sesh picker"
   :paths ["desktop/build/herdr/sesh/**"]
   :checks ["cd desktop/build/herdr/sesh && bb tests.bb"]}
  {:name "herdr tiny-fingers"
   :paths ["desktop/build/herdr/tiny-fingers/**"]
   :checks ["cd desktop/build/herdr/tiny-fingers && bb tests.bb"]}
  {:name "herdr jjui popup"
   :paths ["desktop/build/herdr/jjui/**"]
   :checks ["cd desktop/build/herdr/jjui && bb tests.bb"]
   :slow ["guix build -L modules -e '(@ (engstrand packages herdr) herdr-jjui)'"]}
  {:name "bbh"
   :paths ["desktop/build/bbh/**" "desktop/configs/bbh/**" "desktop/bin/{bbh,wf,emacs-bbh,emacs-throwaway}"
           "modules/engstrand/features/bbh-web.scm"]
   :checks ["cd desktop/build/bbh && bb test"]
   :slow ["cd desktop/build/bbh && bb test:props"]}
  {:name "bbh state machines"
   :paths ["desktop/build/bbh/src/bbh/super/model.clj" "desktop/build/bbh/src/bbh/workflow.clj"
            "desktop/build/bbh/src/bbh/workflows/change.edn" "desktop/build/bbh/verify/**"
            ".agents/skills/verify-bbh-state-machines/**" "desktop/build/quint/src/**"]
   :checks ["cd desktop/build/bbh && bb verify:quint"]}
  {:name "quint"
   :paths ["desktop/build/quint/**" "modules/engstrand/packages/{quint,quint-language-server}.scm"]
   :checks ["cd desktop/build/quint && bb test"]
   :slow ["bb desktop/build/quint/lsp/test.bb"]}
  {:name "quint-mode"
   :paths ["desktop/configs/doom/quint.el" "desktop/build/doom/quint-mode-test.el" "desktop/build/**/*.qnt"]
   :checks ["emacs --batch -l desktop/build/doom/quint-mode-test.el"]}
  {:name "bbh voice shortcut"
   :paths ["desktop/build/bbh/src/bbh/super/voice.clj"]
   :checks ["bb desktop/build/keybindings/kanata-check.bb"]}
  {:name "bbh-transcript-scroll"
   :paths ["desktop/configs/doom/{agent-shell,bbh-super}.el" "desktop/build/bbh/test/tty-scroll-test.el"
           "desktop/build/bbh/test/tty-visit-test.el"
           "desktop/build/bbh/bb.edn"]
   :checks ["cd desktop/build/bbh && bb test:transcript-scroll"]}
  {:name "bbh bombadil"
   :paths ["desktop/configs/doom/{agent-shell,bbh-super}.el" "desktop/build/bbh/test/bombadil/**"
           "desktop/build/bbh/test/bbh/bombadil.clj" "modules/engstrand/packages/bombadil.scm"]
   :slow ["cd desktop/build/bbh && bb test:bombadil --view inbox --time 120 && bb test:bombadil --view worker --time 120"]}
  {:name "bbh inbox"
   :paths ["desktop/build/bbh/src/bbh/{inbox,main,models,repl,session,transcript}.clj"
           "desktop/build/bbh/test/bbh/inbox_*.clj" "desktop/build/bbh/test/agent-shell-test.el"
           "desktop/build/bbh/bb.edn" "desktop/configs/bbh/init.clj" "desktop/configs/doom/{agent-shell,bbh-super}.el"]
   :checks ["cd desktop/build/bbh && bb test:emacs"]}
  {:name "pi-sci"
   :paths ["desktop/build/pi-sci/**" "desktop/pi/agent/extensions/**"]
   :checks ["make build NAME=pi-sci && desktop/build/pi-sci/verify.bb"]}
  {:name "skill-diet"
   :paths ["desktop/pi/agent/skills/skill-diet/**" "desktop/build/skill-diet/**"]
   :checks ["node desktop/pi/agent/skills/skill-diet/scripts/eval.mjs check desktop/pi/agent/skills/skill-diet && bb desktop/build/skill-diet/adapter-test.bb"]}
  {:name "rexctl"
   :paths ["desktop/bin/rexctl" "desktop/lib/rexctl.clj" "desktop/build/rexctl/**" "desktop/pi/agent/skills/rexmux/**"]
   :checks ["make lint" "bb desktop/build/rexctl/test.bb" "bb desktop/build/rexctl/test.bb --live"
            "node desktop/pi/agent/skills/skill-diet/scripts/eval.mjs check desktop/pi/agent/skills/rexmux"]}
  {:name "pbt"
   :paths ["desktop/build/pbt/**" "desktop/pi/agent/skills/agentic-pbt/**"
           "desktop/build/bbh/test/bbh/gens/**" "desktop/build/bbh/test/bbh/workers_mbt_test.clj" "desktop/build/bbh/test/bbh/pause_mbt_test.clj"
           "desktop/build/bbh/test/bbh/outbox_plan_property_test.clj" "desktop/build/bbh/src/bbh/super/model.clj"
           "desktop/build/bbh/verify/quint/super.qnt"
           "desktop/build/ghostty-rex/test/rexg/gens/**" "desktop/build/ghostty-rex/test/rexg/connect_mbt_test.clj"
           "desktop/build/ghostty-rex/test/rexg/connection_test.clj" "desktop/build/ghostty-rex/src/rexg/model.clj"
           "desktop/build/ghostty-rex/test/rexg/stream_test.clj" "desktop/build/ghostty-rex/test/rexg/resize_mbt_test.clj"
           "desktop/build/ghostty-rex/src/rexg/rex.clj" "desktop/build/ghostty-rex/verify/quint/resize.qnt"
           "desktop/build/ghostty-rex/test/rexg/replies_test.clj" "desktop/build/ghostty-rex/src/rexg/replies.clj"
           "desktop/build/rexmux/verify/quint/rexmux.qnt"]
   :checks ["make lint" "cd desktop/build/pbt && bb test"
            "node desktop/pi/agent/skills/skill-diet/scripts/eval.mjs check desktop/pi/agent/skills/agentic-pbt"]
   :slow ["cd desktop/build/pbt && bb mbt rexg-connect-mbt --traces 200" "cd desktop/build/pbt && bb mbt bbh-workers-mbt --traces 200"
          "cd desktop/build/pbt && bb mbt bbh-pause-mbt --traces 200"
          "cd desktop/build/pbt && bb mbt rexg-resize-mbt --traces 200"]}
  {:name "explain"
   :paths ["desktop/pi/agent/skills/explain/**"]
   :checks ["node desktop/pi/agent/skills/skill-diet/scripts/eval.mjs check desktop/pi/agent/skills/explain"]}
  {:name "dusk"
   :paths ["desktop/build/dusk/**" "desktop/configs/dusk/**" "desktop/bin/dusk" "desktop/lib/dusk/**"]
   :checks ["desktop/build/dusk/test.bb"]
   :slow ["bb desktop/build/dusk/verify.bb"]}
  {:name "pierre-diff-ansi"
   :paths ["desktop/build/pierre-diff-ansi/**" "desktop/bin/{pierre-diff-ansi,jj-diff-pierre}"
           "desktop/build/bbh/src/bbh/web/highlights.js"]
   :checks ["make build NAME=pierre-diff-ansi && bb desktop/build/pierre-diff-ansi/test.bb"]}]}
