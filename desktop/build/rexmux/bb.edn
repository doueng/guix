{:paths ["sidecar" "test" "verify"]
 :tasks {sidecar {:doc "Run the sidecar on stdin and stdout (the window starts it)."
                  :requires ([rexmux.sidecar])
                  :task (rexmux.sidecar/-main)}
         test {:doc "Unit and property tests of the sidecar: protocol, schema, registry, agents (fast; make lint runs it)."
               :requires ([rexmux.test-runner])
               :task (rexmux.test-runner/-main)}
         test:live {:doc "Sidecar tests against a throwaway Rex server on a private socket."
                    :requires ([rexmux.live-test])
                    :task (rexmux.live-test/-main)}
         test:bombadil {:doc "Bombadil over rexmux tty on a throwaway Rex server: pane focus, M-x, keymaps, agent attention. Args: [--time S] [--reproduce TRACE-FILE] [--keep]."
                        :requires ([rexmux.bombadil])
                        :task (apply rexmux.bombadil/-main *command-line-args*)}
         test:e2e {:doc "The window end to end on the hidden test display and a throwaway Rex server: startup tabs, tiny fingers, mouse, rename, resize, persistence. Args: [--keep]."
                   :requires ([rexmux.e2e])
                   :task (apply rexmux.e2e/-main *command-line-args*)}
         verify {:doc "Every live check: the sidecar on a throwaway Rex server, then the window's (make rexmux-verify)."
                 :requires ([rexmux.verify])
                 :task (apply rexmux.verify/-main *command-line-args*)}
         verify:tla {:doc "Model-check verify/tla with TLC. Args: [CONFIG...]."
                     :requires ([rexmux.tla])
                     :task (apply rexmux.tla/-main *command-line-args*)}}}
