#!/usr/bin/env bb
;; Regenerate modules/engstrand/packages/quint-language-server.scm from
;; package-lock.json here: one origin per npm tarball, hashed with the sha512
;; npm records, laid out at its lock path under node_modules.
;;
;; To update: set the version in package.json, run
;;   npm install --package-lock-only --omit=dev --ignore-scripts
;; in this directory, then bb update.bb.
(require '[babashka.fs :as fs]
         '[cheshire.core :as json]
         '[clojure.string :as str])

(def here (fs/parent (fs/absolutize *file*)))
(def out (fs/path here ".." ".." ".." ".." "modules" "engstrand" "packages" "quint-language-server.scm"))

(def alphabet "0123456789abcdfghijklmnpqrsvwxyz")

(defn nix-base32
  "Guix's (Nix's) base32 of the bytes BS."
  [^bytes bs]
  (let [n (alength bs)
        len (long (Math/ceil (/ (* n 8) 5.0)))]
    (apply str (for [k (range (dec len) -1 -1)
                     :let [b (* k 5) i (quot b 8) j (mod b 8)
                           lo (bit-shift-right (bit-and (aget bs i) 0xff) j)
                           hi (if (< (inc i) n) (bit-shift-left (bit-and (aget bs (inc i)) 0xff) (- 8 j)) 0)]]
                 (.charAt alphabet (bit-and (bit-or lo hi) 0x1f))))))

(defn sha512-base32 [integrity]
  (let [[algo b64] (str/split integrity #"-" 2)]
    (assert (= "sha512" algo) integrity)
    (nix-base32 (.decode (java.util.Base64/getDecoder) ^String b64))))

(let [lock (json/parse-string (slurp (str (fs/path here "package-lock.json"))))
      version (get-in lock ["packages" "node_modules/@informalsystems/quint-language-server" "version"])
      entries (sort-by key (dissoc (get lock "packages") ""))]
  (spit (str out)
        (str ";; Generated by desktop/build/quint/lsp/update.bb from its package-lock.json.\n"
             ";; Do not edit; update the lock and run the script.\n"
             "(define-module (engstrand packages quint-language-server)\n"
             "  #:export (quint-language-server-version quint-language-server-modules))\n\n"
             "(define quint-language-server-version \"" version "\")\n\n"
             ";; (lock-path url sha512-nix-base32) of each npm package the server loads.\n"
             "(define quint-language-server-modules\n  '("
             (str/join "\n    " (for [[path {:strs [resolved integrity]}] entries]
                                    (str "(\"" path "\" \"" resolved "\" \"" (sha512-base32 integrity) "\")")))
             "))\n"))
  (println "wrote" (str (fs/normalize out)) (count entries) "modules, server" version))
