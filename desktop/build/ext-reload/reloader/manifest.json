{
  "manifest_version": 3,
  "name": "ext-reload",
  "version": "1.0.0",
  "description": "Reloads your unpacked extensions and their tabs when the ext-reload command asks. Talks only to ws://127.0.0.1:7357.",
  "minimum_chrome_version": "116",
  "key": "",
  "background": { "service_worker": "bg.js" },
  "permissions": ["management", "tabs", "alarms"]
}
