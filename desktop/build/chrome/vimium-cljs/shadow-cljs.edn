;; MV3 forbids eval and shadow-cljs dev builds use it, so the extension only runs release builds.
{:source-paths ["src" "test"]
 :dependencies [[org.clojure/test.check "1.1.1"]]
 :builds
 {:bg      {:target :browser
            :output-dir "ext/js"
            :modules {:bg {:init-fn vimium-cljs.bg.main/init}}
            :compiler-options {:warnings-as-errors true :infer-externs :auto}}
  :content {:target :browser
            :output-dir "ext/js"
            :modules {:content {:init-fn vimium-cljs.content.main/init}}
            :compiler-options {:warnings-as-errors true :infer-externs :auto}}
  :ui      {:target :browser
            :output-dir "ext/js"
            :modules {:ui {:init-fn vimium-cljs.ui.main/init}}
            :compiler-options {:warnings-as-errors true :infer-externs :auto}}
  :panel   {:target :browser
            :output-dir "ext/js"
            :modules {:panel {:init-fn vimium-cljs.panel.main/init}}
            :compiler-options {:warnings-as-errors true :infer-externs :auto}}
  :test    {:target :node-test
            :output-to "out/test.js"
            :ns-regexp "-test$"}}}
