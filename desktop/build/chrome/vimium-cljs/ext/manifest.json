{
  "manifest_version": 3,
  "name": "Vimium (cljs)",
  "version": "0.1.0",
  "description": "Vimium-style keyboard navigation, rewritten in ClojureScript.",
  "minimum_chrome_version": "116",
  "side_panel": { "default_path": "panel.html" },
  "icons": { "128": "icons/icon128.png" },
  "background": { "service_worker": "js/bg.js" },
  "permissions": ["tabs", "bookmarks", "history", "storage", "sessions", "webNavigation",
                  "offscreen", "clipboardRead", "clipboardWrite", "sidePanel", "favicon"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "commands": {
    "vomnibar": { "description": "Open the Vomnibar" },
    "vomnibar-tabs": { "description": "Search open tabs (desktop leader b b)",
                       "suggested_key": { "default": "Ctrl+Shift+K" } },
    "tab-panel": { "description": "Open the tab list in the side panel" }
  },
  "web_accessible_resources": [
    { "resources": ["ui.html", "ui.css", "js/ui.js"], "matches": ["<all_urls>"] }
  ]
}
