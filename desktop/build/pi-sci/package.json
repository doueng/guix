{
  "name": "pi-sci-codemode",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "./build.sh",
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit",
    "lint": "node scripts/biome.mjs check src/*.ts test/*.ts scripts/*.mjs",
    "format": "node scripts/biome.mjs format --write src/*.ts test/*.ts scripts/*.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "typebox": "1.3.27"
  }
}
