# Ghostty Configuration

config-file = ?config.asahi

font-family = JetBrainsMono Nerd Font
# Keep programming operators literal in terminal applications such as Neovim.
font-feature = -calt, -liga, -dlig
font-size = 13
font-thicken = true

theme = catppuccin-mocha

background-opacity = 0.9

cursor-style = underline
cursor-style-blink = false
mouse-hide-while-typing = true

command = fish
shell-integration = fish
shell-integration-features = no-cursor,no-sudo

clipboard-read = allow
clipboard-paste-protection = false
copy-on-select = false
clipboard-trim-trailing-spaces = true

window-decoration = none
resize-overlay = never
app-notifications = no-clipboard-copy
link-url = false

macos-non-native-fullscreen = true
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true
auto-update = off
quit-after-last-window-closed = false

gtk-titlebar = false
gtk-single-instance = desktop

# Key Bindings (custom)
keybind = shift+insert=paste_from_clipboard
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+a=select_all
# keybind = super+equal=increase_font_size:1
# keybind = super+plus=increase_font_size:1
# keybind = super+minus=decrease_font_size:1
# keybind = super+zero=reset_font_size
# keybind = super+n=new_window
keybind = super+t=text:\x1b\x0e
keybind = super+w=text:\x1b\x18
# keybind = super+shift+w=close_window
# keybind = super+shift+left_bracket=previous_tab
# keybind = super+shift+right_bracket=next_tab
keybind = shift+ctrl+alt+r=reload_config
# Cmd+<number> -> Herdr's native Ctrl+B,<number> tab sequence. Sending the
# prefix bytes is more reliable than trying to represent Ctrl+Alt+<letter>
# through a terminal protocol.
keybind = super+physical:one=text:\x02\x31
keybind = super+enter=text:\x1b\x11
keybind = super+physical:two=text:\x02\x32
keybind = super+e=text:\x1b\x17
keybind = super+physical:three=text:\x02\x33
keybind = super+physical:four=text:\x02\x34
keybind = super+physical:five=text:\x02\x35
keybind = super+physical:six=text:\x02\x36
keybind = super+physical:seven=text:\x02\x37
keybind = super+physical:eight=text:\x02\x38
keybind = super+physical:nine=text:\x02\x39
# Cmd+g -> Alt+Ctrl+g (for the Herdr jjui tab)
keybind = super+g=text:\x1b\x07
keybind = super+left=text:\x01
keybind = super+right=text:\x05
keybind = alt+left=esc:b
keybind = alt+right=esc:f
keybind = super+up=jump_to_prompt:-1
keybind = super+down=jump_to_prompt:1
keybind = super+shift+up=jump_to_prompt:-1
keybind = super+shift+down=jump_to_prompt:1
# keybind = super+page_up=scroll_page_up
# keybind = super+page_down=scroll_page_down
# keybind = super+home=scroll_to_top
# keybind = super+end=scroll_to_bottom
# keybind = shift+up=adjust_selection:up
# keybind = shift+down=adjust_selection:down
# keybind = shift+left=adjust_selection:left
# keybind = shift+right=adjust_selection:right
# keybind = shift+page_up=adjust_selection:page_up
# keybind = shift+page_down=adjust_selection:page_down
# keybind = shift+home=adjust_selection:home
# keybind = shift+end=adjust_selection:end
keybind = super+k=clear_screen
keybind = super+q=quit
# keybind = super+alt+shift+w=close_all_windows
# keybind = super+alt+i=inspector:toggle
keybind = super+p=toggle_quick_terminal
keybind = super+shift+j=write_scrollback_file:paste
keybind = super+alt+shift+j=write_scrollback_file:open
