#!/bin/sh
set -eu

agent_bin="$HOME/nixos/scripts/agent-bin"
self_dir="$(cd "$(dirname "$0")" && pwd -P)"

find_real_bash() {
  old_ifs="$IFS"
  IFS=:
  for dir in $PATH; do
    IFS="$old_ifs"
    [ -n "$dir" ] || dir=.
    dir_real="$(cd "$dir" 2>/dev/null && pwd -P || true)"
    [ "$dir_real" = "$self_dir" ] && continue
    if [ -x "$dir/bash" ]; then
      printf '%s\n' "$dir/bash"
      return 0
    fi
    IFS=:
  done
  IFS="$old_ifs"
  return 1
}

real_bash="${PI_AGENT_REAL_BASH:-$(find_real_bash || true)}"
if [ -z "$real_bash" ]; then
  echo "pi-agent bash wrapper: could not find real bash on PATH" >&2
  exit 127
fi

if [ -d "$agent_bin" ]; then
  prefix="export PATH='$agent_bin':\"\$PATH\"; "
else
  prefix=""
fi

if [ "$#" -ge 2 ] && [ "$1" = "-c" ]; then
  command="$2"
  shift 2
  exec "$real_bash" -c "$prefix$command" "$@"
fi

if [ "$#" -ge 2 ] && [ "$1" = "-lc" ]; then
  command="$2"
  shift 2
  exec "$real_bash" -lc "$prefix$command" "$@"
fi

if [ "$#" -ge 3 ] && [ "$1" = "-l" ] && [ "$2" = "-c" ]; then
  command="$3"
  shift 3
  exec "$real_bash" -l -c "$prefix$command" "$@"
fi

if [ -d "$agent_bin" ]; then
  PATH="$agent_bin:$PATH"
  export PATH
fi
exec "$real_bash" "$@"
