{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": ["src/extension.ts", "src/index.ts", "src/types.ts", "src/core/artifacts.ts", "src/core/builtin-rules.generated.ts", "src/core/classify.ts", "src/core/command.ts", "src/core/integrations/**/*.ts", "src/core/reduce.ts", "src/core/rules.ts", "src/core/text.ts", "src/core/validate-rules.ts", "src/pi-extension/**/*.ts", "test.ts"]
}
