#!/usr/bin/env bb
;; stub-pi: a deterministic stand-in for `pi --mode rpc` used by pi-org tests.
;;
;; It reads JSONL commands from stdin (one per line). For each command:
;;   - get_state  → emits a canned state response (model/thinking/session)
;;   - prompt     → replays the event sequence from $PI_ORG_STUB_FIXTURE
;;   - steer      → replays the fixture (same as prompt; steering mid-turn)
;;   - abort      → emits agent_end immediately
;;   - *          → emits a generic success response
;;
;; Each fixture line is a JSON object (an RPC event) emitted verbatim as a
;; JSONL record on stdout. Lines starting with `#` are comments. A line of
;; just `SLEEP <ms>` causes the stub to pause before emitting the next line,
;; which lets tests observe mid-stream UI state (e.g. the spinner).

(ns stub-pi
  (:require [clojure.string :as str]
            [cheshire.core :as json]
            [babashka.fs :as fs]))

(def fixture (System/getenv "PI_ORG_STUB_FIXTURE"))

(defn emit [s]
  (println s)
  (flush))

(defn json-field
  "Extract a string field from a JSON line. Returns nil if not found.
  Field name is a string; keys are keywordized by cheshire."
  [line field]
  (try
    (get (json/parse-string line true) (keyword field))
    (catch Exception _ nil)))

(defn sleep-ms [ms]
  (Thread/sleep (long ms)))

(defn replay-fixture
  "Read the fixture file and emit each non-comment line verbatim.
  Lines starting with # are comments. A line of 'SLEEP <ms>' pauses."
  []
  (when (and fixture (fs/exists? fixture))
    (doseq [fline  (fs/read-all-lines fixture)
            :let   [line (str/trim fline)]
            :when  (and (not (str/blank? line))
                        (not (str/starts-with? line "#")))]
      (if (str/starts-with? line "SLEEP ")
        (let [ms (-> line (str/replace "SLEEP " "") str/trim Long/parseLong)]
          (sleep-ms ms))
        (emit line)))))

(defn handle-command
  "Process a single JSONL command line from stdin."
  [line]
  (let [line (str/trim line)]
    (when-not (str/blank? line)
      (let [ctype (json-field line "type")
            cid   (or (json-field line "id") "")]
        (case ctype
          "get_state"
          (emit (json/generate-string
                  {:type "response" :id cid :success true
                   :data {:model {:provider "stub" :id "stub-model"}
                          :thinkingLevel "low"
                          :sessionName "stub-session"}}))
          ("prompt" "steer" "follow_up")
          (replay-fixture)
          "abort"
          (emit (json/generate-string {:type "agent_end"}))
          ;; default: generic success response
          (emit (json/generate-string
                  {:type "response" :id cid :success true :data {}})))))))

;; Read JSONL commands from stdin, one per line.
(with-open [reader (java.io.BufferedReader. *in*)]
  (doseq [line (line-seq reader)]
    (handle-command line)))
